# AI document classification (server-side only)
# Set to "gemini" or "openai". Leave blank to use the deterministic sorter.
DOCUMENT_AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-4.1-mini
DOCUMENT_AI_TIMEOUT_MS=45000

# Google Calendar OAuth (server-side only)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_OAUTH_STATE_SECRET=

# Gmail project tracking (uses the same Google OAuth client and encrypted token)
GMAIL_INITIAL_SYNC_DAYS=30
GMAIL_SYNC_MESSAGE_LIMIT=120
GMAIL_AUTO_APPLY_THRESHOLD=0.97
GMAIL_SCHEDULED_SYNC_ENABLED=true
CRON_SECRET=

# Xero OAuth 2.0 read-only finance integration (server-side only)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

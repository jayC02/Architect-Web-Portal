DATABASE_URL=
DIRECT_URL=
PUBLIC_SITE_URL=
PUBLIC_ALLOWED_ORIGINS=

# Application authentication (server-side only)
APP_BASE_URL=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=
AUTH_OAUTH_STATE_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM="ArchitectPro <no-reply@example.com>"

UPLOAD_STORAGE_PROVIDER=local
UPLOAD_STORAGE_DIR=public/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

DEBUG_PERF=

# Access gating and billing (see docs/access-control-and-licensing.md)
# paid_or_invite (default): self-serve signups must pay first; demo invites get a 14-day trial.
# invite_only: registration only through an approved demo invite.
SIGNUP_MODE=paid_or_invite
# Comma-separated emails that can approve demo requests at /admin/access.
PLATFORM_ADMIN_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flat subscription prices (Pay as you go has none; Firm is quoted, optional).
STRIPE_PRICE_PRACTICE_MONTHLY=
STRIPE_PRICE_PRACTICE_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_FIRM_MONTHLY=
STRIPE_PRICE_FIRM_ANNUAL=
# Metered per-application prices on the Stripe meter below (£29, £8, £6). Only
# applications beyond the monthly allowance are reported.
STRIPE_PRICE_PAYG_USAGE=
STRIPE_PRICE_PRACTICE_USAGE=
STRIPE_PRICE_STUDIO_USAGE=
STRIPE_METER_EVENT_NAME=application_submitted
# Ed25519 key for signing Agent licences: node scripts/generate-licence-keys.mjs
LICENCE_SIGNING_PRIVATE_KEY=
LICENCE_KEY_ID=v1

# Desktop Agent release metadata (optional overrides for src/config/agent-release.json)
# Installers are served from this private Supabase bucket via short-lived signed URLs.
AGENT_RELEASE_BUCKET=agent-releases
AGENT_RELEASE_STORAGE_KEY=
AGENT_RELEASE_SOURCE_STORAGE_KEY=
# Local dev only, when Supabase is not configured: absolute path to this repo's agent-releases/ folder.
AGENT_RELEASE_LOCAL_DIR=
AGENT_RELEASE_VERSION=
AGENT_RELEASE_SHA256=
AGENT_RELEASE_SIZE_BYTES=
AGENT_RELEASE_STATUS=
AGENT_RELEASE_SIGNED=
AGENT_MINIMUM_SUPPORTED_VERSION=

# AI document classification (server-side only)
# Set to "anthropic", "gemini" or "openai". Leave blank to use the deterministic sorter.
DOCUMENT_AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_DOCUMENT_MODEL=claude-haiku-5-5
# low, medium (default) or high. Lower is faster and cheaper.
ANTHROPIC_DOCUMENT_EFFORT=medium
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-4.1-mini
DOCUMENT_AI_TIMEOUT_MS=45000

# Google Calendar OAuth (server-side only)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_OAUTH_STATE_SECRET=

# Gmail project tracking (uses the same Google OAuth client and encrypted token)
GMAIL_INITIAL_SYNC_DAYS=30
GMAIL_SYNC_MESSAGE_LIMIT=120
GMAIL_AUTO_APPLY_THRESHOLD=0.97
GMAIL_SCHEDULED_SYNC_ENABLED=true
CRON_SECRET=

# Xero OAuth 2.0 read-only finance integration (server-side only)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_TOKEN_ENCRYPTION_KEY=

# Optional exact UK street-address lookup (server-side only).
# Postcode-to-local-authority lookup uses Postcodes.io without an API key.
IDEAL_POSTCODES_API_KEY=

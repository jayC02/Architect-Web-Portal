---
import { SUSTAINABILITY_LEVELS, SUSTAINABILITY_LEVEL_LABELS, SUSTAINABILITY_ROWS, type WarrantSustainability } from '@/lib/building-warrant-follow-ups';
interface Props {
  part: 'fire' | 'historical' | 'relaxation' | 'dangerous' | 'sustainability';
  fireAuthorityName?: string | null;
  fireEnforcingAuthority: boolean;
  newBuilding: boolean;
  sustainability?: WarrantSustainability;
  historical: boolean;
  historicalDetails?: string;
  dangerous: boolean;
  dangerousReferences?: string;
  relaxation: boolean;
  relaxationDirections?: Array<{ reference: string; date: string }>;
  relaxationReference?: string;
  relaxationDate?: string;
}
const { part, fireAuthorityName, fireEnforcingAuthority, newBuilding, sustainability: answers = {} } = Astro.props;
const directions = Astro.props.relaxationDirections?.length ? Astro.props.relaxationDirections : [{ reference: Astro.props.relaxationReference ?? '', date: Astro.props.relaxationDate ?? '' }];
const yesNo = [
  ['higherLevelsSustainability', 'Are the proposals designed to achieve optional higher levels of sustainability?', answers.higherLevels],
  ['sustainabilityMultipleBuildings', 'Does the assessment cover multiple buildings?', answers.multipleBuildings],
  ['sustainabilityDomesticUse', 'Are any buildings for domestic use?', answers.domesticUse],
  ['sustainabilityNonDomesticUse', 'Are any buildings for non-domestic use?', answers.nonDomesticUse],
] as const;
---
{part === 'fire' && <div class="prep-followup" data-fire-authority-name hidden={fireEnforcingAuthority}>
  <label class="block"><span class="prep-field-question">Fire-authority name</span><input name="fireAuthorityName" maxlength="20" value={fireAuthorityName ?? ''} required={!fireEnforcingAuthority} class="field" /></label>
  <p class="mt-1 text-sm text-stone-500">Required when Fire and Rescue Service is not the enforcing authority. Maximum 20 characters.</p>
</div>}
{part === 'historical' && <div class="prep-followup" data-historical-details hidden={!Astro.props.historical}>
  <label class="block"><span class="prep-field-question">Historical-importance details</span><textarea name="historicalBuildingDetails" maxlength="750" rows="4" required={Astro.props.historical} class="field">{Astro.props.historicalDetails ?? ''}</textarea></label>
</div>}
{part === 'relaxation' && <div class="prep-followup" data-relaxation-details hidden={!Astro.props.relaxation}>
  <div data-relaxation-rows>{directions.map(row => <div class="mb-3 grid gap-x-4 gap-y-2 sm:grid-cols-[minmax(0,1fr)_11rem]" data-relaxation-row><label class="block"><span class="prep-field-question">Relaxation-direction reference</span><input name="relaxationReferences" maxlength="750" value={row.reference} required={Astro.props.relaxation} class="field" /></label><label class="block"><span class="prep-field-question">Relaxation-direction date</span><input name="relaxationDates" type="date" value={row.date} required={Astro.props.relaxation} class="field" /></label><button type="button" data-remove-relaxation class="justify-self-start text-left text-sm text-stone-600 underline hover:text-ink">Remove this direction</button></div>)}</div>
  <button type="button" data-add-relaxation class="text-sm font-semibold underline">Add another relaxation direction</button>
</div>}
{part === 'dangerous' && <div class="prep-followup" data-dangerous-references hidden={!Astro.props.dangerous}>
  <label class="block"><span class="prep-field-question">Dangerous-building notice reference numbers</span><textarea name="dangerousBuildingReferences" maxlength="750" rows="4" required={Astro.props.dangerous} class="field">{Astro.props.dangerousReferences ?? ''}</textarea></label>
</div>}
{part === 'sustainability' && <fieldset class="mt-4 min-w-0" data-sustainability data-new-building={newBuilding ? 'true' : 'false'} hidden={!newBuilding}>
  <legend class="sr-only">New-building sustainability</legend>
  <div class="divide-y divide-stone-200 border-y border-stone-200">
    {yesNo.map(([name, label, value], index) => (
      <div class="py-3" data-sustainability-question={index} hidden={!newBuilding || (index > 0 && answers.higherLevels !== true)}>
        <label class="prep-select-row"><span class="prep-question-text">{label}</span><select name={name} class="field" required={newBuilding && (index === 0 || answers.higherLevels === true)}>
          <option value="">Choose Yes or No</option><option value="true" selected={value === true}>Yes</option><option value="false" selected={value === false}>No</option>
        </select></label>
      </div>
    ))}
    <div class="py-3" data-sustainability-count hidden={!newBuilding || answers.higherLevels !== true || answers.multipleBuildings !== true}>
      <label class="prep-select-row"><span class="prep-question-text">Total number of buildings designed for higher sustainability levels</span><input type="number" name="sustainabilityBuildingCount" min="2" max="2147483647" step="1" value={answers.buildingCount ?? ''} required={newBuilding && answers.higherLevels === true && answers.multipleBuildings === true} class="field" /></label>
    </div>
  </div>
  {(['domestic', 'nonDomestic'] as const).map((use) => (
    <fieldset class="mt-5 min-w-0" data-sustainability-levels={use} hidden={!newBuilding || answers.higherLevels !== true || !(use === 'domestic' ? answers.domesticUse : answers.nonDomesticUse)}>
      <legend class="text-base font-semibold text-ink">{use === 'domestic' ? 'Domestic' : 'Non-domestic'} sustainability levels</legend>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        {SUSTAINABILITY_ROWS[use].map((label, row) => (
          <label class="flex flex-col justify-end"><span class="prep-field-question">{label}</span><select class="field" name={`sustainability${use === 'domestic' ? 'Domestic' : 'NonDomestic'}Levels`} required={newBuilding && answers.higherLevels === true && (use === 'domestic' ? answers.domesticUse === true : answers.nonDomesticUse === true)}>
            <option value="">Choose a level</option>
            {SUSTAINABILITY_LEVELS.map((level, index) => (row === 0 || level === 'silver' || level === 'gold') && <option value={level} selected={(use === 'domestic' ? answers.domesticLevels : answers.nonDomesticLevels)?.[row] === level}>{SUSTAINABILITY_LEVEL_LABELS[index]}</option>)}
          </select></label>
        ))}
      </div>
    </fieldset>
  ))}
</fieldset>}
<script>
  const form = document.querySelector<HTMLFormElement>('form[data-api-form]');
  if (form) {
    const booleanValue = (name: string) => {
      const field = form.elements.namedItem(name);
      return field instanceof HTMLInputElement && field.type === 'checkbox' ? field.checked
        : field instanceof HTMLSelectElement ? field.value === 'true' : false;
    };
    const group = (selector: string, visible: boolean) => {
      const element = form.querySelector<HTMLElement>(selector);
      if (!element) return;
      element.hidden = !visible;
      element.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input,select,textarea').forEach(field => { field.required = visible; });
    };
    const update = () => {
      const newBuilding = Boolean(form.querySelector('input[name="typeOfWorkKeys"][value="new_build"]:checked')) || form.querySelector<HTMLElement>('[data-sustainability]')?.dataset.newBuilding === 'true';
      const higher = newBuilding && booleanValue('higherLevelsSustainability');
      group('[data-fire-authority-name]', !booleanValue('fireAndRescueServiceEnforcingAuthority'));
      group('[data-historical-details]', booleanValue('otherHistoricalImportance'));
      group('[data-dangerous-references]', booleanValue('dangerousBuildingNotice'));
      group('[data-relaxation-details]', booleanValue('scottishMinistersRelaxationDirection'));
      const sustainability = form.querySelector<HTMLElement>('[data-sustainability]');
      if (sustainability) sustainability.hidden = !newBuilding;
      for (let index = 0; index < 4; index++) group(`[data-sustainability-question="${index}"]`, index === 0 ? newBuilding : higher);
      group('[data-sustainability-count]', higher && booleanValue('sustainabilityMultipleBuildings'));
      group('[data-sustainability-levels="domestic"]', higher && booleanValue('sustainabilityDomesticUse'));
      group('[data-sustainability-levels="nonDomestic"]', higher && booleanValue('sustainabilityNonDomesticUse'));
    };
    form.addEventListener('click', event => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('[data-add-relaxation]')) {
        const rows = form.querySelector('[data-relaxation-rows]');
        const first = rows?.querySelector('[data-relaxation-row]');
        if (first && rows && rows.children.length < 20) {
          const copy = first.cloneNode(true) as HTMLElement;
          copy.querySelectorAll<HTMLInputElement>('input').forEach(field => { field.value = ''; });
          rows.append(copy); update(); copy.querySelector<HTMLInputElement>('input')?.focus();
        }
      }
      const remove = event.target.closest('[data-remove-relaxation]');
      if (remove) {
        const row = remove.closest('[data-relaxation-row]');
        if (row?.parentElement && row.parentElement.children.length > 1) row.remove();
        else row?.querySelectorAll<HTMLInputElement>('input').forEach(field => { field.value = ''; });
      }
    });
    form.addEventListener('change', update);
    update();
  }
</script>

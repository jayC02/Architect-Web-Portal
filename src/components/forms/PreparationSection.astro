---
// A form section in the original preparation-page style. The id and data attributes let the
// side panel's section list and the save summary find it.
interface Props {
  id: string;
  title: string;
  description?: string;
  hidden?: boolean;
  serverMissing?: number;
}
const { id, title, description, hidden = false, serverMissing = 0 } = Astro.props;
---
<section
  id={id}
  class="mt-7 scroll-mt-44 border-t border-stone-200 pt-6 first-of-type:mt-0 first-of-type:border-t-0 first-of-type:pt-0 lg:scroll-mt-6"
  aria-labelledby={`${id}-heading`}
  data-prep-section={id}
  data-prep-title={title}
  data-prep-server-missing={serverMissing > 0 ? serverMissing : undefined}
  hidden={hidden}
>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h2 id={`${id}-heading`} class="text-xl font-semibold">{title}</h2>
      {description && <p class="mt-1 text-sm text-stone-500">{description}</p>}
    </div>
    <slot name="action" />
  </div>
  <slot />
</section>

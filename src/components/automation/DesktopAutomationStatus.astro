---
import { AutomationJobStatus, AutomationJobType } from '@prisma/client';
import { AlertTriangle, CheckCircle2, CircleCheck, ClipboardCheck, FilePenLine, Lock } from 'lucide-react';
import ApplicationMoreMenu from '@/components/automation/ApplicationMoreMenu';
import AutomationLaunchButton from '@/components/automation/AutomationLaunchButton';
import AutomationRunResetButton from '@/components/automation/AutomationRunResetButton';
import DesktopAutomationLiveCard from '@/components/automation/DesktopAutomationLiveCard';
import type { FailureRecoveryContext } from '@/components/automation/AutomationFailureRecovery';
import {
  type DesktopAutomationJob,
} from '@/server/services/desktop-automation-status.service';
import { humanizeEnum } from '@/lib/format';

interface Props {
  projectId: string;
  type: 'HOUSEHOLDER_PLANNING' | 'BUILDING_WARRANT' | 'COMPLETION_CERTIFICATE';
  /** Completion Certificate only: false until the warrant has been submitted. */
  available?: boolean;
  applicationId?: string | null;
  applicationStatus: string;
  applicationLabel: string;
  manageHref: string;
  job?: DesktopAutomationJob | null;
  preparationReady?: boolean;
  missingCount?: number;
  connectedAgent?: boolean;
  recoveryContext: FailureRecoveryContext;
  /** Planning and Building Warrant runs can be reset from the card. */
  reset?: { applicationId: string; type: 'HOUSEHOLDER_PLANNING' | 'BUILDING_WARRANT' } | null;
}

const {
  projectId,
  type,
  applicationId,
  applicationStatus,
  applicationLabel,
  manageHref,
  job = null,
  preparationReady = false,
  missingCount = 0,
  connectedAgent = false,
  recoveryContext,
  available = true,
  reset = null,
} = Astro.props;
const isCompletion = type === 'COMPLETION_CERTIFICATE';
// Past portal preparation (submitted or decided): show where it stands, not preparation steps.
const progressed = !['NOT_STARTED', 'DRAFTING'].includes(applicationStatus);
const lifecycleTone = ['REFUSED', 'REJECTED', 'EXPIRED'].includes(applicationStatus) ? 'danger'
  : applicationStatus === 'FURTHER_INFORMATION_REQUESTED' ? 'warning'
    : ['WITHDRAWN', 'CLOSED'].includes(applicationStatus) ? 'neutral' : 'success';
const preparationActionLabel = type === AutomationJobType.BUILDING_WARRANT
  ? 'Complete Building Warrant details'
  : 'Complete Planning application details';
const canPrepare = !job || job.status === AutomationJobStatus.CANCELLED;
const statusLabel = preparationReady ? 'Ready to prepare' : 'Needs your attention';
const description = preparationReady
  ? `${applicationLabel} details can now be prepared for ArchitectPro Desktop.`
  : missingCount > 0
    ? `${missingCount} application detail${missingCount === 1 ? '' : 's'} must be completed before desktop preparation.`
    : `Complete the ${applicationLabel.toLowerCase()} details before desktop preparation.`;
---
{job ? (
  <DesktopAutomationLiveCard client:load jobId={job.id} applicationId={applicationId ?? ''} applicationStatus={applicationStatus} manageHref={manageHref} detailsHref={`/automation-job/${job.id}`} connectedAgent={connectedAgent} initial={{
    id: job.id,
    status: job.status,
    executionAuthorisedAt: job.executionAuthorisedAt?.toISOString() ?? null,
    progressStage: job.progressStage,
    progressStageState: job.progressStageState,
    progressPercent: job.progressPercent,
    etaSeconds: job.etaSeconds,
    progressMessage: job.progressMessage,
    resultSummary: job.resultSummary,
    error: job.error,
    resultData: job.resultData,
    lastCheckpoint: job.lastCheckpoint,
    stale: Boolean(job.agentHeartbeatAt && Date.now() - job.agentHeartbeatAt.getTime() > 90_000),
  }} applicationType={type} recoveryContext={recoveryContext} reset={reset} />
) : isCompletion ? <section class="p-5" data-tone={available ? 'info' : 'neutral'} aria-label="Completion Certificate desktop automation">
  <!-- Prepared and sent from its own page; the run then appears here like the others. -->
  <div class="flex min-w-0 items-start gap-3">
    <span class="app-tone-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full" aria-hidden="true">{available ? <ClipboardCheck size={17} /> : <Lock size={16} />}</span>
    <div class="min-w-0">
      <p class="app-tone-text text-xs font-semibold uppercase tracking-wide">Desktop automation</p>
      <h3 class="mt-0.5 text-lg font-semibold leading-6 text-ink">{available ? 'Ready to prepare' : 'Not available yet'}</h3>
    </div>
  </div>
  <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-600">{available
    ? 'Work finished? Prepare the completion certificate for this warrant and send it to the Agent.'
    : 'Available once the building warrant has been submitted to the council.'}</p>
  {available && <div class="mt-4 flex flex-wrap items-center gap-2">
    <a class="btn btn-primary" href={manageHref}>Prepare Completion Certificate</a>
    <ApplicationMoreMenu label="More application actions" items={[{ label: 'Desktop job history', href: '/automation-jobs' }]} />
  </div>}
</section> : progressed ? <section class="p-5" data-tone={lifecycleTone} aria-label={`${applicationLabel} status`}>
  <div class="flex min-w-0 items-start gap-3">
    <span class="app-tone-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full" aria-hidden="true">{lifecycleTone === 'danger' ? <AlertTriangle size={17} /> : <CheckCircle2 size={17} />}</span>
    <div class="min-w-0">
      <p class="app-tone-text text-xs font-semibold uppercase tracking-wide">Application lifecycle</p>
      <h3 class="mt-0.5 text-lg font-semibold leading-6 text-ink">{applicationStatus === 'SUBMITTED' ? 'Submitted — waiting for council' : humanizeEnum(applicationStatus)}</h3>
    </div>
  </div>
  <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-600">This application is recorded as {humanizeEnum(applicationStatus).toLowerCase()}. No desktop preparation is needed.</p>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <a class="btn btn-secondary gap-2" href={manageHref}><FilePenLine size={16} aria-hidden="true" />Review application</a>
    {reset && <AutomationRunResetButton client:load applicationId={reset.applicationId} type={reset.type} currentJobId={null} />}
    <ApplicationMoreMenu label="More application actions" items={[{ label: 'Desktop job history', href: '/automation-jobs' }]} />
  </div>
</section> : <section class="p-5" data-tone={preparationReady ? 'info' : 'warning'} aria-label={`${applicationLabel} desktop automation`}>
  <div class="flex min-w-0 items-start gap-3">
    <span class="app-tone-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full" aria-hidden="true">{preparationReady ? <CircleCheck size={17} /> : <AlertTriangle size={16} />}</span>
    <div class="min-w-0">
      <p class="app-tone-text text-xs font-semibold uppercase tracking-wide">Desktop automation</p>
      <h3 class="mt-0.5 text-lg font-semibold leading-6 text-ink">{statusLabel}</h3>
    </div>
  </div>
  <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-600">{description}</p>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    {canPrepare && preparationReady && (
      <AutomationLaunchButton
        client:load
        projectId={projectId}
        type={type as 'HOUSEHOLDER_PLANNING' | 'BUILDING_WARRANT'}
        planningApplicationId={type === AutomationJobType.HOUSEHOLDER_PLANNING ? applicationId ?? undefined : undefined}
        buildingWarrantApplicationId={type === AutomationJobType.BUILDING_WARRANT ? applicationId ?? undefined : undefined}
        label="Prepare for desktop"
      />
    )}
    {canPrepare && !preparationReady && (
      <AutomationLaunchButton
        client:load
        projectId={projectId}
        type={type as 'HOUSEHOLDER_PLANNING' | 'BUILDING_WARRANT'}
        planningApplicationId={type === AutomationJobType.HOUSEHOLDER_PLANNING ? applicationId ?? undefined : undefined}
        buildingWarrantApplicationId={type === AutomationJobType.BUILDING_WARRANT ? applicationId ?? undefined : undefined}
        label={preparationActionLabel}
        destination="preparation"
      />
    )}
    {applicationId && <a class="btn btn-secondary gap-2" href={manageHref}><FilePenLine size={16} aria-hidden="true" />Review application</a>}
    {reset && <AutomationRunResetButton client:load applicationId={reset.applicationId} type={reset.type} currentJobId={null} />}
    <ApplicationMoreMenu label="More application actions" items={[{ label: 'Desktop job history', href: '/automation-jobs' }]} />
  </div>
</section>}

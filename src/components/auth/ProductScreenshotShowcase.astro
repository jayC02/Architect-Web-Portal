<section
  class="overflow-hidden rounded-lg border border-stone-200 bg-white shadow-[0_18px_50px_rgba(32,35,31,0.09)]"
  aria-label="Architect Pro product preview"
>
  <div class="flex items-center justify-between border-b border-stone-200 px-4 py-3">
    <button
      type="button"
      aria-current="true"
      class="relative min-h-9 px-1 text-sm font-semibold text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-moss/40"
    >
      Application
      <span class="absolute inset-x-1 -bottom-3 h-0.5 bg-moss" aria-hidden="true"></span>
    </button>
    <span class="text-xs font-medium text-stone-500">Completed for review</span>
  </div>

  <figure>
    <div class="aspect-[1645/598] w-full overflow-hidden bg-stone-50">
      <img
        src="/product/sign-in-application.png"
        width="1645"
        height="598"
        loading="eager"
        fetchpriority="high"
        alt="Architect Pro planning or building warrant application prepared from project information"
        class="h-full w-full object-contain"
      />
    </div>
    <figcaption class="border-t border-stone-200 px-4 py-3 text-xs leading-5 text-stone-600 sm:text-sm">
      Use stored project information and reviewed documents to prepare the application automatically.
    </figcaption>
  </figure>
</section>

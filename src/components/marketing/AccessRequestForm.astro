---
import { marketingRoutes, contactDetails } from '@/lib/marketing/routes';

interface Props {
  /** Default reason for the request; a ?interest= query value overrides it. */
  interest?: 'demo' | 'question';
  submitLabel?: string;
}
const { interest = 'demo', submitLabel = 'Request a demo' } = Astro.props;
const sizes = ['Just me', '2–5', '6–15', '16+'];
---
<div class="form-card" data-access-form-root>
  <form
    class="access-form"
    novalidate
    data-endpoint={marketingRoutes.accessRequestApi}
    data-default-interest={interest}
  >
    <div class="fields">
      <div class="ff">
        <label for="ar-name">Your name</label>
        <input id="ar-name" name="name" required minlength="2" maxlength="120" autocomplete="name" />
        <p class="field-error" data-error-for="name" hidden></p>
      </div>
      <div class="ff">
        <label for="ar-email">Work email</label>
        <input id="ar-email" name="email" type="email" required maxlength="200" autocomplete="email" />
        <p class="field-error" data-error-for="email" hidden></p>
      </div>
      <div class="ff">
        <label for="ar-practice">Practice name</label>
        <input id="ar-practice" name="practiceName" required minlength="2" maxlength="160" autocomplete="organization" />
        <p class="field-error" data-error-for="practiceName" hidden></p>
      </div>
      <div class="ff">
        <label for="ar-role">Your role <span class="optional">(optional)</span></label>
        <input id="ar-role" name="role" maxlength="120" autocomplete="organization-title" placeholder="Director, architect, technologist…" />
      </div>
      <fieldset class="ff full">
        <legend>Practice size</legend>
        <div class="choice-row">
          {sizes.map((size, index) => (
            <label class="choice">
              <input type="radio" name="practiceSize" value={size} checked={index === 1} />
              <span>{size}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <div class="ff">
        <label for="ar-phone">Phone <span class="optional">(optional)</span></label>
        <input id="ar-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" />
      </div>
      <div class="ff">
        <label for="ar-plan">Plan you are considering <span class="optional">(optional)</span></label>
        <select id="ar-plan" name="plan">
          <option value="">Not sure yet</option>
          <option value="starter">Starter</option>
          <option value="practice">Practice</option>
          <option value="studio">Studio</option>
          <option value="enterprise">Enterprise</option>
        </select>
      </div>
      <div class="ff full">
        <label for="ar-message">{interest === 'question' ? 'How can we help?' : 'What would you like to see?'} <span class="optional">{interest === 'question' ? '' : '(optional)'}</span></label>
        <textarea id="ar-message" name="message" maxlength="2000" required={interest === 'question'} placeholder={interest === 'question' ? '' : 'For example: how many applications you submit each month, or which portal steps take longest.'}></textarea>
        <p class="field-error" data-error-for="message" hidden></p>
      </div>
      <div class="hp" aria-hidden="true">
        <label for="ar-website">Leave this field empty</label>
        <input id="ar-website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <label class="consent full ff">
        <input type="checkbox" name="consent" required />
        <span>I agree to Architect Pro contacting me about this request. We use your details only to respond, as described in our <a class="text-link" href={marketingRoutes.privacy}>privacy policy</a>.</span>
      </label>
      <p class="field-error full" data-error-for="consent" hidden style="grid-column: 1 / -1;"></p>
    </div>
    <div class="form-foot">
      <button class="button primary" type="submit">{submitLabel}</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </div>
  </form>
  <div class="form-success" hidden tabindex="-1">
    <p class="eyebrow">Request received</p>
    <h2>Thanks. We will be in touch within one working day.</h2>
    <p>We review every request by hand. If your practice is a fit, you will get an email to choose a time and, after the demo, an invitation to your evaluation workspace.</p>
    <p>Already decided? <a class="text-link" href={marketingRoutes.pricing}>Start a subscription</a>.</p>
  </div>
  <noscript>
    <p class="footnote">This form needs JavaScript. You can also email <a class="text-link" href={`mailto:${contactDetails.salesEmail}`}>{contactDetails.salesEmail}</a>.</p>
  </noscript>
</div>

<script>
  import { contactDetails } from '@/lib/marketing/routes';

  const requiredMessages: Record<string, string> = {
    name: 'Enter your name.',
    email: 'Enter a valid work email.',
    practiceName: 'Enter your practice name.',
    message: 'Tell us how we can help.',
    consent: 'Please agree so we can contact you.',
  };

  document.querySelectorAll<HTMLElement>('[data-access-form-root]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const success = root.querySelector<HTMLElement>('.form-success')!;
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const params = new URLSearchParams(window.location.search);
    const interestParam = params.get('interest');
    const planSelect = form.querySelector<HTMLSelectElement>('select[name="plan"]');
    if (interestParam && planSelect && [...planSelect.options].some((option) => option.value === interestParam)) {
      planSelect.value = interestParam;
    }

    const setError = (field: string, message: string) => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      const control = form.elements.namedItem(field);
      if (error) { error.textContent = message; error.hidden = !message; }
      if (control instanceof HTMLElement) {
        if (message) control.setAttribute('aria-invalid', 'true');
        else control.removeAttribute('aria-invalid');
      }
    };

    const validate = () => {
      let first: HTMLElement | null = null;
      for (const field of Object.keys(requiredMessages)) {
        const control = form.elements.namedItem(field);
        if (!(control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement)) continue;
        const valid = control.checkValidity() && (control.type === 'checkbox' || control.value.trim().length > 0 || !control.required);
        setError(field, valid ? '' : requiredMessages[field]);
        if (!valid && !first) first = control;
      }
      first?.focus();
      return !first;
    };

    form.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name && target.getAttribute('aria-invalid')) setError(target.name, '');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      status.classList.remove('error');
      if (!validate()) return;

      const data = new FormData(form);
      const showSuccess = () => {
        form.hidden = true;
        success.hidden = false;
        success.focus();
      };
      // Bots fill the hidden field; humans never see it.
      if (String(data.get('website') ?? '').length > 0) { showSuccess(); return; }

      const payload = {
        name: String(data.get('name') ?? '').trim(),
        email: String(data.get('email') ?? '').trim(),
        practiceName: String(data.get('practiceName') ?? '').trim(),
        role: String(data.get('role') ?? '').trim(),
        practiceSize: String(data.get('practiceSize') ?? ''),
        phone: String(data.get('phone') ?? '').trim(),
        message: String(data.get('message') ?? '').trim(),
        interest: form.dataset.defaultInterest ?? 'demo',
        plan: String(data.get('plan') ?? ''),
      };

      submit.disabled = true;
      status.textContent = 'Sending…';
      try {
        const response = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        if (response.ok) { showSuccess(); return; }
        const body = await response.json().catch(() => ({}));
        status.textContent = response.status === 429
          ? 'Too many requests. Please try again in a few minutes.'
          : (typeof body.error === 'string' && body.error) || `We couldn't send your request. Please email ${contactDetails.salesEmail}.`;
        status.classList.add('error');
      } catch {
        status.textContent = `Network error. Please try again or email ${contactDetails.salesEmail}.`;
        status.classList.add('error');
      } finally {
        submit.disabled = false;
      }
    });
  });
</script>

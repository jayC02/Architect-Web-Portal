---
// A drawing sheet that sits beside a run of page content and builds up one
// architectural drawing as the visitor scrolls. The page scrolls normally;
// nothing is pinned or hijacked. Mark blocks in the slot with
// data-sheet-stage="1".."N" to say which stage each one draws. Stage 0 draws
// when the sheet first comes into view. Decorative: hidden from assistive tech.
import { scenes, type SceneId } from '@/lib/marketing/drawing-scenes';

interface Props {
  scene: SceneId;
  /** Drawing number in the title block, e.g. AP-101. */
  number: string;
  class?: string;
}

const { scene: sceneId, number, class: className } = Astro.props;
const scene = scenes[sceneId]();
const letters = 'ABCDEFGH';
---
<div class:list={['board', className]} data-board>
  <div class="board-content">
    <slot />
  </div>
  <aside class="board-sheet" aria-hidden="true">
    <div class="sheet-frame">
      <svg viewBox="0 0 600 520" preserveAspectRatio="xMidYMid meet" fill="none">
        {scene.fills?.map((fill) => <g class="f" data-stage={fill.stage} data-s="0.5" data-e="1"><path class="room-fill" data-room={fill.room} d={fill.d} /></g>)}
        {scene.items.map((item) => item.kind === 'path'
          ? (
            <path
              d={item.d}
              class:list={[item.mode === 'draw' ? 'd' : 'f', `tone-${item.tone}`, { dashed: item.dashed }]}
              pathLength={item.mode === 'draw' ? 1 : undefined}
              data-stage={item.stage}
              data-s={item.s}
              data-e={item.e}
            />
          )
          : (
            <text
              x={item.x}
              y={item.y}
              font-size={Math.round(item.size * 1.3)}
              text-anchor={item.anchor}
              transform={item.rotate ? `rotate(${item.rotate} ${item.x} ${item.y})` : undefined}
              class:list={['f', `tone-${item.tone}`]}
              data-stage={item.stage}
              data-s={item.s}
              data-e={item.e}
            >{item.text}</text>
          ))}
      </svg>
      <div class="title-block">
        <div class="tb-head">
          <p class="tb-name"><b>Architect Pro</b><span>{scene.caption}</span></p>
          <dl class="tb-meta">
            <div><dt>Drawing</dt><dd>{number}</dd></div>
            <div><dt>Scale</dt><dd>1:100</dd></div>
            <div><dt>Rev</dt><dd data-rev>–</dd></div>
          </dl>
        </div>
        <ol class="revisions">
          {scene.revisions.map((revision, index) => (
            <li data-rev-stage={index + 1}><b>{letters[index]}</b><span>{revision}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </aside>
</div>

<script>
  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  const easeOut = (value: number) => 1 - Math.pow(1 - value, 3);

  interface Mark {
    el: SVGElement;
    stage: number;
    s: number;
    e: number;
    draw: boolean;
    last: number;
  }

  function setUp(board: HTMLElement) {
    const marks: Mark[] = [...board.querySelectorAll<SVGElement>('svg [data-stage]')].map((el) => ({
      el,
      stage: Number(el.dataset.stage),
      s: Number(el.dataset.s ?? 0),
      e: Number(el.dataset.e ?? 1),
      draw: el.classList.contains('d'),
      last: -1,
    }));
    const stageCount = Math.max(0, ...marks.map((mark) => mark.stage));
    const revisions = [...board.querySelectorAll<HTMLElement>('[data-rev-stage]')];
    const revOut = board.querySelector<HTMLElement>('[data-rev]');
    const content = board.querySelector<HTMLElement>('.board-content')!;
    const anchors: (HTMLElement | null)[] = [null];
    for (let stage = 1; stage <= stageCount; stage += 1) {
      anchors.push(content.querySelector<HTMLElement>(`[data-sheet-stage="${stage}"]`));
    }

    // Highest progress reached per stage: a drawing, once drawn, stays drawn.
    const reached = new Array(stageCount + 1).fill(0);
    const shown = new Array(stageCount + 1).fill(0);
    let openedAt = 0;
    let frame = 0;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      revisions.forEach((row) => row.classList.add('on'));
      if (revOut) revOut.textContent = revisions.at(-1)?.querySelector('b')?.textContent ?? '–';
      return;
    }
    board.classList.add('js');

    // On narrow screens the sheet sits after the content instead of beside it, so
    // it draws itself, stage after stage, as it scrolls into view.
    const sheet = board.querySelector<HTMLElement>('.board-sheet')!;
    const stacked = window.matchMedia('(max-width: 1040px)');

    const targetFor = (stage: number, viewport: number) => {
      if (stacked.matches) {
        const box = sheet.getBoundingClientRect();
        const through = clamp((viewport * 0.95 - box.top) / Math.max(1, box.height * 0.85));
        return clamp(through * (stageCount + 1) - stage);
      }
      if (stage === 0) return openedAt ? easeOut(clamp((performance.now() - openedAt) / 1600)) : 0;
      const anchor = anchors[stage];
      if (anchor) {
        const top = anchor.getBoundingClientRect().top;
        return clamp((viewport * 0.92 - top) / (viewport * 0.42));
      }
      // No marked block: share the run of content evenly between stages.
      const box = content.getBoundingClientRect();
      const through = clamp((viewport * 0.75 - box.top) / Math.max(1, box.height));
      return clamp((through - (stage - 1) / stageCount) * stageCount);
    };

    const render = () => {
      frame = 0;
      const viewport = window.innerHeight;
      if (!openedAt && board.getBoundingClientRect().top < viewport * 0.9) openedAt = performance.now();

      // Stage 0 eases in on a timer beside the content; everything else follows scroll.
      const timed = !stacked.matches;
      let moving = timed && openedAt > 0 && shown[0] < 0.999;
      for (let stage = 0; stage <= stageCount; stage += 1) {
        reached[stage] = Math.max(reached[stage], targetFor(stage, viewport));
        const gap = reached[stage] - shown[stage];
        if (stage === 0 && timed) shown[0] = reached[0];
        else if (gap > 0.002) { shown[stage] += gap * 0.14; moving = true; }
        else shown[stage] = reached[stage];
      }

      for (const mark of marks) {
        const t = clamp((shown[mark.stage] - mark.s) / Math.max(0.001, mark.e - mark.s));
        if (Math.abs(t - mark.last) < 0.002) continue;
        mark.last = t;
        if (mark.draw) {
          mark.el.style.strokeDashoffset = String(1 - t);
          mark.el.style.visibility = t > 0 ? 'visible' : 'hidden';
        } else {
          mark.el.style.opacity = String(t);
        }
      }

      let latest = '–';
      revisions.forEach((row, index) => {
        const on = shown[index + 1] > 0.6;
        row.classList.toggle('on', on);
        if (on) latest = row.querySelector('b')?.textContent ?? latest;
      });
      if (revOut && revOut.textContent !== latest) revOut.textContent = latest;

      if (moving) schedule();
    };

    const schedule = () => { if (!frame) frame = requestAnimationFrame(render); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    schedule();
  }

  document.querySelectorAll<HTMLElement>('[data-board]').forEach(setUp);
</script>

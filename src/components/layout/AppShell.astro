---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { OrganisationRole } from '@prisma/client';

interface Props {
  title: string;
  user: { name: string; email: string };
  organisation: { name: string };
  role: OrganisationRole;
}

const { title, user, organisation, role } = Astro.props;
const nav = [
  ['Dashboard', '/dashboard'],
  ['Projects', '/projects'],
  ['Clients', '/clients'],
  ['Sites', '/sites'],
  ['Deadlines', '/deadlines'],
  ['Documents', '/documents'],
  ['Settings', '/settings'],
];
const pathname = Astro.url.pathname;
---
<BaseLayout title={`${title} | Architect Web Portal`} noindex={true}>
  <div class="min-h-screen bg-paper">
    <aside class="fixed inset-y-0 left-0 hidden w-64 border-r border-stone-200 bg-white lg:block">
      <div class="border-b border-stone-200 px-5 py-5">
        <a href="/dashboard" class="block font-display text-lg font-semibold text-ink">Architect Web Portal</a>
        <p class="mt-1 text-xs text-stone-500">{organisation.name}</p>
      </div>
      <nav class="space-y-1 px-3 py-4">
        {nav.map(([label, href]) => (
          <a class:list={['app-link', pathname === href || pathname.startsWith(`${href}/`) ? 'app-link-active' : '']} href={href}>
            <span>{label}</span>
          </a>
        ))}
      </nav>
      <div class="absolute inset-x-0 bottom-0 border-t border-stone-200 p-4">
        <p class="truncate text-sm font-semibold">{user.name}</p>
        <p class="truncate text-xs text-stone-500">{user.email}</p>
        <p class="mt-2 text-xs uppercase text-stone-500">{role}</p>
        <button data-logout class="btn btn-secondary mt-3 w-full">Sign out</button>
      </div>
    </aside>

    <div class="lg:pl-64">
      <header class="sticky top-0 z-20 border-b border-stone-200 bg-paper/95 px-4 py-3 backdrop-blur lg:hidden">
        <div class="flex items-center justify-between gap-3">
          <a href="/dashboard" class="font-semibold">Architect Web Portal</a>
          <button data-logout class="btn btn-secondary">Sign out</button>
        </div>
        <nav class="mt-3 flex gap-2 overflow-x-auto pb-1">
          {nav.map(([label, href]) => <a class="shrink-0 rounded-md border border-stone-200 bg-white px-3 py-2 text-sm" href={href}>{label}</a>)}
        </nav>
      </header>
      <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

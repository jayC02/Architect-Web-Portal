---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { OrganisationRole } from '@prisma/client';
import {
  Building2,
  CalendarClock,
  FileText,
  FolderKanban,
  LayoutDashboard,
  LogOut,
  MapPinned,
  Settings,
  Users,
} from 'lucide-react';

interface Props {
  title: string;
  user: { name: string; email: string };
  organisation: { name: string };
  role: OrganisationRole;
}

const { title, user, organisation, role } = Astro.props;
const nav = [
  { label: 'Dashboard', href: '/dashboard', icon: LayoutDashboard },
  { label: 'Projects', href: '/projects', icon: FolderKanban },
  { label: 'Clients', href: '/clients', icon: Users },
  { label: 'Sites', href: '/sites', icon: MapPinned },
  { label: 'Deadlines', href: '/deadlines', icon: CalendarClock },
  { label: 'Documents', href: '/documents', icon: FileText },
  { label: 'Settings', href: '/settings', icon: Settings },
];
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---
<BaseLayout title={`${title} | Architect Web Portal`} noindex={true}>
  <div class="min-h-screen bg-paper">
    <aside class="fixed inset-y-0 left-0 hidden w-72 border-r border-stone-200/80 bg-[#fbfaf6] lg:block">
      <div class="px-5 py-5">
        <a href="/dashboard" class="flex items-center gap-3 rounded-xl p-2 transition hover:bg-white">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-ink text-paper"><Building2 size={20} /></span>
          <span class="min-w-0">
            <span class="block truncate font-display text-base font-semibold text-ink">Architect Web Portal</span>
            <span class="block truncate text-xs text-stone-500">{organisation.name}</span>
          </span>
        </a>
      </div>
      <nav class="space-y-1 px-4 py-2">
        {nav.map(({ label, href, icon: Icon }) => (
          <a class:list={['app-link', isActive(href) ? 'app-link-active' : '']} href={href}>
            <span class="flex items-center gap-3">
              <Icon size={17} />
              <span>{label}</span>
            </span>
          </a>
        ))}
      </nav>
      <div class="absolute inset-x-4 bottom-4 rounded-xl border border-stone-200 bg-white p-4 shadow-[0_14px_40px_rgba(32,35,31,0.06)]">
        <div class="flex items-start gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-stone-100 text-sm font-semibold text-ink">{user.name.slice(0, 1).toUpperCase()}</div>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold">{user.name}</p>
            <p class="truncate text-xs text-stone-500">{user.email}</p>
            <p class="mt-2 inline-flex rounded-full bg-stone-100 px-2 py-1 text-[11px] font-semibold uppercase text-stone-600">{role}</p>
          </div>
        </div>
        <button data-logout class="btn btn-secondary mt-4 w-full gap-2"><LogOut size={16} /> Sign out</button>
      </div>
    </aside>

    <div class="lg:pl-72">
      <header class="sticky top-0 z-20 border-b border-stone-200 bg-paper/95 px-4 py-3 backdrop-blur lg:hidden">
        <div class="flex items-center justify-between gap-3">
          <a href="/dashboard" class="flex items-center gap-2 font-semibold"><Building2 size={18} /> Architect Web Portal</a>
          <button data-logout class="btn btn-secondary gap-2"><LogOut size={16} /> Sign out</button>
        </div>
        <nav class="mt-3 flex gap-2 overflow-x-auto pb-1">
          {nav.map(({ label, href, icon: Icon }) => (
            <a class:list={['shrink-0 rounded-md border px-3 py-2 text-sm transition', isActive(href) ? 'border-ink bg-ink text-paper' : 'border-stone-200 bg-white text-stone-700']} href={href}>
              <span class="flex items-center gap-2"><Icon size={15} /> {label}</span>
            </a>
          ))}
        </nav>
      </header>
      <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandLogo from '@/components/brand/BrandLogo.astro';
import type { OrganisationRole } from '@prisma/client';
import {
  CalendarDays,
  FilePlus2,
  FolderKanban,
  LayoutDashboard,
  LogOut,
  Settings,
  CircleDollarSign,
} from 'lucide-react';

interface Props {
  title: string;
  user: { name: string; email: string };
  organisation: { name: string };
  role: OrganisationRole;
}

const { title, user, organisation, role } = Astro.props;
type NavigationItem = {
  label: string;
  href: string;
  icon: typeof LayoutDashboard;
  activePrefixes: string[];
};

const newApplication: NavigationItem = {
  label: 'New application',
  href: '/applications/new',
  icon: FilePlus2,
  activePrefixes: ['/applications'],
};
const primaryNav: NavigationItem[] = [
  { label: 'Today', href: '/dashboard', icon: LayoutDashboard, activePrefixes: ['/dashboard', '/email-updates'] },
  {
    label: 'Projects',
    href: '/projects',
    icon: FolderKanban,
    activePrefixes: ['/projects', '/clients', '/sites', '/planning', '/building-warrant', '/automation-job'],
  },
  { label: 'Calendar', href: '/calendar', icon: CalendarDays, activePrefixes: ['/calendar', '/deadlines'] },
  ...(['OWNER', 'ADMIN'].includes(role)
    ? [{ label: 'Finance', href: '/finance', icon: CircleDollarSign, activePrefixes: ['/finance'] }]
    : []),
];
const settingsNav: NavigationItem = {
  label: 'Settings',
  href: '/settings',
  icon: Settings,
  activePrefixes: ['/settings', '/automation-jobs'],
};
const pathname = Astro.url.pathname;
const isActive = ({ activePrefixes }: NavigationItem) => activePrefixes.some((prefix) =>
  pathname === prefix || pathname.startsWith(`${prefix}/`),
);
---
<BaseLayout title={`${title} | Architect Pro`} noindex={true}>
  <div class="min-h-screen bg-paper">
    <aside class="fixed inset-y-0 left-0 hidden w-72 flex-col border-r border-stone-200/80 bg-[#fbfaf6] lg:flex">
      <div class="px-5 py-5">
        <a href="/dashboard" class="block rounded-md p-2 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-moss/30">
          <BrandLogo class="h-auto w-40 max-w-full" />
          <span class="mt-1 block truncate text-xs text-stone-500">{organisation.name}</span>
        </a>
      </div>
      <div class="px-4 pb-3">
        <a
          class:list={['btn btn-primary w-full justify-start gap-3', isActive(newApplication) && 'ring-2 ring-moss/30 ring-offset-2']}
          href={newApplication.href}
          aria-current={isActive(newApplication) ? 'page' : undefined}
        >
          <FilePlus2 size={17} aria-hidden="true" />
          <span>New application</span>
        </a>
      </div>
      <nav aria-label="Primary navigation" class="min-h-0 flex-1 space-y-1 overflow-y-auto px-4 py-2">
        {primaryNav.map((item) => {
          const Icon = item.icon;
          return (
            <a class:list={['app-link', isActive(item) ? 'app-link-active' : '']} href={item.href} aria-current={isActive(item) ? 'page' : undefined}>
              <span class="flex items-center gap-3">
                <Icon size={17} aria-hidden="true" />
                <span>{item.label}</span>
              </span>
            </a>
          );
        })}
      </nav>
      <nav aria-label="Secondary navigation" class="mx-4 border-t border-stone-200 py-3">
        <a class:list={['app-link', isActive(settingsNav) ? 'app-link-active' : '']} href={settingsNav.href} aria-current={isActive(settingsNav) ? 'page' : undefined}>
          <span class="flex items-center gap-3">
            <Settings size={17} aria-hidden="true" />
            <span>Settings</span>
          </span>
        </a>
      </nav>
      <div class="mx-4 mb-4 mt-3 rounded-xl border border-stone-200 bg-white p-4 shadow-[0_14px_40px_rgba(32,35,31,0.06)]">
        <div class="flex items-start gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-stone-100 text-sm font-semibold text-ink">{user.name.slice(0, 1).toUpperCase()}</div>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold">{user.name}</p>
            <p class="truncate text-xs text-stone-500">{user.email}</p>
            <p class="mt-2 inline-flex rounded-full bg-stone-100 px-2 py-1 text-[11px] font-semibold uppercase text-stone-600">{role}</p>
          </div>
        </div>
        <button data-logout class="btn btn-secondary mt-4 w-full gap-2"><LogOut size={16} /> Sign out</button>
      </div>
    </aside>

    <div class="lg:pl-72">
      <header class="sticky top-0 z-20 border-b border-stone-200 bg-paper/95 px-4 py-3 backdrop-blur lg:hidden">
        <div class="flex items-center justify-between gap-3">
          <a href="/dashboard" class="rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-moss/30">
            <BrandLogo variant="mark" class="h-8 w-8" />
          </a>
          <div class="flex items-center gap-2">
            <a
              class:list={['btn btn-primary min-h-10 gap-2 px-3', isActive(newApplication) && 'ring-2 ring-moss/30 ring-offset-2']}
              href={newApplication.href}
              aria-current={isActive(newApplication) ? 'page' : undefined}
            >
              <FilePlus2 size={16} aria-hidden="true" />
              <span>New application</span>
            </a>
            <button data-logout class="btn btn-secondary h-10 w-10 gap-2 px-0 sm:w-auto sm:px-4"><LogOut size={16} aria-hidden="true" /><span class="sr-only sm:not-sr-only">Sign out</span></button>
          </div>
        </div>
        <nav aria-label="Mobile navigation" class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-5">
          {[...primaryNav, settingsNav].map((item) => {
            const Icon = item.icon;
            return (
              <a class:list={['min-w-0 rounded-md border px-2 py-2 text-center text-sm transition focus:outline-none focus-visible:ring-2 focus-visible:ring-moss/30', isActive(item) ? 'border-ink bg-ink text-paper' : 'border-stone-200 bg-white text-stone-700']} href={item.href} aria-current={isActive(item) ? 'page' : undefined}>
                <span class="flex items-center justify-center gap-2"><Icon size={15} aria-hidden="true" /><span class="truncate">{item.label}</span></span>
              </a>
            );
          })}
        </nav>
      </header>
      <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

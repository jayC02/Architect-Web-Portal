---
// Shown inside the app when access is about to end (trial ending, failed
// payment, cancellation scheduled). Set by src/middleware.ts.
const warning = Astro.locals.entitlement?.warning;
---
{warning && (
  <div role="status" class="mb-5 flex flex-wrap items-center justify-between gap-3 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
    <span>{warning}</span>
    <a href="/billing" class="font-semibold underline">Manage billing</a>
  </div>
)}

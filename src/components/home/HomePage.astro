---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { storyMarkup } from './scroll-story/markup.js';
import '@/styles/scroll-home.css';
---
<BaseLayout
  title="Architect Pro | No more portal"
  description="From the first red line to planning permission and building warrants. See how Architect Pro prepares your applications and keeps your projects together."
>
  <Fragment slot="head">
    <meta name="theme-color" content="#e6edf9" />
    <link rel="preload" href="/fonts/scroll-story/space-grotesk-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
  </Fragment>
  <div id="scroll-home" class="scroll-home" data-view="3d">
    <a href="#home-content" class="skip-link">Skip to content</a>
    <div id="scroll-home-content" set:html={storyMarkup()} />
  </div>
  <script>
    import { mountScrollHome } from './scroll-story/main.js';
    mountScrollHome();
  </script>
</BaseLayout>

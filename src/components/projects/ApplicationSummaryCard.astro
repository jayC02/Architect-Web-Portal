---
import { AutomationJobType } from '@prisma/client';
import { Building2 } from 'lucide-react';
import DesktopAutomationStatus from '@/components/automation/DesktopAutomationStatus.astro';
import type { FailureRecoveryContext } from '@/components/automation/AutomationFailureRecovery';
import type { DesktopAutomationJob } from '@/server/services/desktop-automation-status.service';

interface Props {
  id: string;
  title: string;
  subtitle: string;
  manageHref: string;
  address: string;
  clientName: string;
  applicationType: string;
  status: string;
  documentCount: number;
  reference: string;
  projectId: string;
  applicationKind: 'PLANNING' | 'BUILDING_WARRANT';
  applicationId?: string;
  applicationStatus: string;
  desktopJob?: DesktopAutomationJob | null;
  desktopPreparationReady?: boolean;
  desktopMissingCount?: number;
  connectedAgent?: boolean;
  recoveryContext: FailureRecoveryContext;
}

const {
  id,
  title,
  subtitle,
  manageHref,
  address,
  clientName,
  applicationType,
  status,
  documentCount,
  reference,
  projectId,
  applicationKind,
  applicationId,
  applicationStatus,
  desktopJob,
  desktopPreparationReady = false,
  desktopMissingCount = 0,
  connectedAgent = false,
  recoveryContext,
} = Astro.props;
---
<section id={id} class="flex h-full scroll-mt-24 flex-col overflow-hidden rounded-lg border border-stone-200 bg-white">
  <header class="flex items-start justify-between gap-4 px-4 pb-3 pt-4 sm:px-5 sm:pt-5">
    <div class="flex min-w-0 items-start gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-moss text-white shadow-[inset_0_0_0_1px_rgba(255,255,255,0.16)]" aria-hidden="true"><Building2 size={19} strokeWidth={1.8} /></span>
      <div class="min-w-0">
        <h2 class="text-lg font-semibold leading-6 text-ink">{title}</h2>
        <p class="mt-0.5 text-sm text-stone-500">{subtitle}</p>
      </div>
    </div>
    <div class="flex shrink-0 flex-col items-end gap-2">
      <span class="inline-flex items-center gap-2 rounded-md bg-moss/5 px-2.5 py-1.5 text-xs font-semibold text-stone-700"><span class="h-1.5 w-1.5 rounded-full bg-moss" aria-hidden="true"></span>{status}</span>
      <a class="rounded-sm text-xs font-semibold text-stone-500 hover:text-moss focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-moss/30" href={manageHref}>Manage</a>
    </div>
  </header>

  <dl class="grid flex-1 gap-x-8 gap-y-4 px-4 py-4 sm:grid-cols-2 sm:px-5">
    <div class="min-w-0">
      <dt class="label">Address</dt>
      <dd class="break-words text-sm font-medium leading-6 text-ink">{address}</dd>
    </div>
    <div class="min-w-0">
      <dt class="label">Documents</dt>
      <dd class="text-sm font-medium leading-6 text-ink">{documentCount} document{documentCount === 1 ? '' : 's'}</dd>
    </div>
    <div class="min-w-0">
      <dt class="label">Client</dt>
      <dd class="break-words text-sm font-medium leading-6 text-ink">{clientName}</dd>
    </div>
    <div class="min-w-0">
      <dt class="label">Application type</dt>
      <dd class="break-words text-sm font-medium leading-6 text-ink">{applicationType}</dd>
    </div>
    <div class="min-w-0">
      <dt class="label">Reference</dt>
      <dd class="break-words text-sm font-medium leading-6 text-ink">{reference}</dd>
    </div>
  </dl>

  <footer class="mt-auto border-t border-stone-200 bg-moss/[0.035]">
    <DesktopAutomationStatus
      projectId={projectId}
      type={applicationKind === 'PLANNING' ? AutomationJobType.HOUSEHOLDER_PLANNING : AutomationJobType.BUILDING_WARRANT}
      applicationId={applicationId}
      applicationStatus={applicationStatus}
      applicationLabel={applicationKind === 'PLANNING' ? 'Householder application' : 'Building Warrant application'}
      manageHref={manageHref}
      job={desktopJob}
      preparationReady={desktopPreparationReady}
      missingCount={desktopMissingCount}
      connectedAgent={connectedAgent}
      recoveryContext={recoveryContext}
    />
  </footer>
</section>

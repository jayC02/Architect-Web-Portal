---
import { AutomationJobType } from '@prisma/client';
import { BadgeCheck, Building2, Map as MapIcon } from 'lucide-react';
import DesktopAutomationStatus from '@/components/automation/DesktopAutomationStatus.astro';
import AutomationRunResetButton from '@/components/automation/AutomationRunResetButton';
import type { FailureRecoveryContext } from '@/components/automation/AutomationFailureRecovery';
import type { DesktopAutomationJob } from '@/server/services/desktop-automation-status.service';

interface Props {
  id: string;
  title: string;
  subtitle: string;
  manageHref: string;
  applicationType: string;
  status: string;
  documentCount: number;
  reference: string;
  projectId: string;
  applicationKind: 'PLANNING' | 'BUILDING_WARRANT' | 'COMPLETION_CERTIFICATE';
  applicationId?: string;
  applicationStatus: string;
  desktopJob?: DesktopAutomationJob | null;
  desktopPreparationReady?: boolean;
  desktopMissingCount?: number;
  connectedAgent?: boolean;
  recoveryContext: FailureRecoveryContext;
  /** Completion Certificate tile only: false until the warrant has been submitted. */
  available?: boolean;
}

const {
  id,
  title,
  subtitle,
  manageHref,
  applicationType,
  status,
  documentCount,
  reference,
  projectId,
  applicationKind,
  applicationId,
  applicationStatus,
  desktopJob,
  desktopPreparationReady = false,
  desktopMissingCount = 0,
  connectedAgent = false,
  recoveryContext,
  available = true,
} = Astro.props;
const jobType = applicationKind === 'PLANNING' ? AutomationJobType.HOUSEHOLDER_PLANNING
  : applicationKind === 'COMPLETION_CERTIFICATE' ? 'COMPLETION_CERTIFICATE' as const
    : AutomationJobType.BUILDING_WARRANT;
const applicationLabel = applicationKind === 'PLANNING' ? 'Householder application'
  : applicationKind === 'COMPLETION_CERTIFICATE' ? 'Completion Certificate' : 'Building Warrant application';
const Icon = applicationKind === 'PLANNING' ? MapIcon : applicationKind === 'COMPLETION_CERTIFICATE' ? BadgeCheck : Building2;
---
<section id={id} class="grid min-w-0 scroll-mt-24 [overflow-wrap:anywhere] lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
  <div class="flex min-w-0 flex-col gap-5 p-4 sm:p-5">
    <header class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
      <div class="flex min-w-0 items-start gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-moss/10 text-moss" aria-hidden="true"><Icon size={18} strokeWidth={1.8} /></span>
        <div class="min-w-0">
          <h3 class="text-base font-semibold leading-6 text-ink">{title}</h3>
          <p class="mt-0.5 text-sm leading-5 text-stone-500">{subtitle}</p>
        </div>
      </div>
      <span class="inline-flex shrink-0 items-center gap-2 rounded-md bg-moss/5 px-2.5 py-1 text-xs font-semibold text-stone-700"><span class:list={['h-1.5 w-1.5 rounded-full', available ? 'bg-moss' : 'bg-stone-400']} aria-hidden="true"></span>{status}</span>
    </header>

    <dl class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3">
      <div class="min-w-0">
        <dt class="label">Application type</dt>
        <dd class="break-words text-sm font-medium leading-5 text-ink">{applicationType}</dd>
      </div>
      <div class="min-w-0">
        <dt class="label">Reference</dt>
        <dd class:list={['break-words text-sm font-medium leading-5', reference === 'Not assigned' ? 'text-stone-500' : 'text-ink']}>{reference}</dd>
      </div>
      <div class="min-w-0">
        <dt class="label">Documents</dt>
        <dd class="text-sm font-medium leading-5 text-ink">{documentCount}</dd>
      </div>
    </dl>
  </div>

  <footer class="min-w-0 border-t border-stone-200 bg-stone-50/60 lg:border-l lg:border-t-0">
    <DesktopAutomationStatus
      projectId={projectId}
      type={jobType}
      applicationId={applicationId}
      applicationStatus={applicationStatus}
      applicationLabel={applicationLabel}
      available={available}
      manageHref={manageHref}
      job={desktopJob}
      preparationReady={desktopPreparationReady}
      missingCount={desktopMissingCount}
      connectedAgent={connectedAgent}
      recoveryContext={recoveryContext}
    />
    {applicationId && applicationKind !== 'COMPLETION_CERTIFICATE' && <AutomationRunResetButton client:load applicationId={applicationId} type={applicationKind === 'PLANNING' ? 'HOUSEHOLDER_PLANNING' : 'BUILDING_WARRANT'} currentJobId={desktopJob?.id ?? null} />}
  </footer>
</section>

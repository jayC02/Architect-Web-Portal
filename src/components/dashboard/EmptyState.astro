---
interface Props {
  title: string;
  description?: string;
  href?: string;
  actionLabel?: string;
}

const { title, description, href, actionLabel } = Astro.props;
---
<div class="rounded-lg border border-dashed border-stone-300 bg-stone-50/70 px-4 py-6 text-center">
  <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full border border-stone-200 bg-white text-stone-500">
    <slot name="icon" />
  </div>
  <p class="mt-3 text-sm font-semibold text-ink">{title}</p>
  {description && <p class="mx-auto mt-1 max-w-sm text-sm text-stone-500">{description}</p>}
  {href && actionLabel && <a href={href} class="btn btn-secondary mt-4">{actionLabel}</a>}
</div>

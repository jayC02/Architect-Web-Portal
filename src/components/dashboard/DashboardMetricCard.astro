---
import MiniSparkline from './MiniSparkline.astro';

interface Props {
  href: string;
  label: string;
  value: number;
  context: string;
  active?: boolean;
}

const { href, label, value, context, active = false } = Astro.props;
---
<a href={href} class="panel group block rounded-xl p-4 transition hover:-translate-y-0.5 hover:border-stone-300 hover:shadow-[0_18px_45px_rgba(32,35,31,0.08)] focus:outline-none focus-visible:ring-2 focus-visible:ring-moss/40">
  <div class="flex items-start justify-between gap-3">
    <div class="rounded-lg border border-stone-200 bg-stone-50 p-2 text-stone-600 transition group-hover:bg-white group-hover:text-ink">
      <slot name="icon" />
    </div>
    <MiniSparkline active={active} />
  </div>
  <p class="mt-4 text-sm font-medium text-stone-500">{label}</p>
  <p class="mt-2 text-4xl font-semibold tracking-normal text-ink">{value}</p>
  <p class="mt-2 text-xs text-stone-500">{context}</p>
</a>

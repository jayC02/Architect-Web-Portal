---
interface Props {
  label: string;
  tone?: 'neutral' | 'success' | 'warning' | 'danger' | 'info';
}

const { label, tone = 'neutral' } = Astro.props;
const tones = {
  neutral: { dot: 'bg-stone-400', text: 'text-stone-600' },
  success: { dot: 'bg-moss', text: 'text-stone-700' },
  warning: { dot: 'bg-amber-500', text: 'text-amber-800' },
  danger: { dot: 'bg-red-700', text: 'text-red-700' },
  info: { dot: 'bg-steel', text: 'text-stone-700' },
};
---
<span class={`inline-flex items-center gap-2 text-xs font-medium ${tones[tone].text}`}>
  <span class={`h-2 w-2 rounded-full ${tones[tone].dot}`} aria-hidden="true"></span>
  {label}
</span>

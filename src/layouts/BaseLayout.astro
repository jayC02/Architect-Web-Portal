---
import '@/styles/global.css';
import { siteConfig } from '@/lib/config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = siteConfig.name,
  description = siteConfig.defaultDescription,
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      document.addEventListener('submit', async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-api-form')) return;
        event.preventDefault();
        const confirmMessage = form.dataset.confirm;
        if (confirmMessage && !window.confirm(confirmMessage)) return;
        const method = form.dataset.method || form.method || 'POST';
        const action = form.dataset.action || form.action;
        const redirect = form.dataset.redirect;
        const status = form.querySelector('[data-form-status]');
        const submitButtons = Array.from(form.querySelectorAll('button[type="submit"], button:not([type])'));
        if (status) {
          status.textContent = 'Saving...';
          status.setAttribute('role', 'status');
          status.classList.remove('text-red-700');
          status.classList.add('text-stone-500');
        }
        submitButtons.forEach((button) => {
          if (button instanceof HTMLButtonElement) button.disabled = true;
        });

        try {
          const formData = new FormData(form);
          const values: Record<string, FormDataEntryValue | FormDataEntryValue[]> = {};
          for (const [key, value] of formData.entries()) {
            if (key in values) {
              const existing = values[key];
              values[key] = Array.isArray(existing) ? [...existing, value] : [existing, value];
            } else {
              values[key] = value;
            }
          }
          const body = form.enctype === 'multipart/form-data' ? formData : JSON.stringify(values);

          const headers = form.enctype === 'multipart/form-data' ? undefined : { 'accept': 'application/json', 'content-type': 'application/json' };
          const response = await fetch(action, { method, headers, body });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            if (status) {
              status.textContent = payload.error || 'Request failed.';
              status.classList.remove('text-stone-500');
              status.classList.add('text-red-700');
            }
            return;
          }
          if (typeof payload.redirectTo === 'string' && payload.redirectTo) {
            window.location.href = payload.redirectTo;
            return;
          }
          if (redirect) {
            window.location.href = redirect === 'reload' ? window.location.href : redirect;
            return;
          }
          window.dispatchEvent(new CustomEvent('portal:mutation-success', { detail: { action, method } }));
          if (status) {
            status.textContent =
              typeof payload.message === 'string' && payload.message
                ? payload.message
                : form.dataset.successMessage || 'Saved.';
            status.classList.remove('text-red-700');
            status.classList.add('text-stone-500');
          }
          if (form.hasAttribute('data-reset-on-success')) form.reset();
        } catch (error) {
          if (status) {
            status.textContent = error instanceof Error ? error.message : 'Network error. Please try again.';
            status.classList.remove('text-stone-500');
            status.classList.add('text-red-700');
          }
        } finally {
          submitButtons.forEach((button) => {
            if (button instanceof HTMLButtonElement) button.disabled = false;
          });
        }
      });

      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const logout = target.closest('[data-logout]');
        if (!logout) return;
        try {
          await fetch('/api/auth/logout', { method: 'POST', headers: { accept: 'application/json' } });
        } finally {
          window.location.href = '/login';
        }
      });
    </script>
  </body>
</html>

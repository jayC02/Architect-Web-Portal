---
import '@/styles/global.css';
import { siteConfig } from '@/lib/config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = siteConfig.name,
  description = siteConfig.defaultDescription,
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      const clearFieldErrors = (form: HTMLFormElement, fieldName?: string) => {
        form.querySelectorAll<HTMLElement>('[data-field-error]').forEach((element) => {
          if (fieldName && element.dataset.fieldError !== fieldName) return;
          element.textContent = '';
          element.classList.add('hidden');
        });
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[aria-invalid="true"]').forEach((field) => {
          if (fieldName && field.name !== fieldName) return;
          field.removeAttribute('aria-invalid');
          field.style.borderColor = '';
          field.style.boxShadow = '';
        });
      };

      const showFieldErrors = (form: HTMLFormElement, payload: any) => {
        const fieldErrors = payload?.details?.fieldErrors ?? payload?.details;
        if (!fieldErrors || typeof fieldErrors !== 'object') return null;
        let firstError: { field: string; message: string } | null = null;
        for (const [field, messages] of Object.entries(fieldErrors)) {
          const element = Array.from(form.querySelectorAll<HTMLElement>('[data-field-error]'))
            .find((candidate) => candidate.dataset.fieldError === field);
          const message = Array.isArray(messages) ? messages[0] : undefined;
          const control = Array.from(form.elements).find(
            (candidate): candidate is HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement =>
              (candidate instanceof HTMLInputElement
                || candidate instanceof HTMLTextAreaElement
                || candidate instanceof HTMLSelectElement)
              && candidate.name === field
              && candidate.type !== 'hidden',
          );
          if (element && typeof message === 'string') {
            element.textContent = message;
            element.classList.remove('hidden');
          }
          if (control && typeof message === 'string') {
            control.setAttribute('aria-invalid', 'true');
            control.style.borderColor = '#b91c1c';
            control.style.boxShadow = '0 0 0 2px rgba(185, 28, 28, 0.12)';
          }
          if (!firstError && typeof message === 'string') firstError = { field, message };
        }
        return firstError;
      };

      document.addEventListener('input', (event) => {
        const field = event.target;
        if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)) return;
        const form = field.closest('form[data-field-errors]');
        if (form instanceof HTMLFormElement && field.name) clearFieldErrors(form, field.name);
      });

      document.addEventListener('submit', async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-api-form')) return;
        event.preventDefault();
        const confirmMessage = form.dataset.confirm;
        if (confirmMessage && !window.confirm(confirmMessage)) return;
        const method = form.dataset.method || form.method || 'POST';
        const action = form.dataset.action || form.action;
        const redirect = form.dataset.redirect;
        const status = form.querySelector('[data-form-status]');
        const submitButtons = Array.from(form.querySelectorAll('button[type="submit"], button:not([type])'));
        if (form.hasAttribute('data-field-errors')) clearFieldErrors(form);
        if (status) {
          status.textContent = form.dataset.pendingMessage || 'Saving...';
          status.setAttribute('role', 'status');
          status.classList.remove('text-red-700');
          status.classList.add('text-stone-500');
        }
        submitButtons.forEach((button) => {
          if (button instanceof HTMLButtonElement) button.disabled = true;
        });

        try {
          const formData = new FormData(form);
          const values: Record<string, FormDataEntryValue | FormDataEntryValue[]> = {};
          for (const [key, value] of formData.entries()) {
            if (key in values) {
              const existing = values[key];
              values[key] = Array.isArray(existing) ? [...existing, value] : [existing, value];
            } else {
              values[key] = value;
            }
          }
          const body = form.enctype === 'multipart/form-data' ? formData : JSON.stringify(values);

          const headers = form.enctype === 'multipart/form-data' ? undefined : { 'accept': 'application/json', 'content-type': 'application/json' };
          const response = await fetch(action, { method, headers, body });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            const fieldError = form.hasAttribute('data-field-errors') ? showFieldErrors(form, payload) : null;
            if (status) {
              const fieldLabel = fieldError?.field
                .replace(/([a-z])([A-Z])/g, '$1 $2')
                .replace(/^./, (letter: string) => letter.toUpperCase());
              status.textContent = fieldError
                ? `${fieldLabel}: ${fieldError.message}`
                : payload.error || 'Request failed.';
              status.classList.remove('text-stone-500');
              status.classList.add('text-red-700');
            }
            const invalidField = form.querySelector<HTMLElement>('[aria-invalid="true"]');
            invalidField?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            invalidField?.focus({ preventScroll: true });
            return;
          }
          if (typeof payload.redirectTo === 'string' && payload.redirectTo) {
            window.location.href = payload.redirectTo;
            return;
          }
          if (redirect) {
            window.location.href = redirect === 'reload' ? window.location.href : redirect;
            return;
          }
          window.dispatchEvent(new CustomEvent('portal:mutation-success', { detail: { action, method } }));
          if (status) {
            status.textContent =
              typeof payload.message === 'string' && payload.message
                ? payload.message
                : form.dataset.successMessage || 'Saved.';
            status.classList.remove('text-red-700');
            status.classList.add('text-stone-500');
          }
          if (form.hasAttribute('data-reset-on-success')) form.reset();
        } catch (error) {
          if (status) {
            status.textContent = error instanceof Error ? error.message : 'Network error. Please try again.';
            status.classList.remove('text-stone-500');
            status.classList.add('text-red-700');
          }
        } finally {
          submitButtons.forEach((button) => {
            if (button instanceof HTMLButtonElement) button.disabled = false;
          });
        }
      });

      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const logout = target.closest('[data-logout]');
        if (!logout) return;
        try {
          await fetch('/api/auth/logout', { method: 'POST', headers: { accept: 'application/json' } });
        } finally {
          window.location.href = '/login';
        }
      });
    </script>
  </body>
</html>

---
import AppShell from '@/components/layout/AppShell.astro';
import LiveDataPanel from '@/components/live/LiveDataPanel';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

---
<AppShell title="Clients" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <h1 class="text-3xl font-semibold">Clients</h1>
    <p class="mt-1 text-sm text-stone-500">Client profiles linked into project records.</p>
  </div>
  <section class="grid gap-6 xl:grid-cols-[420px_1fr]">
    <form data-api-form data-action="/api/clients" data-method="POST" class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Add client</h2>
      <div class="mt-4 space-y-4">
        <label class="block"><span class="label">Name</span><input required name="name" class="field" /></label>
        <label class="block"><span class="label">Email</span><input type="email" name="email" class="field" /></label>
        <label class="block"><span class="label">Phone</span><input name="phone" class="field" /></label>
        <label class="block"><span class="label">Address</span><textarea name="address" rows="3" class="field"></textarea></label>
        <label class="block"><span class="label">Notes</span><textarea name="notes" rows="3" class="field"></textarea></label>
      </div>
      <button class="btn btn-primary mt-4 w-full">Save client</button>
      <p data-form-status class="mt-3 text-sm text-stone-500"></p>
    </form>

    <LiveDataPanel client:load variant="clients" endpoint="/api/clients" />
  </section>
</AppShell>

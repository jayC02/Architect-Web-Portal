---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/u-value-report.css';
import UValueReport, { type ReportContext } from '@/components/tools/UValueReport';
import UValueReview from '@/components/tools/UValueReview';
import UValueTemplateSave from '@/components/tools/UValueTemplateSave';
import type { UValueInput, UValueResult } from '@/lib/u-value/calculator';
import { prisma } from '@/lib/db/prisma';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');
const calculation = await prisma.uValueCalculation.findFirst({ where: { id: Astro.params.id, organisationId: auth.organisation.id } });
if (!calculation) return new Response('Calculation not found.', { status: 404, headers: { 'Cache-Control': 'private, no-store' } });
const [latest, events] = await Promise.all([
  prisma.uValueCalculation.findFirst({ where: { organisationId: auth.organisation.id, OR: [{ seriesId: calculation.seriesId || calculation.id }, { id: calculation.seriesId || calculation.id }] }, orderBy: { revision: 'desc' }, select: { id: true } }),
  prisma.uValueReviewEvent.findMany({ where: { organisationId: auth.organisation.id, calculationId: calculation.id }, orderBy: { createdAt: 'asc' } }),
]);
---
<BaseLayout title={`${calculation.title} — U-value calculation`} noindex={true}>
  <div class="report-controls mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-6">
    <a class="btn btn-secondary" href="/tools/u-value">Back to calculator</a>{calculation.projectId && <a class="btn btn-secondary" href={`/tools/u-value/projects/${calculation.projectId}`}>Project schedule</a>}{calculation.previousId && <a class="btn btn-secondary" href={`/tools/u-value/reports/${calculation.previousId}`}>Previous revision</a>}
    <div class="flex flex-wrap gap-3"><a class="btn btn-secondary" href={`/tools/u-value?calculationId=${calculation.id}`}>Use as a new calculation</a>{latest?.id === calculation.id && <a class="btn btn-secondary" href={`/tools/u-value?calculationId=${calculation.id}&revision=1`}>Create revision</a>}<button id="print-report" type="button" class="btn btn-primary">Print / save PDF</button></div>
  </div>
  <UValueReview client:load id={calculation.id} inputHash={calculation.inputHash} status={calculation.status} revision={calculation.revision} latestId={latest?.id || calculation.id} />
  <UValueTemplateSave client:load id={calculation.id} title={calculation.title} />
  <UValueReport id={calculation.id} title={calculation.title} createdAt={calculation.createdAt.toISOString()} inputHash={calculation.inputHash} input={calculation.inputSnapshot as UValueInput} result={calculation.resultSnapshot as UValueResult} context={calculation.contextSnapshot as ReportContext} status={calculation.status} revision={calculation.revision} superseded={latest?.id !== calculation.id} events={events.map(event => ({ ...event, createdAt: event.createdAt.toISOString() }))} />
</BaseLayout>
<script>document.getElementById('print-report')?.addEventListener('click', () => window.print());</script>

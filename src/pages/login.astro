---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { publicPageShort, setAstroCache } from '@/lib/server/cache-control';

export const prerender = true;

setAstroCache(Astro, publicPageShort);
---
<BaseLayout title="Sign in | Architect Web Portal">
  <main class="grid min-h-screen place-items-center bg-paper px-4 py-12">
    <form data-api-form data-action="/api/auth/login" data-method="POST" data-redirect="/dashboard" method="post" action="/api/auth/login" class="panel mx-auto w-full max-w-md rounded-lg p-6">
      <div class="mb-6 flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-md bg-ink text-paper" aria-hidden="true">AP</div>
        <div>
          <h1 class="text-2xl font-semibold text-ink">Sign in</h1>
          <p class="text-sm text-stone-500">Open your project dashboard.</p>
        </div>
      </div>
      <div class="space-y-4">
        <label class="block"><span class="label">Email</span><input required type="email" name="email" class="field" autocomplete="email" /></label>
        <label class="block"><span class="label">Password</span><input required type="password" name="password" class="field" autocomplete="current-password" /></label>
      </div>
      <button class="btn btn-primary mt-6 w-full">Sign in</button>
      <p data-form-status class="mt-4 text-center text-sm text-stone-500"></p>
      <p class="mt-4 text-center text-sm text-stone-500">Need a workspace? <a class="font-semibold text-ink" href="/register">Register</a></p>
    </form>
  </main>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AuthEntryScreen from '@/components/auth/AuthEntryScreen.astro';
import { getSessionUser } from '@/lib/auth/session';
import { privateNoStore, setAstroCache } from '@/lib/server/cache-control';

export const prerender = false;

setAstroCache(Astro, privateNoStore);

if (await getSessionUser(Astro)) {
  return Astro.redirect('/dashboard');
}

const message =
  Astro.url.searchParams.get('reset') === 'success'
    ? 'Your password has been updated. Sign in with your new password.'
    : null;
const authError = Astro.url.searchParams.has('authError')
  ? 'Google sign-in could not be completed. Please try again.'
  : null;
---
<BaseLayout title="Sign in | Architect Pro" noindex>
  <AuthEntryScreen {message} {authError} />
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hashOpaqueToken } from '@/lib/auth/tokens';
import { prisma } from '@/lib/db/prisma';
import { privateNoStore, setAstroCache } from '@/lib/server/cache-control';

export const prerender = false;
setAstroCache(Astro, privateNoStore);

const token = Astro.url.searchParams.get('token') || '';
const resetToken = token
  ? await prisma.passwordResetToken.findUnique({
      where: { tokenHash: hashOpaqueToken(token) },
      select: { expiresAt: true, usedAt: true },
    })
  : null;
const valid = Boolean(resetToken && !resetToken.usedAt && resetToken.expiresAt.getTime() >= Date.now());
---
<BaseLayout title="Choose a new password | Architect Web Portal" noindex>
  <main class="grid min-h-screen place-items-center bg-paper px-4 py-12">
    <section class="panel mx-auto w-full max-w-md rounded-lg p-6">
      {valid ? (
        <form data-api-form data-action="/api/auth/reset-password" data-method="POST" method="post" action="/api/auth/reset-password">
          <div class="mb-6">
            <p class="mb-2 text-xs font-semibold uppercase text-stone-500">Account recovery</p>
            <h1 class="text-2xl font-semibold text-ink">Choose a new password</h1>
            <p class="mt-2 text-sm leading-6 text-stone-500">Use at least eight characters. Existing sign-in sessions will be closed for security.</p>
          </div>
          <input type="hidden" name="token" value={token} />
          <div class="space-y-4">
            <label class="block"><span class="label">New password</span><input required type="password" name="password" minlength="8" maxlength="128" class="field" autocomplete="new-password" /></label>
            <label class="block"><span class="label">Confirm password</span><input required type="password" name="confirmPassword" minlength="8" maxlength="128" class="field" autocomplete="new-password" /></label>
          </div>
          <button class="btn btn-primary mt-6 w-full">Update password</button>
          <p data-form-status class="mt-4 text-center text-sm text-stone-500"></p>
        </form>
      ) : (
        <div>
          <p class="mb-2 text-xs font-semibold uppercase text-stone-500">Account recovery</p>
          <h1 class="text-2xl font-semibold text-ink">This link is no longer valid</h1>
          <p class="mt-3 text-sm leading-6 text-stone-500">Password reset links expire after 45 minutes and can only be used once.</p>
          <a class="btn btn-primary mt-6 w-full" href="/forgot-password">Request another link</a>
        </div>
      )}
    </section>
  </main>
</BaseLayout>

---
import { DocumentStatus } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import LiveDataPanel from '@/components/live/LiveDataPanel';
import { prisma } from '@/lib/db/prisma';
import { documentTypeLabel, preferredDocumentTypes } from '@/lib/document-categories';
import { humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const project = await prisma.project.findFirst({
  where: { id: Astro.params.id, organisationId: auth.organisation.id },
  select: { id: true, name: true },
});
if (!project) return Astro.redirect('/projects');
---
<AppShell title={`${project.name} files`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={`/projects/${project.id}`} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to project</a>
    <h1 class="mt-2 text-3xl font-semibold">Files</h1>
    <p class="mt-1 text-sm text-stone-500">{project.name}</p>
  </div>

  <section class="panel mb-6 rounded-lg border-l-4 border-l-moss p-5">
    <div class="grid gap-5 lg:grid-cols-[1fr_360px]">
      <div>
        <h2 class="text-xl font-semibold">Auto-sort project files</h2>
        <p class="mt-1 text-sm text-stone-500">Drop a batch of drawings, plans, reports and photos. The system will suggest classifications first, then you can review every file before accepting.</p>
        <form data-api-form data-action={`/api/projects/${project.id}/document-sort-batches`} data-method="POST" enctype="multipart/form-data" class="mt-4">
          <label class="block rounded-lg border border-dashed border-stone-300 bg-stone-50 p-5">
            <span class="label">Project documents</span>
            <input required multiple type="file" name="files" class="mt-3 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-ink file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-700" />
          </label>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button class="btn btn-primary">Upload and review sorting</button>
            <p data-form-status class="text-sm text-stone-500"></p>
          </div>
        </form>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-4">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-stone-500">Review workflow</h3>
        <p class="mt-3 text-sm text-stone-500">Uploaded batches and package data load below while the upload controls stay ready.</p>
      </div>
    </div>
  </section>

  <section class="space-y-6">
    <form data-api-form data-action={`/api/projects/${project.id}/documents`} data-method="POST" enctype="multipart/form-data" class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Manual upload</h2>
      <p class="mt-1 text-sm text-stone-500">Use this when you already know the classification or need to add one file.</p>
      <div class="mt-4 space-y-4">
        <label class="block">
          <span class="label">File</span>
          <input required type="file" name="file" class="field" />
        </label>
        <label class="block">
          <span class="label">Document type</span>
          <select name="type" class="field">
            {preferredDocumentTypes.map((type) => <option value={type}>{documentTypeLabel(type)}</option>)}
          </select>
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="label">Revision</span>
            <input name="revision" class="field" placeholder="P01, A, Rev 2" />
          </label>
          <label class="block">
            <span class="label">Status</span>
            <select name="status" class="field">
              {Object.values(DocumentStatus).map((status) => <option value={status}>{humanizeEnum(status)}</option>)}
            </select>
          </label>
        </div>
        <label class="block">
          <span class="label">Notes</span>
          <textarea name="notes" rows="3" class="field"></textarea>
        </label>
      </div>
      <button class="btn btn-primary mt-4 w-full">Upload</button>
      <p data-form-status class="mt-3 text-sm text-stone-500"></p>
    </form>

    <LiveDataPanel client:load variant="projectFiles" endpoint={`/api/projects/${project.id}/files/summary`} />
  </section>
</AppShell>

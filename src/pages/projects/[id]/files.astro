---
import { DocumentStatus, SubmissionPackageStatus, SubmissionPackageType } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { documentGroupType, documentTypeLabel, preferredDocumentTypes } from '@/lib/document-categories';
import { formatBytes, formatDate, humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const project = await prisma.project.findFirst({
  where: { id: Astro.params.id, organisationId: auth.organisation.id },
  include: {
    documents: { include: { uploadedBy: { select: { name: true } } }, orderBy: { createdAt: 'desc' } },
    documentSortBatches: { orderBy: { createdAt: 'desc' }, take: 5 },
    submissionPackages: { include: { documents: { include: { document: true } } }, orderBy: { updatedAt: 'desc' } },
  },
});
if (!project) return Astro.redirect('/projects');
---
<AppShell title={`${project.name} files`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={`/projects/${project.id}`} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to project</a>
    <h1 class="mt-2 text-3xl font-semibold">Files</h1>
    <p class="mt-1 text-sm text-stone-500">{project.name}</p>
  </div>

  <section class="panel mb-6 rounded-lg border-l-4 border-l-moss p-5">
    <div class="grid gap-5 lg:grid-cols-[1fr_360px]">
      <div>
        <h2 class="text-xl font-semibold">Auto-sort project files</h2>
        <p class="mt-1 text-sm text-stone-500">Drop a batch of drawings, plans, reports and photos. The system will suggest classifications first, then you can review every file before accepting.</p>
        <form data-api-form data-action={`/api/projects/${project.id}/document-sort-batches`} data-method="POST" enctype="multipart/form-data" class="mt-4">
          <label class="block rounded-lg border border-dashed border-stone-300 bg-stone-50 p-5">
            <span class="label">Project documents</span>
            <input required multiple type="file" name="files" class="mt-3 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-ink file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-700" />
          </label>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button class="btn btn-primary">Upload and review sorting</button>
            <p data-form-status class="text-sm text-stone-500"></p>
          </div>
        </form>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-4">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-stone-500">Recent sorting batches</h3>
        <div class="mt-3 space-y-2">
          {project.documentSortBatches.length ? project.documentSortBatches.map((batch) => (
            <a href={`/projects/${project.id}/files/sort/${batch.id}`} class="block rounded-md border border-stone-200 p-3 hover:border-moss">
              <span class="font-semibold">{batch.fileCount} files</span>
              <span class="ml-2 text-sm text-stone-500">{humanizeEnum(batch.status)}</span>
              <p class="mt-1 text-xs text-stone-500">{formatDate(batch.createdAt)}</p>
            </a>
          )) : <p class="text-sm text-stone-500">No auto-sort batches yet.</p>}
        </div>
      </div>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-[420px_1fr]">
    <form data-api-form data-action={`/api/projects/${project.id}/documents`} data-method="POST" data-redirect="reload" enctype="multipart/form-data" class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Manual upload</h2>
      <p class="mt-1 text-sm text-stone-500">Use this when you already know the classification or need to add one file.</p>
      <div class="mt-4 space-y-4">
        <label class="block">
          <span class="label">File</span>
          <input required type="file" name="file" class="field" />
        </label>
        <label class="block">
          <span class="label">Document type</span>
          <select name="type" class="field">
            {preferredDocumentTypes.map((type) => <option value={type}>{documentTypeLabel(type)}</option>)}
          </select>
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="label">Revision</span>
            <input name="revision" class="field" placeholder="P01, A, Rev 2" />
          </label>
          <label class="block">
            <span class="label">Status</span>
            <select name="status" class="field">
              {Object.values(DocumentStatus).map((status) => <option value={status}>{humanizeEnum(status)}</option>)}
            </select>
          </label>
        </div>
        <label class="block">
          <span class="label">Notes</span>
          <textarea name="notes" rows="3" class="field"></textarea>
        </label>
      </div>
      <button class="btn btn-primary mt-4 w-full">Upload</button>
      <p data-form-status class="mt-3 text-sm text-stone-500"></p>
    </form>

    <div class="panel overflow-hidden rounded-lg">
      <table class="w-full min-w-[760px] border-collapse">
        <thead class="table-head">
          <tr>
            <th class="px-4 py-3">Document</th>
            <th class="px-4 py-3">Type</th>
            <th class="px-4 py-3">Revision</th>
            <th class="px-4 py-3">Uploaded</th>
            <th class="px-4 py-3">Size</th>
          </tr>
        </thead>
        <tbody>
          {project.documents.map((document) => (
            <tr>
              <td class="table-cell">
                <a class="font-semibold hover:underline" href={document.storageUrl} target="_blank" rel="noreferrer">{document.originalName}</a>
                <p class="text-xs text-stone-500">{document.uploadedBy.name}</p>
                {document.drawingNumber && <p class="mt-1 text-xs text-stone-500">Drawing {document.drawingNumber}</p>}
                {document.drawingTitle && <p class="text-xs text-stone-500">{document.drawingTitle}</p>}
              </td>
              <td class="table-cell">
                {documentTypeLabel(documentGroupType(document.type))}
                {document.sortConfidence !== null && document.sortConfidence !== undefined && (
                  <p class="mt-1 text-xs text-stone-500">Auto-sort {Math.round(document.sortConfidence * 100)}%</p>
                )}
              </td>
              <td class="table-cell">{document.revision ?? 'None'}</td>
              <td class="table-cell">{formatDate(document.createdAt)}</td>
              <td class="table-cell">{formatBytes(document.sizeBytes)}</td>
            </tr>
            <tr>
              <td colspan="5" class="border-b border-stone-100 bg-stone-50 px-4 py-3">
                <details>
                  <summary class="cursor-pointer text-sm font-semibold">Edit classification</summary>
                  <form data-api-form data-action={`/api/documents/${document.id}`} data-method="PATCH" class="mt-3 grid gap-3 md:grid-cols-4">
                    <label class="block"><span class="label">Document type</span><select name="type" class="field">{preferredDocumentTypes.map((type) => <option value={type} selected={type === documentGroupType(document.type)}>{documentTypeLabel(type)}</option>)}</select></label>
                    <label class="block"><span class="label">Revision</span><input name="revision" value={document.revision ?? ''} class="field" /></label>
                    <label class="block"><span class="label">Status</span><select name="status" class="field">{Object.values(DocumentStatus).map((status) => <option value={status} selected={status === document.status}>{humanizeEnum(status)}</option>)}</select></label>
                    <label class="block"><span class="label">Notes</span><input name="notes" value={document.notes ?? ''} class="field" /></label>
                    <div class="flex items-center gap-3 md:col-span-4">
                      <button class="btn btn-primary">Save classification</button>
                      <span data-form-status class="text-sm text-stone-500"></span>
                    </div>
                  </form>
                </details>
              </td>
            </tr>
          ))}
          {!project.documents.length && <tr><td colspan="5" class="px-4 py-10 text-center text-sm text-stone-500">No documents uploaded yet.</td></tr>}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[420px_1fr]">
    <form data-api-form data-action="/api/submission-packages" data-method="POST" data-redirect="reload" class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Submission package</h2>
      <input type="hidden" name="projectId" value={project.id} />
      <div class="mt-4 space-y-4">
        <label class="block">
          <span class="label">Package name</span>
          <input required name="name" class="field" />
        </label>
        <label class="block">
          <span class="label">Type</span>
          <select name="type" class="field">
            {Object.values(SubmissionPackageType).map((type) => <option value={type}>{humanizeEnum(type)}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="label">Status</span>
          <select name="status" class="field">
            {Object.values(SubmissionPackageStatus).map((status) => <option value={status}>{humanizeEnum(status)}</option>)}
          </select>
        </label>
        <div>
          <span class="label">Documents</span>
          <div class="max-h-48 space-y-2 overflow-auto rounded-md border border-stone-200 p-2">
            {project.documents.map((document) => (
              <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="documentIds" value={document.id} />
                <span class="truncate">{document.originalName}</span>
              </label>
            ))}
            {!project.documents.length && <p class="text-sm text-stone-500">Upload documents before creating a package.</p>}
          </div>
        </div>
      </div>
      <button class="btn btn-primary mt-4 w-full">Create package</button>
      <p data-form-status class="mt-3 text-sm text-stone-500"></p>
    </form>

    <div class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Packages</h2>
      <div class="mt-4 space-y-3">
        {project.submissionPackages.length ? project.submissionPackages.map((pkg) => (
          <div class="rounded-md border border-stone-200 p-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-semibold">{pkg.name}</p>
                <p class="text-sm text-stone-500">{humanizeEnum(pkg.type)} - {pkg.documents.length} documents</p>
              </div>
              <span class="status-chip bg-moss/10 text-moss">{humanizeEnum(pkg.status)}</span>
            </div>
          </div>
        )) : <p class="text-sm text-stone-500">No submission packages created yet.</p>}
      </div>
    </div>
  </section>
</AppShell>

---
import { DocumentStatus, DocumentType, SubmissionPackageStatus, SubmissionPackageType } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { formatBytes, formatDate, humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const project = await prisma.project.findFirst({
  where: { id: Astro.params.id, organisationId: auth.organisation.id },
  include: {
    documents: { include: { uploadedBy: { select: { name: true } } }, orderBy: { createdAt: 'desc' } },
    submissionPackages: { include: { documents: { include: { document: true } } }, orderBy: { updatedAt: 'desc' } },
  },
});
if (!project) return Astro.redirect('/projects');
---
<AppShell title={`${project.name} files`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={`/projects/${project.id}`} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to project</a>
    <h1 class="mt-2 text-3xl font-semibold">Files</h1>
    <p class="mt-1 text-sm text-stone-500">{project.name}</p>
  </div>

  <section class="grid gap-6 xl:grid-cols-[420px_1fr]">
    <form data-api-form data-action={`/api/projects/${project.id}/documents`} data-method="POST" data-redirect="reload" enctype="multipart/form-data" class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Upload document</h2>
      <div class="mt-4 space-y-4">
        <label class="block">
          <span class="label">File</span>
          <input required type="file" name="file" class="field" />
        </label>
        <label class="block">
          <span class="label">Document type</span>
          <select name="type" class="field">
            {Object.values(DocumentType).map((type) => <option value={type}>{humanizeEnum(type)}</option>)}
          </select>
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="label">Revision</span>
            <input name="revision" class="field" placeholder="P01, A, Rev 2" />
          </label>
          <label class="block">
            <span class="label">Status</span>
            <select name="status" class="field">
              {Object.values(DocumentStatus).map((status) => <option value={status}>{humanizeEnum(status)}</option>)}
            </select>
          </label>
        </div>
        <label class="block">
          <span class="label">Notes</span>
          <textarea name="notes" rows="3" class="field"></textarea>
        </label>
      </div>
      <button class="btn btn-primary mt-4 w-full">Upload</button>
      <p data-form-status class="mt-3 text-sm text-stone-500"></p>
    </form>

    <div class="panel overflow-hidden rounded-lg">
      <table class="w-full min-w-[760px] border-collapse">
        <thead class="table-head">
          <tr>
            <th class="px-4 py-3">Document</th>
            <th class="px-4 py-3">Type</th>
            <th class="px-4 py-3">Revision</th>
            <th class="px-4 py-3">Uploaded</th>
            <th class="px-4 py-3">Size</th>
          </tr>
        </thead>
        <tbody>
          {project.documents.map((document) => (
            <tr>
              <td class="table-cell">
                <a class="font-semibold hover:underline" href={document.storageUrl} target="_blank" rel="noreferrer">{document.originalName}</a>
                <p class="text-xs text-stone-500">{document.uploadedBy.name}</p>
              </td>
              <td class="table-cell">{humanizeEnum(document.type)}</td>
              <td class="table-cell">{document.revision ?? 'None'}</td>
              <td class="table-cell">{formatDate(document.createdAt)}</td>
              <td class="table-cell">{formatBytes(document.sizeBytes)}</td>
            </tr>
          ))}
          {!project.documents.length && <tr><td colspan="5" class="px-4 py-10 text-center text-sm text-stone-500">No documents uploaded yet.</td></tr>}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[420px_1fr]">
    <form data-api-form data-action="/api/submission-packages" data-method="POST" data-redirect="reload" class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Submission package</h2>
      <input type="hidden" name="projectId" value={project.id} />
      <div class="mt-4 space-y-4">
        <label class="block">
          <span class="label">Package name</span>
          <input required name="name" class="field" />
        </label>
        <label class="block">
          <span class="label">Type</span>
          <select name="type" class="field">
            {Object.values(SubmissionPackageType).map((type) => <option value={type}>{humanizeEnum(type)}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="label">Status</span>
          <select name="status" class="field">
            {Object.values(SubmissionPackageStatus).map((status) => <option value={status}>{humanizeEnum(status)}</option>)}
          </select>
        </label>
        <div>
          <span class="label">Documents</span>
          <div class="max-h-48 space-y-2 overflow-auto rounded-md border border-stone-200 p-2">
            {project.documents.map((document) => (
              <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="documentIds" value={document.id} />
                <span class="truncate">{document.originalName}</span>
              </label>
            ))}
            {!project.documents.length && <p class="text-sm text-stone-500">Upload documents before creating a package.</p>}
          </div>
        </div>
      </div>
      <button class="btn btn-primary mt-4 w-full">Create package</button>
      <p data-form-status class="mt-3 text-sm text-stone-500"></p>
    </form>

    <div class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Packages</h2>
      <div class="mt-4 space-y-3">
        {project.submissionPackages.length ? project.submissionPackages.map((pkg) => (
          <div class="rounded-md border border-stone-200 p-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-semibold">{pkg.name}</p>
                <p class="text-sm text-stone-500">{humanizeEnum(pkg.type)} · {pkg.documents.length} documents</p>
              </div>
              <span class="status-chip bg-moss/10 text-moss">{humanizeEnum(pkg.status)}</span>
            </div>
          </div>
        )) : <p class="text-sm text-stone-500">No submission packages created yet.</p>}
      </div>
    </div>
  </section>
</AppShell>

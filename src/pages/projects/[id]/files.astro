---
import { DocumentStatus } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { documentTypeLabel, preferredDocumentTypes } from '@/lib/document-categories';
import { formatBytes, formatDate, humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const project = await prisma.project.findFirst({
  where: { id: Astro.params.id, organisationId: auth.organisation.id },
  select: {
    id: true,
    name: true,
    documents: {
      orderBy: [{ type: 'asc' }, { createdAt: 'desc' }],
      select: {
        id: true,
        originalName: true,
        type: true,
        revision: true,
        status: true,
        notes: true,
        createdAt: true,
        sizeBytes: true,
      },
    },
  },
});
if (!project) return Astro.redirect('/projects');

const documentGroups = preferredDocumentTypes
  .map((type) => ({
    type,
    label: documentTypeLabel(type),
    documents: project.documents.filter((document) => document.type === type),
  }))
  .filter((group) => group.documents.length > 0);
---
<AppShell title={`${project.name} files`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={`/projects/${project.id}`} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to project</a>
    <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-semibold">Project files</h1>
        <p class="mt-1 text-sm text-stone-500">{project.name} · {project.documents.length} file{project.documents.length === 1 ? '' : 's'}</p>
      </div>
      <a class="btn btn-primary" href={`/documents/upload?projectId=${project.id}`}>Upload documents</a>
    </div>
  </div>

  {project.documents.length ? (
    <section class="space-y-4">
      {documentGroups.map((group) => (
        <article class="panel overflow-hidden rounded-lg">
          <div class="flex items-center justify-between gap-3 border-b border-stone-100 px-4 py-3">
            <h2 class="font-semibold">{group.label}</h2>
            <span class="rounded-md bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-600">{group.documents.length} file{group.documents.length === 1 ? '' : 's'}</span>
          </div>
          <div class="divide-y divide-stone-100">
            {group.documents.map((document) => (
              <div class="px-4 py-3">
                <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                  <div class="min-w-0">
                    <a href={`/api/documents/${document.id}`} target="_blank" rel="noreferrer" class="block truncate font-semibold hover:underline">{document.originalName}</a>
                    <p class="mt-1 text-xs text-stone-500">{document.revision ? `Rev ${document.revision}` : 'No revision'} · {humanizeEnum(document.status)} · {formatDate(document.createdAt)} · {formatBytes(document.sizeBytes)}</p>
                  </div>
                  <form data-api-form data-action={`/api/documents/${document.id}`} data-method="DELETE" data-redirect="reload" data-confirm={`Remove ${document.originalName} from this project?`}>
                    <button class="btn border border-red-200 bg-red-50 text-red-700 hover:bg-red-100">Remove</button>
                  </form>
                </div>
                <details class="mt-3 rounded-md border border-stone-200 bg-stone-50/50 p-3">
                  <summary class="cursor-pointer text-sm font-semibold text-stone-700">Edit file details</summary>
                  <form data-api-form data-action={`/api/documents/${document.id}`} data-method="PATCH" data-redirect="reload" class="mt-3 grid gap-3 md:grid-cols-4">
                    <label class="block">
                      <span class="label">Document type</span>
                      <select name="type" class="field">
                        {preferredDocumentTypes.map((type) => <option value={type} selected={type === document.type}>{documentTypeLabel(type)}</option>)}
                      </select>
                    </label>
                    <label class="block">
                      <span class="label">Revision</span>
                      <input name="revision" value={document.revision ?? ''} class="field" />
                    </label>
                    <label class="block">
                      <span class="label">Status</span>
                      <select name="status" class="field">
                        {Object.values(DocumentStatus).map((status) => <option value={status} selected={status === document.status}>{humanizeEnum(status)}</option>)}
                      </select>
                    </label>
                    <label class="block">
                      <span class="label">Notes</span>
                      <input name="notes" value={document.notes ?? ''} class="field" />
                    </label>
                    <div class="flex flex-wrap items-center gap-3 md:col-span-4">
                      <button class="btn btn-primary">Save changes</button>
                      <span data-form-status class="text-sm text-stone-500"></span>
                    </div>
                  </form>
                </details>
              </div>
            ))}
          </div>
        </article>
      ))}
    </section>
  ) : (
    <section class="panel rounded-lg border border-dashed border-stone-300 p-8 text-center">
      <h2 class="text-xl font-semibold">No project files yet</h2>
      <p class="mt-2 text-sm text-stone-500">Upload documents and review the suggested sorting before they appear here.</p>
      <a class="btn btn-primary mt-4" href={`/documents/upload?projectId=${project.id}`}>Upload documents</a>
    </section>
  )}
</AppShell>
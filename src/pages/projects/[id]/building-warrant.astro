---
import { CompletionCertificateStatus, WarrantStatus, WarrantType } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { formatDate, humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const project = await prisma.project.findFirst({
  where: { id: Astro.params.id, organisationId: auth.organisation.id },
  include: { warrantApplications: { orderBy: { updatedAt: 'desc' } } },
});
if (!project) return Astro.redirect('/projects');
---
<AppShell title={`${project.name} building warrant`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={`/projects/${project.id}`} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to project</a>
    <h1 class="mt-2 text-3xl font-semibold">Building warrant applications</h1>
    <p class="mt-1 text-sm text-stone-500">{project.name}</p>
  </div>

  <section class="grid gap-6 xl:grid-cols-[420px_1fr]">
    <form data-api-form data-action={`/api/projects/${project.id}/building-warrant`} data-method="POST" data-redirect="reload" class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Add warrant record</h2>
      <div class="mt-4 space-y-4">
        <label class="block"><span class="label">Warrant reference</span><input name="warrantReference" class="field" /></label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="label">Type</span><select name="warrantType" class="field">{Object.values(WarrantType).map((type) => <option value={type}>{humanizeEnum(type)}</option>)}</select></label>
          <label class="block"><span class="label">Status</span><select name="status" class="field">{Object.values(WarrantStatus).map((status) => <option value={status}>{humanizeEnum(status)}</option>)}</select></label>
        </div>
        <label class="block"><span class="label">Completion certificate</span><select name="completionCertificateStatus" class="field">{Object.values(CompletionCertificateStatus).map((status) => <option value={status}>{humanizeEnum(status)}</option>)}</select></label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="label">Submission date</span><input type="date" name="submissionDate" class="field" /></label>
          <label class="block"><span class="label">First response target</span><input type="date" name="firstResponseTargetDate" class="field" /></label>
          <label class="block"><span class="label">Granted date</span><input type="date" name="grantedDate" class="field" /></label>
          <label class="block"><span class="label">Expiry date</span><input type="date" name="expiryDate" class="field" /></label>
        </div>
        <label class="block"><span class="label">Portal URL</span><input type="url" name="portalUrl" class="field" /></label>
        <label class="block"><span class="label">Notes</span><textarea name="notes" rows="4" class="field"></textarea></label>
      </div>
      <button class="btn btn-primary mt-4 w-full">Save warrant record</button>
      <p data-form-status class="mt-3 text-sm text-stone-500"></p>
    </form>

    <div class="space-y-4">
      {project.warrantApplications.length ? project.warrantApplications.map((item) => (
        <article class="panel rounded-lg p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-lg font-semibold">{item.warrantReference ?? 'Building warrant application'}</p>
              <p class="mt-1 text-sm text-stone-500">{humanizeEnum(item.warrantType)} - first response {formatDate(item.firstResponseTargetDate)}</p>
            </div>
            <span class="status-chip bg-moss/10 text-moss">{humanizeEnum(item.status)}</span>
          </div>
          <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-4">
            <div><dt class="text-stone-500">Submitted</dt><dd>{formatDate(item.submissionDate)}</dd></div>
            <div><dt class="text-stone-500">Granted</dt><dd>{formatDate(item.grantedDate)}</dd></div>
            <div><dt class="text-stone-500">Expiry</dt><dd>{formatDate(item.expiryDate)}</dd></div>
            <div><dt class="text-stone-500">Portal</dt><dd>{item.portalUrl ? <a class="font-semibold underline" href={item.portalUrl} target="_blank" rel="noreferrer">Open</a> : 'Not set'}</dd></div>
          </dl>
          {item.notes && <p class="mt-4 rounded-md bg-stone-50 p-3 text-sm text-stone-600">{item.notes}</p>}
          <details class="mt-4 rounded-md border border-stone-200 p-3">
            <summary class="cursor-pointer text-sm font-semibold">Edit warrant record</summary>
            <form data-api-form data-action={`/api/building-warrant/${item.id}`} data-method="PATCH" class="mt-4 grid gap-4">
              <label class="block"><span class="label">Warrant reference</span><input name="warrantReference" value={item.warrantReference ?? ''} class="field" /></label>
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="block"><span class="label">Type</span><select name="warrantType" class="field">{Object.values(WarrantType).map((type) => <option value={type} selected={type === item.warrantType}>{humanizeEnum(type)}</option>)}</select></label>
                <label class="block"><span class="label">Status</span><select name="status" class="field">{Object.values(WarrantStatus).map((status) => <option value={status} selected={status === item.status}>{humanizeEnum(status)}</option>)}</select></label>
              </div>
              <label class="block"><span class="label">Completion certificate</span><select name="completionCertificateStatus" class="field">{Object.values(CompletionCertificateStatus).map((status) => <option value={status} selected={status === item.completionCertificateStatus}>{humanizeEnum(status)}</option>)}</select></label>
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="block"><span class="label">Submission date</span><input type="date" name="submissionDate" value={item.submissionDate?.toISOString().slice(0, 10) ?? ''} class="field" /></label>
                <label class="block"><span class="label">First response target</span><input type="date" name="firstResponseTargetDate" value={item.firstResponseTargetDate?.toISOString().slice(0, 10) ?? ''} class="field" /></label>
                <label class="block"><span class="label">Granted date</span><input type="date" name="grantedDate" value={item.grantedDate?.toISOString().slice(0, 10) ?? ''} class="field" /></label>
                <label class="block"><span class="label">Expiry date</span><input type="date" name="expiryDate" value={item.expiryDate?.toISOString().slice(0, 10) ?? ''} class="field" /></label>
              </div>
              <label class="block"><span class="label">Portal URL</span><input type="url" name="portalUrl" value={item.portalUrl ?? ''} class="field" /></label>
              <label class="block"><span class="label">Notes</span><textarea name="notes" rows="4" class="field">{item.notes ?? ''}</textarea></label>
              <div class="flex flex-wrap items-center gap-3">
                <button class="btn btn-primary">Save warrant record</button>
                <span data-form-status class="text-sm text-stone-500"></span>
              </div>
            </form>
            <form data-api-form data-action={`/api/building-warrant/${item.id}`} data-method="DELETE" data-redirect="reload" data-confirm="Delete this building warrant record?" class="mt-3">
              <button class="btn border border-red-200 bg-red-50 text-red-700 hover:bg-red-100">Delete warrant record</button>
              <span data-form-status class="ml-3 text-sm text-stone-500"></span>
            </form>
          </details>
        </article>
      )) : <div class="panel rounded-lg p-8 text-center text-sm text-stone-500">No building warrant applications yet.</div>}
    </div>
  </section>
</AppShell>

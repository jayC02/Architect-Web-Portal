---
import { CompletionCertificateStatus, WarrantStatus, WarrantType } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import LiveDataPanel from '@/components/live/LiveDataPanel';
import { prisma } from '@/lib/db/prisma';
import { humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const project = await prisma.project.findFirst({
  where: { id: Astro.params.id, organisationId: auth.organisation.id },
  select: { id: true, name: true },
});
if (!project) return Astro.redirect('/projects');
---
<AppShell title={`${project.name} building warrant`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={`/projects/${project.id}`} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to project</a>
    <h1 class="mt-2 text-3xl font-semibold">Building warrant applications</h1>
    <p class="mt-1 text-sm text-stone-500">{project.name}</p>
  </div>

  <section class="grid gap-6 xl:grid-cols-[420px_1fr]">
    <form data-api-form data-action={`/api/projects/${project.id}/building-warrant`} data-method="POST" class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Add warrant record</h2>
      <div class="mt-4 space-y-4">
        <label class="block"><span class="label">Warrant reference</span><input name="warrantReference" class="field" /></label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="label">Type</span><select name="warrantType" class="field">{Object.values(WarrantType).map((type) => <option value={type}>{humanizeEnum(type)}</option>)}</select></label>
          <label class="block"><span class="label">Status</span><select name="status" class="field">{Object.values(WarrantStatus).map((status) => <option value={status}>{humanizeEnum(status)}</option>)}</select></label>
        </div>
        <label class="block"><span class="label">Completion certificate</span><select name="completionCertificateStatus" class="field">{Object.values(CompletionCertificateStatus).map((status) => <option value={status}>{humanizeEnum(status)}</option>)}</select></label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="label">Submission date</span><input type="date" name="submissionDate" class="field" /></label>
          <label class="block"><span class="label">First response target</span><input type="date" name="firstResponseTargetDate" class="field" /></label>
          <label class="block"><span class="label">Granted date</span><input type="date" name="grantedDate" class="field" /></label>
          <label class="block"><span class="label">Expiry date</span><input type="date" name="expiryDate" class="field" /></label>
        </div>
        <label class="block"><span class="label">Portal URL</span><input type="url" name="portalUrl" class="field" /></label>
        <label class="block"><span class="label">Notes</span><textarea name="notes" rows="4" class="field"></textarea></label>
      </div>
      <button class="btn btn-primary mt-4 w-full">Save warrant record</button>
      <p data-form-status class="mt-3 text-sm text-stone-500"></p>
    </form>

    <LiveDataPanel client:load variant="warrants" endpoint={`/api/projects/${project.id}/building-warrant`} />
  </section>
</AppShell>

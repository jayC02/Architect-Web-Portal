---
import { Prisma } from '@prisma/client';
import { ArrowLeft } from 'lucide-react';
import AppShell from '@/components/layout/AppShell.astro';
import ProjectFees from '@/components/projects/ProjectFees.astro';
import { prisma } from '@/lib/db/prisma';
import { requirePageAuth } from '@/lib/server/page-auth';

// Fees live on their own page so the project overview stays focused on the work.
const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');
const project = await prisma.project.findFirst({
  where: { id: Astro.params.id, organisationId: auth.organisation.id },
  select: { id: true, name: true, clientId: true },
});
if (!project) return Astro.redirect('/projects');
if (!['OWNER', 'ADMIN'].includes(auth.membership.role)) return Astro.redirect(`/projects/${project.id}`);

const [projectFeePlan, feePlanTemplates] = await Promise.all([
  prisma.projectFeePlan.findFirst({
    where: { organisationId: auth.organisation.id, projectId: project.id, active: true },
    include: { milestones: { orderBy: { sortOrder: 'asc' } } },
  }),
  prisma.feePlanTemplate.findMany({
    where: { organisationId: auth.organisation.id, active: true },
    orderBy: [{ name: 'asc' }, { version: 'desc' }],
  }),
]);
const agreedFeeTotal = projectFeePlan?.milestones
  .filter((milestone) => milestone.enabled && milestone.state !== 'WAIVED')
  .reduce((total, milestone) => total.plus(milestone.amount), new Prisma.Decimal(0)) ?? null;
const projectFinance = await (async () => {
  const connection = await prisma.xeroConnection.findUnique({ where: { organisationId: auth.organisation.id } });
  if (!connection) return null;
  const clientLink = project.clientId ? await prisma.xeroClientLink.findUnique({ where: { clientId: project.clientId } }) : null;
  const [links, candidates] = await Promise.all([
    prisma.xeroProjectInvoiceLink.findMany({
      where: { organisationId: auth.organisation.id, projectId: project.id },
      include: { invoice: true },
      orderBy: { linkedAt: 'desc' },
    }),
    prisma.xeroInvoiceSnapshot.findMany({
      where: {
        organisationId: auth.organisation.id,
        invoiceType: 'ACCREC',
        ...(clientLink ? { xeroContactId: clientLink.xeroContactId } : {}),
        projectLinks: { none: {} },
      },
      orderBy: { invoiceDate: 'desc' },
      take: 100,
    }),
  ]);
  const totals = links.reduce((result, link) => {
    const currency = link.invoice.currency;
    const current = result.get(currency) ?? { invoiced: new Prisma.Decimal(0), paid: new Prisma.Decimal(0), outstanding: new Prisma.Decimal(0), overdue: new Prisma.Decimal(0) };
    if (['AUTHORISED', 'PAID'].includes(link.invoice.status)) {
      current.invoiced = current.invoiced.plus(link.invoice.total);
      current.paid = current.paid.plus(link.invoice.amountPaid);
      current.outstanding = current.outstanding.plus(link.invoice.amountDue);
      if (link.invoice.dueDate && link.invoice.dueDate < new Date() && link.invoice.amountDue.greaterThan(0)) current.overdue = current.overdue.plus(link.invoice.amountDue);
    }
    result.set(currency, current);
    return result;
  }, new Map<string, { invoiced: Prisma.Decimal; paid: Prisma.Decimal; outstanding: Prisma.Decimal; overdue: Prisma.Decimal }>());
  return { connection, links, candidates, clientLink, totals };
})();
---
<AppShell title={`Fees · ${project.name}`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <header class="mb-6">
    <a href={`/projects/${project.id}`} class="inline-flex items-center gap-1.5 text-sm font-medium text-stone-500 transition hover:text-ink"><ArrowLeft size={15} aria-hidden="true" />{project.name}</a>
    <h1 class="mt-3 text-3xl font-semibold leading-tight text-ink">Fees</h1>
    <p class="mt-1.5 text-sm text-stone-500">The agreed fee schedule for this project and its position in Xero.</p>
  </header>
  <ProjectFees
    projectId={project.id}
    projectFeePlan={projectFeePlan}
    feePlanTemplates={feePlanTemplates}
    projectFinance={projectFinance}
    agreedFeeTotal={agreedFeeTotal}
  />
</AppShell>

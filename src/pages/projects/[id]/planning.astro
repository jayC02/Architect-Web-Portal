---
import { PlanningStatus } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { formatDate, humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const project = await prisma.project.findFirst({
  where: { id: Astro.params.id, organisationId: auth.organisation.id },
  include: { planningApplications: { orderBy: { updatedAt: 'desc' } } },
});
if (!project) return Astro.redirect('/projects');
---
<AppShell title={`${project.name} planning`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={`/projects/${project.id}`} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to project</a>
    <h1 class="mt-2 text-3xl font-semibold">Planning applications</h1>
    <p class="mt-1 text-sm text-stone-500">{project.name}</p>
  </div>

  <section class="grid gap-6 xl:grid-cols-[420px_1fr]">
    <form data-api-form data-action={`/api/projects/${project.id}/planning`} data-method="POST" data-redirect="reload" class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Add planning record</h2>
      <div class="mt-4 space-y-4">
        <label class="block"><span class="label">Application reference</span><input name="applicationReference" class="field" /></label>
        <label class="block"><span class="label">Status</span><select name="status" class="field">{Object.values(PlanningStatus).map((status) => <option value={status}>{humanizeEnum(status)}</option>)}</select></label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="label">Submission date</span><input type="date" name="submissionDate" class="field" /></label>
          <label class="block"><span class="label">Valid date</span><input type="date" name="validDate" class="field" /></label>
          <label class="block"><span class="label">Decision target</span><input type="date" name="decisionTargetDate" class="field" /></label>
          <label class="block"><span class="label">Decision date</span><input type="date" name="decisionDate" class="field" /></label>
        </div>
        <label class="block"><span class="label">Portal URL</span><input type="url" name="portalUrl" class="field" /></label>
        <label class="block"><span class="label">Notes</span><textarea name="notes" rows="4" class="field"></textarea></label>
      </div>
      <button class="btn btn-primary mt-4 w-full">Save planning record</button>
      <p data-form-status class="mt-3 text-sm text-stone-500"></p>
    </form>

    <div class="space-y-4">
      {project.planningApplications.length ? project.planningApplications.map((item) => (
        <article class="panel rounded-lg p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-lg font-semibold">{item.applicationReference ?? 'Planning application'}</p>
              <p class="mt-1 text-sm text-stone-500">Target decision: {formatDate(item.decisionTargetDate)}</p>
            </div>
            <span class="status-chip bg-moss/10 text-moss">{humanizeEnum(item.status)}</span>
          </div>
          <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-4">
            <div><dt class="text-stone-500">Submitted</dt><dd>{formatDate(item.submissionDate)}</dd></div>
            <div><dt class="text-stone-500">Valid</dt><dd>{formatDate(item.validDate)}</dd></div>
            <div><dt class="text-stone-500">Decision</dt><dd>{formatDate(item.decisionDate)}</dd></div>
            <div><dt class="text-stone-500">Portal</dt><dd>{item.portalUrl ? <a class="font-semibold underline" href={item.portalUrl} target="_blank" rel="noreferrer">Open</a> : 'Not set'}</dd></div>
          </dl>
          {item.notes && <p class="mt-4 rounded-md bg-stone-50 p-3 text-sm text-stone-600">{item.notes}</p>}
        </article>
      )) : <div class="panel rounded-lg p-8 text-center text-sm text-stone-500">No planning applications yet.</div>}
    </div>
  </section>
</AppShell>

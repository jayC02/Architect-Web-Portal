---
import { DocumentSortBatchStatus, DocumentStatus } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { documentGroupType, documentTypeLabel, preferredDocumentTypes } from '@/lib/document-categories';
import { requirePageAuth } from '@/lib/server/page-auth';
import { classificationDetailsFromAudit } from '@/server/services/pdf-classification.service';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const projectId = Astro.params.id;
const batchId = Astro.params.batchId;
if (!projectId || !batchId) return Astro.redirect('/projects');

const returnParam = Astro.url.searchParams.get('returnTo');
const returnTo = returnParam === 'document-folder' || returnParam === 'project-detail' ? returnParam : 'project-files';
const backHref = returnTo === 'project-detail'
  ? `/projects/${projectId}#documents`
  : returnTo === 'document-folder'
    ? `/documents/projects/${projectId}`
    : `/projects/${projectId}/files`;
const backLabel = returnTo === 'project-detail' ? 'project documents' : returnTo === 'document-folder' ? 'document folder' : 'project files';

const batch = await prisma.documentSortBatch.findFirst({
  where: { id: batchId, projectId, organisationId: auth.organisation.id },
  include: {
    project: { select: { id: true, name: true } },
    items: { include: { document: true }, orderBy: { createdAt: 'asc' } },
  },
});

if (!batch) return Astro.redirect(backHref);

const isAccepted = batch.status === DocumentSortBatchStatus.ACCEPTED;
const isProcessing = batch.status === DocumentSortBatchStatus.ANALYSING || batch.status === DocumentSortBatchStatus.UPLOADED;
const itemView = batch.items.map((item) => {
  const details = classificationDetailsFromAudit(item.matchedRules);
  const fallbackUsed = Boolean(details?.fallbackReason || (details?.aiStatus && details.aiStatus !== 'succeeded'));
  const needsAttention = Boolean(
    fallbackUsed ||
    details?.manualReviewRequired ||
    details?.categoryKey === 'unsure' ||
    item.confidence < 0.55,
  );
  return { item, details, fallbackUsed, needsAttention };
});
const attentionCount = itemView.filter((entry) => entry.needsAttention).length;
---
<AppShell title={`Review document sorting - ${batch.project.name}`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={backHref} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to {backLabel}</a>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold">Review document sorting</h1>
        <p class="mt-1 text-sm text-stone-500">
          {batch.fileCount} document{batch.fileCount === 1 ? '' : 's'} analysed for {batch.project.name}.
          Review the suggested types and change anything that is incorrect.
        </p>
      </div>
      {!isAccepted && (
        <form
          data-api-form
          data-action={`/api/document-sort-batches/${batch.id}/analyse`}
          data-method="POST"
          data-redirect="reload"
          data-confirm="Analyse the documents again? Unsaved dropdown changes will be replaced."
        >
          <button class="btn btn-secondary px-3 py-2 text-sm" disabled={isProcessing}>Analyse again</button>
          <span data-form-status class="ml-2 text-sm text-stone-500"></span>
        </form>
      )}
    </div>
  </div>

  <form
    data-sort-review-form
    data-endpoint={`/api/document-sort-batches/${batch.id}/accept`}
    data-return-to={returnTo}
    data-redirect={backHref}
    class="panel overflow-hidden rounded-lg"
  >
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-stone-200 px-5 py-4">
      <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-stone-700">
        <input data-attention-filter type="checkbox" class="h-4 w-4 accent-ink" />
        <span>Needs attention only</span>
        {attentionCount > 0 && <span class="text-stone-500">({attentionCount})</span>}
      </label>
      <div class="flex items-center gap-3">
        <p data-sort-review-status class="text-sm text-stone-500">
          {isAccepted ? 'Document sorting has been saved.' : isProcessing ? 'Analysis is still in progress.' : ''}
        </p>
        <button type="submit" class="btn btn-primary" disabled={isAccepted || isProcessing || !batch.items.length}>
          Save document sorting
        </button>
      </div>
    </div>

    <div class="hidden border-b border-stone-200 bg-stone-50 px-5 py-2 text-xs font-semibold uppercase text-stone-500 md:grid md:grid-cols-[minmax(0,1fr)_260px_130px_70px] md:gap-4">
      <span>Document</span>
      <span>Document type</span>
      <span>Status</span>
      <span class="text-right">Details</span>
    </div>

    <div>
      {itemView.map(({ item, details, fallbackUsed, needsAttention }) => {
        const documentHref = item.document?.id ? `/api/documents/${item.document.id}` : '#';
        const selectedType = documentGroupType(item.finalDocumentType ?? item.suggestedDocumentType);
        const statusLabel = isProcessing ? 'Analysing' : fallbackUsed ? 'Suggested using fallback' : needsAttention ? 'Needs attention' : 'Ready';
        const statusClass = fallbackUsed || needsAttention
            ? 'text-amber-800'
            : 'text-stone-600';

        return (
          <div
            data-sort-item
            data-item-id={item.id}
            data-needs-attention={needsAttention ? 'true' : 'false'}
            data-revision={item.revision ?? ''}
            data-status={isAccepted ? item.document?.status ?? DocumentStatus.APPROVED : DocumentStatus.APPROVED}
            data-notes={item.document?.notes ?? ''}
            class="border-b border-stone-100 last:border-b-0"
          >
            <div class="grid gap-3 px-5 py-4 md:grid-cols-[minmax(0,1fr)_260px_130px_70px] md:items-center md:gap-4">
              <div class="flex min-w-0 items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-stone-200 bg-stone-50 text-stone-600" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M6 2.75h8l4 4V21.25H6z"></path>
                    <path d="M14 2.75v4h4M8.5 15.5h7M8.5 18h5"></path>
                  </svg>
                </span>
                <div class="min-w-0">
                  <a href={documentHref} target="_blank" rel="noreferrer" class="block truncate text-sm font-semibold text-ink underline-offset-2 hover:underline">
                    {item.originalFilename}
                  </a>
                  {item.drawingTitle && <p class="mt-0.5 truncate text-xs text-stone-500">{item.drawingTitle}</p>}
                </div>
              </div>

              <label class="block min-w-0">
                <span class="label mb-1 md:sr-only">Document type</span>
                <select data-document-type class="field py-2 text-sm" disabled={isAccepted || isProcessing}>
                  {preferredDocumentTypes.map((type) => (
                    <option value={type} selected={type === selectedType}>{documentTypeLabel(type)}</option>
                  ))}
                </select>
              </label>

              <p class={`text-sm font-medium ${statusClass}`}>{statusLabel}</p>

              <button
                type="button"
                data-toggle-details
                aria-expanded="false"
                class="justify-self-start rounded-md px-2 py-1 text-sm font-semibold text-stone-600 hover:bg-stone-100 hover:text-ink md:justify-self-end"
              >
                More
              </button>
            </div>

            <div
              data-details-panel
              class="fixed z-50 hidden max-h-[min(28rem,calc(100vh-2rem))] w-[min(22rem,calc(100vw-2rem))] overflow-y-auto rounded-lg border border-stone-200 bg-white p-4 shadow-xl"
            >
              <div class="text-xs text-stone-600">
                  <dl class="space-y-2">
                    {item.drawingNumber && <div><dt class="font-semibold text-ink">Drawing number</dt><dd>{item.drawingNumber}</dd></div>}
                    {item.revision && <div><dt class="font-semibold text-ink">Revision</dt><dd>{item.revision}</dd></div>}
                    <div><dt class="font-semibold text-ink">Why this was suggested</dt><dd>{details?.evidence || item.reason}</dd></div>
                    <div><dt class="font-semibold text-ink">Classification source</dt><dd>{item.source === 'AI' ? 'AI document analysis' : 'Deterministic document checks'}</dd></div>
                    {details?.warnings?.length ? (
                      <div>
                        <dt class="font-semibold text-ink">Needs checking</dt>
                        <dd>{details.warnings.join(' ')}</dd>
                      </div>
                    ) : null}
                    {details?.fallbackReason && <div><dt class="font-semibold text-ink">Fallback</dt><dd>{details.fallbackReason}</dd></div>}
                  </dl>
                  <a href={documentHref} target="_blank" rel="noreferrer" class="mt-3 inline-flex font-semibold text-ink hover:underline">Open document</a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    {!batch.items.length && <div class="p-10 text-center text-sm text-stone-500">No documents are attached to this sorting batch.</div>}
    <div data-no-attention class="hidden p-10 text-center text-sm text-stone-500">No documents currently need attention.</div>
  </form>

  <script>
    const form = document.querySelector('[data-sort-review-form]');
    const filter = document.querySelector('[data-attention-filter]');
    const emptyFiltered = document.querySelector('[data-no-attention]');
    const getRows = () => Array.from(document.querySelectorAll('[data-sort-item]')).filter((row): row is HTMLElement => row instanceof HTMLElement);
    let openPanel: HTMLElement | null = null;
    let openToggle: HTMLButtonElement | null = null;

    const closeDetails = () => {
      openPanel?.classList.add('hidden');
      openToggle?.setAttribute('aria-expanded', 'false');
      openPanel = null;
      openToggle = null;
    };

    const positionDetails = (toggle: HTMLButtonElement, panel: HTMLElement) => {
      const margin = 12;
      const gap = 8;
      const buttonRect = toggle.getBoundingClientRect();
      const panelRect = panel.getBoundingClientRect();
      const left = Math.min(
        Math.max(margin, buttonRect.right - panelRect.width),
        window.innerWidth - panelRect.width - margin,
      );
      const roomBelow = window.innerHeight - buttonRect.bottom - margin;
      const top = roomBelow >= Math.min(panelRect.height, 280)
        ? buttonRect.bottom + gap
        : Math.max(margin, buttonRect.top - panelRect.height - gap);
      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const toggle = target.closest('[data-toggle-details]');
      if (!(toggle instanceof HTMLButtonElement)) {
        if (!target.closest('[data-details-panel]')) closeDetails();
        return;
      }
      const selectedRow = toggle.closest('[data-sort-item]');
      const selectedPanel = selectedRow?.querySelector('[data-details-panel]');
      if (!(selectedPanel instanceof HTMLElement)) return;
      const isCurrent = selectedPanel === openPanel;
      closeDetails();
      if (isCurrent) return;
      selectedPanel.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      openPanel = selectedPanel;
      openToggle = toggle;
      positionDetails(toggle, selectedPanel);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeDetails();
    });
    window.addEventListener('resize', closeDetails);
    window.addEventListener('scroll', closeDetails, true);

    filter?.addEventListener('change', () => {
      if (!(filter instanceof HTMLInputElement)) return;
      let visible = 0;
      for (const row of getRows()) {
        const show = !filter.checked || row.dataset.needsAttention === 'true';
        row.classList.toggle('hidden', !show);
        if (show) visible += 1;
      }
      emptyFiltered?.classList.toggle('hidden', visible > 0 || !filter.checked);
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const status = form.querySelector('[data-sort-review-status]');
      const submit = form.querySelector('button[type="submit"]');
      if (status) {
        status.textContent = 'Saving document sorting...';
        status.classList.remove('text-red-700');
        status.classList.add('text-stone-500');
      }
      if (submit instanceof HTMLButtonElement) submit.disabled = true;

      const items = getRows().map((row) => {
        const documentTypeField = row.querySelector('[data-document-type]');
        return {
          itemId: row.dataset.itemId || '',
          documentType: documentTypeField instanceof HTMLSelectElement ? documentTypeField.value : '',
          revision: row.dataset.revision || '',
          status: row.dataset.status || 'APPROVED',
          notes: row.dataset.notes || '',
        };
      });

      try {
        const response = await fetch(form.dataset.endpoint || '', {
          method: 'POST',
          headers: { accept: 'application/json', 'content-type': 'application/json' },
          body: JSON.stringify({ items, returnTo: form.dataset.returnTo || 'project-files' }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          if (status) {
            status.textContent = payload.error || 'Document sorting could not be saved.';
            status.classList.remove('text-stone-500');
            status.classList.add('text-red-700');
          }
          return;
        }
        window.location.href = payload.redirectTo || form.dataset.redirect || window.location.href;
      } catch (error) {
        if (status) {
          status.textContent = error instanceof Error ? error.message : 'Network error. Please try again.';
          status.classList.remove('text-stone-500');
          status.classList.add('text-red-700');
        }
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  </script>
</AppShell>

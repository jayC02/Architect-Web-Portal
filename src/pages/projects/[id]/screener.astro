---
import AppShell from '@/components/layout/AppShell.astro';
import ProjectScreener from '@/components/forms/ProjectScreener.astro';
import { prisma } from '@/lib/db/prisma';
import { readProjectScreener } from '@/lib/projects/screener';
import { requirePageAuth } from '@/lib/server/page-auth';
const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');
const project = await prisma.project.findFirst({ where: { id: Astro.params.id, organisationId: auth.organisation.id } });
if (!project) return Astro.redirect('/projects');
const screener = readProjectScreener(project);
---
<AppShell title="Project screening" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6"><a href={`/projects/${project.id}`} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to project</a><h1 class="mt-2 text-3xl font-semibold">Project screening</h1><p class="mt-1 text-sm text-stone-500">{project.name}</p></div>
  <form data-api-form data-field-errors data-action={`/api/projects/${project.id}/screener`} data-method="PATCH" class="panel grid gap-5 rounded-lg p-5 lg:grid-cols-2">
    <ProjectScreener buildingUse={screener.buildingUse} typeOfWorkKeys={screener.typeOfWorkKeys} />
    <div class="flex items-center gap-3 lg:col-span-2"><button class="btn btn-primary">Save project screening</button><span data-form-status class="text-sm text-stone-500" /></div>
  </form>
</AppShell>

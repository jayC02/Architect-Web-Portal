---
import { ProjectStage, ProjectStatus } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { formatDate, humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const project = await prisma.project.findFirst({
  where: { id: Astro.params.id, organisationId: auth.organisation.id },
  include: {
    client: { select: { id: true, name: true, email: true } },
    site: { select: { id: true, addressLine1: true, postcode: true } },
    documents: {
      select: { id: true, originalName: true, type: true, revision: true },
      orderBy: { createdAt: 'desc' },
      take: 5,
    },
    deadlines: { orderBy: { dueDate: 'asc' }, take: 5 },
  },
});
if (!project) return Astro.redirect('/projects');

const [clients, sites] = await Promise.all([
  prisma.client.findMany({
    where: { organisationId: auth.organisation.id },
    orderBy: { name: 'asc' },
    select: { id: true, name: true },
  }),
  prisma.site.findMany({
    where: { organisationId: auth.organisation.id },
    orderBy: { updatedAt: 'desc' },
    select: { id: true, addressLine1: true, postcode: true },
  }),
]);
---
<AppShell title={project.name} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <a href="/projects" class="text-sm font-semibold text-stone-600 hover:text-ink">Back to projects</a>
      <h1 class="mt-2 text-3xl font-semibold">{project.name}</h1>
      <p class="mt-1 text-sm text-stone-500">{project.internalReference ?? 'No internal reference'} - {humanizeEnum(project.stage)}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="btn btn-secondary" href={`/projects/${project.id}/files`}>Files</a>
      <a class="btn btn-secondary" href={`/projects/${project.id}/planning`}>Planning</a>
      <a class="btn btn-secondary" href={`/projects/${project.id}/building-warrant`}>Building warrant</a>
    </div>
  </div>

  <section class="grid gap-4 lg:grid-cols-3">
    <div class="panel rounded-lg p-4">
      <p class="label">Client</p>
      <p class="font-semibold">{project.client?.name ?? 'Not linked'}</p>
      <p class="mt-1 text-sm text-stone-500">{project.client?.email ?? ''}</p>
    </div>
    <div class="panel rounded-lg p-4">
      <p class="label">Site</p>
      <p class="font-semibold">{project.site?.addressLine1 ?? project.siteAddress ?? 'Not linked'}</p>
      <p class="mt-1 text-sm text-stone-500">{project.site?.postcode ?? project.localAuthority ?? ''}</p>
    </div>
    <div class="panel rounded-lg p-4">
      <p class="label">Status</p>
      <p class="font-semibold">{humanizeEnum(project.status)}</p>
      <p class="mt-1 text-sm text-stone-500">Updated {formatDate(project.updatedAt)}</p>
    </div>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-2">
    <div class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Deadlines</h2>
      <div class="mt-4 space-y-3">
        {project.deadlines.length ? project.deadlines.map((deadline) => (
          <div class="rounded-md border border-stone-200 p-3">
            <div class="flex justify-between gap-3">
              <p class="font-semibold">{deadline.title}</p>
              <span class="text-sm text-stone-500">{formatDate(deadline.dueDate)}</span>
            </div>
            <p class="text-sm text-stone-500">{humanizeEnum(deadline.type)} - {humanizeEnum(deadline.priority)}</p>
          </div>
        )) : <p class="text-sm text-stone-500">No deadlines linked yet.</p>}
      </div>
    </div>

    <div class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Recent documents</h2>
      <div class="mt-4 space-y-3">
        {project.documents.length ? project.documents.map((document) => (
          <a href={`/projects/${project.id}/files`} class="block rounded-md border border-stone-200 p-3 hover:bg-stone-50">
            <p class="truncate font-semibold">{document.originalName}</p>
            <p class="text-sm text-stone-500">{humanizeEnum(document.type)} - {document.revision ?? 'No revision'}</p>
          </a>
        )) : <p class="text-sm text-stone-500">No documents uploaded yet.</p>}
      </div>
    </div>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[1fr_320px]">
    <form data-api-form data-action={`/api/projects/${project.id}`} data-method="PATCH" class="panel grid gap-4 rounded-lg p-4 md:grid-cols-2">
      <div class="md:col-span-2">
        <h2 class="text-lg font-semibold">Edit project</h2>
        <p class="mt-1 text-sm text-stone-500">Update the core project record.</p>
      </div>
      <label class="block md:col-span-2"><span class="label">Project name</span><input required name="name" value={project.name} class="field" /></label>
      <label class="block"><span class="label">Internal reference</span><input name="internalReference" value={project.internalReference ?? ''} class="field" /></label>
      <label class="block"><span class="label">Project type</span><input name="projectType" value={project.projectType ?? ''} class="field" /></label>
      <label class="block"><span class="label">Stage</span><select name="stage" class="field">{Object.values(ProjectStage).map((stage) => <option value={stage} selected={stage === project.stage}>{humanizeEnum(stage)}</option>)}</select></label>
      <label class="block"><span class="label">Status</span><select name="status" class="field">{Object.values(ProjectStatus).map((status) => <option value={status} selected={status === project.status}>{humanizeEnum(status)}</option>)}</select></label>
      <label class="block"><span class="label">Client</span><select name="clientId" class="field"><option value="">Not linked</option>{clients.map((client) => <option value={client.id} selected={client.id === project.clientId}>{client.name}</option>)}</select></label>
      <label class="block"><span class="label">Linked site</span><select name="siteId" class="field"><option value="">Not linked</option>{sites.map((site) => <option value={site.id} selected={site.id === project.siteId}>{site.addressLine1}, {site.postcode}</option>)}</select></label>
      <label class="block"><span class="label">Local authority</span><input name="localAuthority" value={project.localAuthority ?? ''} class="field" /></label>
      <label class="block"><span class="label">Manual site address</span><input name="siteAddress" value={project.siteAddress ?? ''} class="field" /></label>
      <label class="block md:col-span-2"><span class="label">Notes</span><textarea name="notes" rows="4" class="field">{project.notes ?? ''}</textarea></label>
      <div class="flex flex-wrap items-center gap-3 md:col-span-2">
        <button class="btn btn-primary">Save project</button>
        <span data-form-status class="text-sm text-stone-500"></span>
      </div>
    </form>

    <div class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Danger zone</h2>
      <p class="mt-2 text-sm text-stone-500">Deleting a project also removes its linked files, applications, deadlines and submission packages.</p>
      <form data-api-form data-action={`/api/projects/${project.id}`} data-method="DELETE" data-redirect="/projects" data-confirm="Delete this project and its linked records?" class="mt-4">
        <button class="btn border border-red-200 bg-red-50 text-red-700 hover:bg-red-100">Delete project</button>
        <p data-form-status class="mt-3 text-sm text-stone-500"></p>
      </form>
    </div>
  </section>
</AppShell>

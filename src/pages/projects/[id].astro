---
import {
  AutomationJobType,
  DeadlineStatus,
  DocumentStatus,
  DocumentType,
  ProjectStage,
  ProjectStatus,
} from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import ApplicationSummaryCard from '@/components/projects/ApplicationSummaryCard.astro';
import { prisma } from '@/lib/db/prisma';
import { formatBytes, formatDate, humanizeEnum } from '@/lib/format';
import { getProjectNextAction, isProjectDateOverdue } from '@/lib/projects/next-action';
import { requirePageAuth } from '@/lib/server/page-auth';
import {
  desktopAutomationJobSelect,
  getDesktopAutomationContext,
} from '@/server/services/desktop-automation-status.service';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const projectId = Astro.params.id;
const project = await prisma.project.findFirst({
  where: { id: projectId, organisationId: auth.organisation.id },
  include: { client: true, site: true },
});
if (!project) return Astro.redirect('/projects');

const [
  clients,
  sites,
  documentStats,
  recentDocuments,
  planningApplications,
  warrantApplications,
  deadlines,
  automationJobs,
  recentEmailActivity,
] = await Promise.all([
  prisma.client.findMany({
    where: { organisationId: auth.organisation.id },
    orderBy: { name: 'asc' },
    select: { id: true, name: true },
  }),
  prisma.site.findMany({
    where: { organisationId: auth.organisation.id },
    orderBy: { updatedAt: 'desc' },
    select: { id: true, addressLine1: true, postcode: true },
  }),
  prisma.projectDocument.groupBy({
    by: ['type', 'status'],
    where: { organisationId: auth.organisation.id, projectId: project.id },
    _count: { _all: true },
  }),
  prisma.projectDocument.findMany({
    where: { organisationId: auth.organisation.id, projectId: project.id },
    orderBy: { createdAt: 'desc' },
    take: 5,
    select: { id: true, originalName: true, type: true, status: true, revision: true, sizeBytes: true, createdAt: true },
  }),
  prisma.planningApplication.findMany({
    where: { organisationId: auth.organisation.id, projectId: project.id },
    orderBy: { updatedAt: 'desc' },
    take: 3,
  }),
  prisma.buildingWarrantApplication.findMany({
    where: { organisationId: auth.organisation.id, projectId: project.id },
    orderBy: { updatedAt: 'desc' },
    take: 3,
  }),
  prisma.deadline.findMany({
    where: { organisationId: auth.organisation.id, projectId: project.id },
    orderBy: [{ dueDate: 'asc' }, { createdAt: 'desc' }],
    take: 20,
  }),
  prisma.automationJob.findMany({
    where: { organisationId: auth.organisation.id, projectId: project.id },
    orderBy: { updatedAt: 'desc' },
    take: 100,
    select: desktopAutomationJobSelect,
  }),
  prisma.gmailUpdateSuggestion.findMany({
    where: {
      organisationId: auth.organisation.id,
      projectId: project.id,
      status: 'APPLIED',
    },
    orderBy: { appliedAt: 'desc' },
    take: 8,
    select: {
      id: true,
      updateType: true,
      fieldName: true,
      suggestedValue: true,
      appliedAutomatically: true,
      appliedAt: true,
      reviewedBy: { select: { name: true } },
      trackedEmail: { select: { sender: true, subject: true } },
    },
  }),
]);

const documentCount = documentStats.reduce((total, group) => total + group._count._all, 0);
const documentReviewCount = documentStats
  .filter((group) => group.status === DocumentStatus.IN_REVIEW)
  .reduce((total, group) => total + group._count._all, 0);
const locationPlanCount = documentStats
  .filter((group) => group.type === DocumentType.LOCATION_PLAN)
  .reduce((total, group) => total + group._count._all, 0);
const planningDocumentTypes = new Set<DocumentType>([
  DocumentType.LOCATION_PLAN,
  DocumentType.SITE_PLAN,
  DocumentType.BLOCK_PLAN,
  DocumentType.EXISTING_DRAWING,
  DocumentType.PROPOSED_DRAWING,
  DocumentType.ELEVATION,
  DocumentType.SECTION,
  DocumentType.DETAILS,
  DocumentType.SPECIFICATIONS,
  DocumentType.PHOTO,
  DocumentType.SUPPORTING_DOCUMENT,
]);
const warrantDocumentTypes = new Set<DocumentType>([
  ...planningDocumentTypes,
  DocumentType.CALCULATIONS,
  DocumentType.DRAINAGE,
  DocumentType.STRUCTURAL,
  DocumentType.ENERGY,
  DocumentType.CERTIFICATE,
]);
const planningDocumentCount = documentStats
  .filter((group) => planningDocumentTypes.has(group.type))
  .reduce((total, group) => total + group._count._all, 0);
const warrantDocumentCount = documentStats
  .filter((group) => warrantDocumentTypes.has(group.type))
  .reduce((total, group) => total + group._count._all, 0);
const latestPlanning = planningApplications[0] ?? null;
const latestWarrant = warrantApplications[0] ?? null;
const nextDeadline = deadlines.find((deadline) => deadline.status !== DeadlineStatus.COMPLETED && deadline.status !== DeadlineStatus.CANCELLED) ?? null;
const desktopContextBase = {
  organisationId: auth.organisation.id,
  organisationName: auth.organisation.name,
  projectId: project.id,
  createdBy: { id: auth.user.id, name: auth.user.name, email: auth.user.email },
  jobs: automationJobs,
};
const [planningDesktop, warrantDesktop] = await Promise.all([
  getDesktopAutomationContext({
    ...desktopContextBase,
    type: AutomationJobType.HOUSEHOLDER_PLANNING,
    matchingTypes: [AutomationJobType.HOUSEHOLDER_PLANNING, AutomationJobType.PLANNING_APPLICATION],
    applicationId: latestPlanning?.id,
  }),
  getDesktopAutomationContext({
    ...desktopContextBase,
    type: AutomationJobType.BUILDING_WARRANT,
    applicationId: latestWarrant?.id,
  }),
]);
const readyAutomationJobCount = [planningDesktop.job, warrantDesktop.job]
  .filter((job) => job?.status === 'READY').length;
const nextAction = getProjectNextAction({
  projectId: project.id,
  stage: project.stage,
  documentCount,
  documentReviewCount,
  hasLocationPlan: locationPlanCount > 0,
  planningStatus: latestPlanning?.status,
  warrantStatus: latestWarrant?.status,
  readyAutomationJobCount,
  nextDeadline,
});

const siteSummary = project.site
  ? [project.site.addressLine1, project.site.townCity, project.site.postcode].filter(Boolean).join(', ')
  : project.siteAddress ?? 'No site address linked';
const activeDeadlines = deadlines.filter((deadline) => deadline.status !== DeadlineStatus.COMPLETED && deadline.status !== DeadlineStatus.CANCELLED);
const completedDeadlines = deadlines.filter((deadline) => deadline.status === DeadlineStatus.COMPLETED);
const overdueCount = activeDeadlines.filter((deadline) => isProjectDateOverdue(deadline.dueDate)).length;
const applicationStatus = (value: string | undefined) => !value || value === 'NOT_STARTED'
  ? 'Ready to prepare'
  : humanizeEnum(value);
const emailActivityLabel = (activity: typeof recentEmailActivity[number]) => {
  const value = activity.suggestedValue;
  const display = value && typeof value === 'object' && !Array.isArray(value)
    ? String((value as Record<string, unknown>).dueDate ?? (value as Record<string, unknown>).title ?? '')
    : String(value ?? '');
  if (activity.updateType === 'DEADLINE') return `${humanizeEnum(activity.fieldName)} updated to ${formatDate(display)}`;
  return `${humanizeEnum(activity.fieldName)} updated${display ? ` to ${humanizeEnum(display)}` : ''}`;
};

const preparedJobId = Astro.url.searchParams.get('job');
const preparedContext = [planningDesktop, warrantDesktop]
  .find((context) => context.job?.id === preparedJobId);
const showPreparedNotice = Astro.url.searchParams.get('applicationPrepared') === '1' && preparedContext?.job;

const actionTone = {
  neutral: 'bg-stone-100 text-stone-700 border-stone-200',
  info: 'bg-emerald-50 text-emerald-800 border-emerald-200',
  warning: 'bg-amber-50 text-amber-800 border-amber-200',
  danger: 'bg-red-50 text-red-800 border-red-200',
};

---
<AppShell title={project.name} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <header class="mb-5">
    <a href="/projects" class="text-sm font-semibold text-stone-600 hover:text-ink">Back to projects</a>
    <div class="mt-3 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="truncate text-3xl font-semibold">{project.name}</h1>
          {project.internalReference && <span class="rounded-md bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-600">{project.internalReference}</span>}
        </div>
        <p class="mt-2 text-sm text-stone-500">{siteSummary}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn btn-secondary" href="#project-details">Edit project details</a>
        <span class="status-chip bg-moss/10 text-moss">{humanizeEnum(project.stage)}</span>
        <span class="status-chip bg-stone-100 text-stone-700">{humanizeEnum(project.status)}</span>
      </div>
    </div>
  </header>

  {showPreparedNotice && (
    <section class="panel mb-5 rounded-lg border-l-4 border-l-moss p-4" aria-live="polite">
      <p class="font-semibold">{preparedContext.job?.status === 'READY' ? 'Application prepared' : 'Application created'}</p>
      <p class="mt-1 text-sm text-stone-600">
        {preparedContext.job?.status === 'READY'
          ? 'The reviewed application and its documents are ready to open in ArchitectPro Desktop.'
          : 'A few application details still need your attention before it can be opened in desktop.'}
      </p>
    </section>
  )}

  <nav aria-label="Project sections" class="panel mb-6 flex gap-1 overflow-x-auto rounded-lg p-1.5">
    {[
      ['Overview', '#overview'],
      ['Documents', '#documents'],
      ['Planning', '#planning'],
      ['Building Warrant', '#building-warrant'],
      ['Deadlines', '#deadlines'],
      ['Email Activity', '#email-activity'],
      ['Notes', '#notes'],
    ].map(([label, href]) => <a href={href} class="shrink-0 rounded-md px-3 py-2 text-sm font-semibold text-stone-600 transition hover:bg-stone-100 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink">{label}</a>)}
  </nav>

  <section id="overview" class="scroll-mt-6">
    <div class="grid gap-4 lg:grid-cols-4">
      <a class="panel block rounded-lg p-4 transition hover:border-stone-300 hover:bg-stone-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink" href={project.client ? `/clients?edit=${project.client.id}` : '/clients'} aria-label={project.client ? `View or edit client ${project.client.name}` : 'Open clients'}>
        <p class="label">Client</p>
        <p class="font-semibold">{project.client?.name ?? 'Not linked'}</p>
        <p class="mt-1 truncate text-sm text-stone-500">{project.client?.email ?? 'No client email'}</p>
      </a>
      <a class="panel block rounded-lg p-4 transition hover:border-stone-300 hover:bg-stone-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink" href={project.site ? `/sites?edit=${project.site.id}` : '/sites'} aria-label={project.site ? `View or edit site ${project.site.addressLine1}` : 'Open sites'}>
        <p class="label">Site</p>
        <p class="truncate font-semibold">{project.site?.addressLine1 ?? project.siteAddress ?? 'Not linked'}</p>
        <p class="mt-1 text-sm text-stone-500">{project.site?.postcode ?? project.localAuthority ?? 'No authority set'}</p>
      </a>
      <article class={`rounded-lg border p-4 ${actionTone[nextAction.tone]}`}>
        <p class="text-xs font-semibold uppercase">Next action</p>
        <a href={nextAction.href} class="mt-2 block font-semibold hover:underline">{nextAction.label}</a>
        <p class="mt-1 text-xs opacity-75">Based on current project records</p>
      </article>
      <article class="panel rounded-lg p-4">
        <p class="label">Next deadline</p>
        {nextDeadline ? <><p class="truncate font-semibold">{nextDeadline.title}</p><p class="mt-1 text-sm text-stone-500">{formatDate(nextDeadline.dueDate)}</p></> : <p class="font-semibold text-stone-500">None scheduled</p>}
      </article>
    </div>

    <div class="panel mt-4 rounded-lg p-4">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="text-lg font-semibold">Quick actions</h2>
          <p class="mt-1 text-sm text-stone-500">Jump directly to the project task you need.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a class="btn btn-primary" href={`/documents/upload?projectId=${project.id}`}>Upload documents</a>
          <a class="btn btn-secondary" href={`/deadlines?projectId=${project.id}`}>Add deadline</a>
        </div>
      </div>
    </div>
  </section>

  <details id="project-details" class="panel mt-6 scroll-mt-6 rounded-lg p-4">
    <summary class="cursor-pointer text-lg font-semibold">Edit project details</summary>
    <form data-api-form data-action={`/api/projects/${project.id}`} data-method="PATCH" class="mt-4">
      <div class="grid gap-4 md:grid-cols-2">
        <label class="block md:col-span-2"><span class="label">Project name</span><input required name="name" value={project.name} class="field" /></label>
        <label class="block"><span class="label">Internal reference</span><input name="internalReference" value={project.internalReference ?? ''} class="field" /></label>
        <label class="block"><span class="label">Project type</span><input name="projectType" value={project.projectType ?? ''} class="field" /></label>
        <label class="block"><span class="label">Stage</span><select name="stage" class="field">{Object.values(ProjectStage).map((value) => <option value={value} selected={value === project.stage}>{humanizeEnum(value)}</option>)}</select></label>
        <label class="block"><span class="label">Status</span><select name="status" class="field">{Object.values(ProjectStatus).map((value) => <option value={value} selected={value === project.status}>{humanizeEnum(value)}</option>)}</select></label>
        <label class="block"><span class="label">Client</span><select name="clientId" class="field"><option value="">Not linked</option>{clients.map((client) => <option value={client.id} selected={client.id === project.clientId}>{client.name}</option>)}</select></label>
        <label class="block"><span class="label">Linked site</span><select name="siteId" class="field"><option value="">Not linked</option>{sites.map((site) => <option value={site.id} selected={site.id === project.siteId}>{site.addressLine1}, {site.postcode}</option>)}</select></label>
        <label class="block"><span class="label">Local authority</span><input name="localAuthority" value={project.localAuthority ?? ''} class="field" /></label>
        <label class="block"><span class="label">Manual site address</span><input name="siteAddress" value={project.siteAddress ?? ''} class="field" /></label>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-3"><button class="btn btn-primary">Save project details</button><span data-form-status class="text-sm text-stone-500"></span></div>
    </form>
  </details>

  <section id="documents" class="panel mt-6 scroll-mt-6 rounded-lg p-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 class="text-xl font-semibold">Documents</h2>
        <p class="mt-1 text-sm text-stone-500">{documentCount} document{documentCount === 1 ? '' : 's'} &middot; {documentReviewCount} needing review</p>
      </div>
      <a class="btn btn-primary" href={`/documents/upload?projectId=${project.id}`}>Upload documents</a>
    </div>
    {locationPlanCount === 0 && <a href={`/documents/upload?projectId=${project.id}`} class="mt-4 block rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800 hover:bg-amber-100">Location plan missing</a>}
    {recentDocuments.length ? (
      <div class="mt-4 divide-y divide-stone-100 rounded-lg border border-stone-200">
        {recentDocuments.map((document) => (
          <div class="group flex flex-col gap-3 px-4 py-3 transition hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <a href={`/api/documents/${document.id}`} target="_blank" rel="noreferrer" class="block truncate font-semibold hover:underline">{document.originalName}</a>
              <p class="mt-1 text-xs text-stone-500">{humanizeEnum(document.type)} &middot; {document.revision ? `Rev ${document.revision}` : 'No revision'} &middot; {formatBytes(document.sizeBytes)}</p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <span class="status-chip bg-stone-100 text-stone-700">{humanizeEnum(document.status)}</span>
              <form data-api-form data-action={`/api/documents/${document.id}`} data-method="DELETE" data-redirect="reload" data-confirm={`Remove ${document.originalName} from this project?`}>
                <button type="submit" class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-stone-200 bg-white text-lg leading-none text-stone-500 opacity-100 transition hover:border-red-200 hover:bg-red-50 hover:text-red-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-200 sm:opacity-0 sm:group-hover:opacity-100" aria-label={`Remove ${document.originalName}`}><svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg></button>
              </form>
            </div>
          </div>
        ))}
        {documentCount > recentDocuments.length && <div class="px-4 py-3"><a href={`/projects/${project.id}/files`} class="btn btn-secondary w-full sm:w-auto">See more files</a></div>}
      </div>
    ) : <div class="mt-4 rounded-lg border border-dashed border-stone-300 p-6 text-center"><p class="font-semibold">No documents uploaded yet</p><p class="mt-1 text-sm text-stone-500">Upload drawings, specifications or supporting files for this project.</p></div>}
  </section>

  <div class="mt-6 grid items-stretch gap-6 xl:grid-cols-2">
    <ApplicationSummaryCard
      id="planning"
      title="Planning"
      subtitle="Latest planning application"
      manageHref={`/projects/${project.id}/planning`}
      address={siteSummary}
      clientName={project.client?.name ?? 'Not linked'}
      applicationType="Householder"
      status={applicationStatus(latestPlanning?.status)}
      documentCount={planningDocumentCount}
      reference={latestPlanning?.applicationReference ?? 'Not assigned'}
      projectId={project.id}
      applicationKind="PLANNING"
      applicationId={latestPlanning?.id}
      desktopJob={planningDesktop.job}
      desktopPreparationReady={planningDesktop.preparationReady}
      desktopMissingCount={planningDesktop.missingCount}
    />
    <ApplicationSummaryCard
      id="building-warrant"
      title="Building Warrant"
      subtitle="Latest building warrant application"
      manageHref={`/projects/${project.id}/building-warrant`}
      address={siteSummary}
      clientName={project.client?.name ?? 'Not linked'}
      applicationType="Building Warrant"
      status={applicationStatus(latestWarrant?.status)}
      documentCount={warrantDocumentCount}
      reference={latestWarrant?.warrantReference ?? 'Not assigned'}
      projectId={project.id}
      applicationKind="BUILDING_WARRANT"
      applicationId={latestWarrant?.id}
      desktopJob={warrantDesktop.job}
      desktopPreparationReady={warrantDesktop.preparationReady}
      desktopMissingCount={warrantDesktop.missingCount}
    />
  </div>

  <section id="deadlines" class="panel mt-6 scroll-mt-6 rounded-lg p-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><h2 class="text-xl font-semibold">Deadlines</h2><p class="mt-1 text-sm text-stone-500">{activeDeadlines.length} upcoming &middot; {overdueCount} overdue &middot; {completedDeadlines.length} completed</p></div><a class="btn btn-secondary" href={`/deadlines?projectId=${project.id}`}>Add or manage deadlines</a></div>
    {activeDeadlines.length ? <div class="mt-4 divide-y divide-stone-100 rounded-lg border border-stone-200">{activeDeadlines.slice(0, 6).map((deadline) => <a href={`/deadlines?projectId=${project.id}`} class="flex flex-col gap-2 px-4 py-3 hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between"><div><p class="font-semibold">{deadline.title}</p><p class="mt-1 text-xs text-stone-500">{humanizeEnum(deadline.type)} &middot; {humanizeEnum(deadline.priority)}</p></div><span class={`status-chip ${isProjectDateOverdue(deadline.dueDate) ? 'bg-red-100 text-red-800' : 'bg-stone-100 text-stone-700'}`}>{formatDate(deadline.dueDate)}</span></a>)}</div> : <div class="mt-4 rounded-lg border border-dashed border-stone-300 p-6 text-center"><p class="font-semibold">No deadlines added yet</p><p class="mt-1 text-sm text-stone-500">Add an internal task or statutory date for this project.</p></div>}
  </section>

  <section id="email-activity" class="panel mt-6 scroll-mt-6 overflow-hidden rounded-lg">
    <div class="flex flex-col gap-3 border-b border-stone-200 px-4 py-4 sm:flex-row sm:items-start sm:justify-between sm:px-5">
      <div><h2 class="text-xl font-semibold">Email activity</h2><p class="mt-1 text-sm text-stone-500">Confirmed project updates detected from the connected Gmail account.</p></div>
      <a class="text-sm font-semibold text-stone-600 hover:text-ink" href="/email-updates">Review email updates</a>
    </div>
    {recentEmailActivity.length ? <div class="divide-y divide-stone-200">
      {recentEmailActivity.map((activity) => <article class="px-4 py-3 sm:px-5">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0"><p class="font-semibold">{emailActivityLabel(activity)}</p><p class="mt-1 truncate text-sm text-stone-500">{activity.trackedEmail.subject}</p></div>
          <time class="shrink-0 text-xs text-stone-500">{formatDate(activity.appliedAt)}</time>
        </div>
        <p class="mt-2 text-xs text-stone-500">From {activity.trackedEmail.sender} &middot; {activity.appliedAutomatically ? 'Applied automatically' : `Reviewed by ${activity.reviewedBy?.name ?? 'an organisation member'}`}</p>
      </article>)}
    </div> : <div class="px-4 py-8 text-center sm:px-5"><p class="font-semibold">No email-derived updates yet</p><p class="mt-1 text-sm text-stone-500">Confirmed application and deadline changes will appear here after Gmail sync.</p></div>}
  </section>

  <section id="notes" class="panel mt-6 scroll-mt-6 rounded-lg p-4">
    <h2 class="text-xl font-semibold">Notes</h2>
    <p class="mt-1 text-sm text-stone-500">Keep the client brief, useful email excerpts and manual source notes with the project.</p>
    <form data-api-form data-action={`/api/projects/${project.id}`} data-method="PATCH" class="mt-4">
      <label class="block"><span class="label">Project notes</span><textarea name="notes" rows="6" class="field" placeholder="Client brief, source notes and important context">{project.notes ?? ''}</textarea></label>
      <div class="mt-4 flex flex-wrap items-center gap-3"><button class="btn btn-primary">Save notes</button><span data-form-status class="text-sm text-stone-500"></span></div>
    </form>
    <details class="mt-5 border-t border-stone-100 pt-4"><summary class="cursor-pointer text-sm font-semibold text-red-700">Delete project</summary><p class="mt-3 text-sm text-stone-500">Deleting a project also removes its linked files, applications, deadlines and submission packages.</p><form data-api-form data-action={`/api/projects/${project.id}`} data-method="DELETE" data-redirect="/projects" data-confirm="Delete this project and its linked records?" class="mt-3"><button class="btn border border-red-200 bg-red-50 text-red-700 hover:bg-red-100">Delete project</button><span data-form-status class="ml-3 text-sm text-stone-500"></span></form></details>
  </section>
</AppShell>

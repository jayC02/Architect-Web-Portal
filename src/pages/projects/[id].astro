---
import {
  AutomationJobStatus,
  DeadlineStatus,
  DocumentStatus,
  DocumentType,
  ProjectStage,
  ProjectStatus,
} from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { formatBytes, formatDate, humanizeEnum } from '@/lib/format';
import { getProjectNextAction, isProjectDateOverdue } from '@/lib/projects/next-action';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const projectId = Astro.params.id;
const project = await prisma.project.findFirst({
  where: { id: projectId, organisationId: auth.organisation.id },
  include: { client: true, site: true },
});
if (!project) return Astro.redirect('/projects');

const [
  clients,
  sites,
  documentCount,
  documentReviewCount,
  locationPlanCount,
  recentDocuments,
  planningApplications,
  warrantApplications,
  deadlines,
  automationJobs,
] = await Promise.all([
  prisma.client.findMany({
    where: { organisationId: auth.organisation.id },
    orderBy: { name: 'asc' },
    select: { id: true, name: true },
  }),
  prisma.site.findMany({
    where: { organisationId: auth.organisation.id },
    orderBy: { updatedAt: 'desc' },
    select: { id: true, addressLine1: true, postcode: true },
  }),
  prisma.projectDocument.count({ where: { organisationId: auth.organisation.id, projectId: project.id } }),
  prisma.projectDocument.count({ where: { organisationId: auth.organisation.id, projectId: project.id, status: DocumentStatus.IN_REVIEW } }),
  prisma.projectDocument.count({ where: { organisationId: auth.organisation.id, projectId: project.id, type: DocumentType.LOCATION_PLAN } }),
  prisma.projectDocument.findMany({
    where: { organisationId: auth.organisation.id, projectId: project.id },
    orderBy: { createdAt: 'desc' },
    take: 5,
    select: { id: true, originalName: true, type: true, status: true, revision: true, sizeBytes: true, createdAt: true },
  }),
  prisma.planningApplication.findMany({
    where: { organisationId: auth.organisation.id, projectId: project.id },
    orderBy: { updatedAt: 'desc' },
    take: 3,
  }),
  prisma.buildingWarrantApplication.findMany({
    where: { organisationId: auth.organisation.id, projectId: project.id },
    orderBy: { updatedAt: 'desc' },
    take: 3,
  }),
  prisma.deadline.findMany({
    where: { organisationId: auth.organisation.id, projectId: project.id },
    orderBy: [{ dueDate: 'asc' }, { createdAt: 'desc' }],
    take: 20,
  }),
  prisma.automationJob.findMany({
    where: { organisationId: auth.organisation.id, projectId: project.id },
    orderBy: { createdAt: 'desc' },
    take: 20,
    select: {
      id: true,
      title: true,
      type: true,
      status: true,
      sourceType: true,
      dataSnapshot: true,
      documentSnapshot: true,
      resultSummary: true,
      error: true,
      createdAt: true,
    },
  }),
]);

const latestPlanning = planningApplications[0] ?? null;
const latestWarrant = warrantApplications[0] ?? null;
const nextDeadline = deadlines.find((deadline) => deadline.status !== DeadlineStatus.COMPLETED && deadline.status !== DeadlineStatus.CANCELLED) ?? null;
const readyAutomationJobCount = automationJobs.filter((job) => job.status === AutomationJobStatus.READY).length;
const nextAction = getProjectNextAction({
  projectId: project.id,
  stage: project.stage,
  documentCount,
  documentReviewCount,
  hasLocationPlan: locationPlanCount > 0,
  planningStatus: latestPlanning?.status,
  warrantStatus: latestWarrant?.status,
  readyAutomationJobCount,
  nextDeadline,
});

const siteSummary = project.site
  ? [project.site.addressLine1, project.site.townCity, project.site.postcode].filter(Boolean).join(', ')
  : project.siteAddress ?? 'No site address linked';
const activeDeadlines = deadlines.filter((deadline) => deadline.status !== DeadlineStatus.COMPLETED && deadline.status !== DeadlineStatus.CANCELLED);
const completedDeadlines = deadlines.filter((deadline) => deadline.status === DeadlineStatus.COMPLETED);
const overdueCount = activeDeadlines.filter((deadline) => isProjectDateOverdue(deadline.dueDate)).length;

const actionTone = {
  neutral: 'bg-stone-100 text-stone-700 border-stone-200',
  info: 'bg-emerald-50 text-emerald-800 border-emerald-200',
  warning: 'bg-amber-50 text-amber-800 border-amber-200',
  danger: 'bg-red-50 text-red-800 border-red-200',
};

const jobTone = (status: AutomationJobStatus) => {
  if (status === AutomationJobStatus.READY) return 'bg-emerald-100 text-emerald-800';
  if (status === AutomationJobStatus.FAILED || status === AutomationJobStatus.CANCELLED) return 'bg-red-100 text-red-800';
  return 'bg-stone-100 text-stone-700';
};
---
<AppShell title={project.name} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <header class="mb-5">
    <a href="/projects" class="text-sm font-semibold text-stone-600 hover:text-ink">Back to projects</a>
    <div class="mt-3 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="truncate text-3xl font-semibold">{project.name}</h1>
          {project.internalReference && <span class="rounded-md bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-600">{project.internalReference}</span>}
        </div>
        <p class="mt-2 text-sm text-stone-500">{siteSummary}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="status-chip bg-moss/10 text-moss">{humanizeEnum(project.stage)}</span>
        <span class="status-chip bg-stone-100 text-stone-700">{humanizeEnum(project.status)}</span>
      </div>
    </div>
  </header>

  <nav aria-label="Project sections" class="panel mb-6 flex gap-1 overflow-x-auto rounded-lg p-1.5">
    {[
      ['Overview', '#overview'],
      ['Documents', '#documents'],
      ['Planning', '#planning'],
      ['Building Warrant', '#building-warrant'],
      ['Deadlines', '#deadlines'],
      ['Automation', '#automation'],
      ['Notes', '#notes'],
    ].map(([label, href]) => <a href={href} class="shrink-0 rounded-md px-3 py-2 text-sm font-semibold text-stone-600 transition hover:bg-stone-100 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink">{label}</a>)}
  </nav>

  <section id="overview" class="scroll-mt-6">
    <div class="grid gap-4 lg:grid-cols-4">
      <article class="panel rounded-lg p-4">
        <p class="label">Client</p>
        <p class="font-semibold">{project.client?.name ?? 'Not linked'}</p>
        <p class="mt-1 truncate text-sm text-stone-500">{project.client?.email ?? 'No client email'}</p>
      </article>
      <article class="panel rounded-lg p-4">
        <p class="label">Site</p>
        <p class="truncate font-semibold">{project.site?.addressLine1 ?? project.siteAddress ?? 'Not linked'}</p>
        <p class="mt-1 text-sm text-stone-500">{project.site?.postcode ?? project.localAuthority ?? 'No authority set'}</p>
      </article>
      <article class={`rounded-lg border p-4 ${actionTone[nextAction.tone]}`}>
        <p class="text-xs font-semibold uppercase">Next action</p>
        <a href={nextAction.href} class="mt-2 block font-semibold hover:underline">{nextAction.label}</a>
        <p class="mt-1 text-xs opacity-75">Based on current project records</p>
      </article>
      <article class="panel rounded-lg p-4">
        <p class="label">Next deadline</p>
        {nextDeadline ? <><p class="truncate font-semibold">{nextDeadline.title}</p><p class="mt-1 text-sm text-stone-500">{formatDate(nextDeadline.dueDate)}</p></> : <p class="font-semibold text-stone-500">None scheduled</p>}
      </article>
    </div>

    <div class="panel mt-4 rounded-lg p-4">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="text-lg font-semibold">Quick actions</h2>
          <p class="mt-1 text-sm text-stone-500">Jump directly to the project task you need.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a class="btn btn-primary" href={`/documents/upload?projectId=${project.id}`}>Upload documents</a>
          <a class="btn btn-secondary" href={`/projects/${project.id}/planning`}>Add planning record</a>
          <a class="btn btn-secondary" href={`/projects/${project.id}/building-warrant`}>Add warrant record</a>
          <a class="btn btn-secondary" href={`/deadlines?projectId=${project.id}`}>Add deadline</a>
          <form data-api-form data-action="/api/automation-jobs" data-method="POST">
            <input type="hidden" name="projectId" value={project.id} />
            <input type="hidden" name="type" value="HOUSEHOLDER_PLANNING" />
            <button class="btn btn-secondary">Prepare householder job</button>
          </form>
          <form data-api-form data-action="/api/automation-jobs" data-method="POST">
            <input type="hidden" name="projectId" value={project.id} />
            <input type="hidden" name="type" value="PLANNING_APPLICATION" />
            {latestPlanning && <input type="hidden" name="planningApplicationId" value={latestPlanning.id} />}
            <button class="btn btn-secondary">Prepare planning job</button>
          </form>
          <form data-api-form data-action="/api/automation-jobs" data-method="POST">
            <input type="hidden" name="projectId" value={project.id} />
            <input type="hidden" name="type" value="BUILDING_WARRANT" />
            {latestWarrant && <input type="hidden" name="buildingWarrantApplicationId" value={latestWarrant.id} />}
            <button class="btn btn-secondary">Prepare warrant job</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section id="documents" class="panel mt-6 scroll-mt-6 rounded-lg p-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 class="text-xl font-semibold">Documents</h2>
        <p class="mt-1 text-sm text-stone-500">{documentCount} document{documentCount === 1 ? '' : 's'} · {documentReviewCount} needing review</p>
      </div>
      <a class="btn btn-primary" href={`/documents/upload?projectId=${project.id}`}>Upload documents</a>
    </div>
    {locationPlanCount === 0 && <a href={`/documents/upload?projectId=${project.id}`} class="mt-4 block rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800 hover:bg-amber-100">Location plan missing</a>}
    {recentDocuments.length ? (
      <div class="mt-4 divide-y divide-stone-100 rounded-lg border border-stone-200">
        {recentDocuments.map((document) => (
          <div class="group flex flex-col gap-3 px-4 py-3 transition hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <a href={`/api/documents/${document.id}`} target="_blank" rel="noreferrer" class="block truncate font-semibold hover:underline">{document.originalName}</a>
              <p class="mt-1 text-xs text-stone-500">{humanizeEnum(document.type)} · {document.revision ? `Rev ${document.revision}` : 'No revision'} · {formatBytes(document.sizeBytes)}</p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <span class="status-chip bg-stone-100 text-stone-700">{humanizeEnum(document.status)}</span>
              <form data-api-form data-action={`/api/documents/${document.id}`} data-method="DELETE" data-redirect="reload" data-confirm={`Remove ${document.originalName} from this project?`}>
                <button type="submit" class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-stone-200 bg-white text-lg leading-none text-stone-500 opacity-100 transition hover:border-red-200 hover:bg-red-50 hover:text-red-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-200 sm:opacity-0 sm:group-hover:opacity-100" aria-label={`Remove ${document.originalName}`}>×</button>
              </form>
            </div>
          </div>
        ))}
        {documentCount > recentDocuments.length && <div class="px-4 py-3"><a href={`/projects/${project.id}/files`} class="btn btn-secondary w-full sm:w-auto">See more files</a></div>}
      </div>
    ) : <div class="mt-4 rounded-lg border border-dashed border-stone-300 p-6 text-center"><p class="font-semibold">No documents uploaded yet</p><p class="mt-1 text-sm text-stone-500">Upload drawings, specifications or supporting files for this project.</p></div>}
  </section>

  <div class="mt-6 grid gap-6 xl:grid-cols-2">
    <section id="planning" class="panel scroll-mt-6 rounded-lg p-4">
      <div class="flex items-start justify-between gap-3"><div><h2 class="text-xl font-semibold">Planning</h2><p class="mt-1 text-sm text-stone-500">Latest planning application record</p></div><a class="text-sm font-semibold text-stone-600 hover:text-ink" href={`/projects/${project.id}/planning`}>Manage</a></div>
      {latestPlanning ? <dl class="mt-4 grid gap-3 sm:grid-cols-2"><div><dt class="label">Status</dt><dd><span class="status-chip bg-moss/10 text-moss">{humanizeEnum(latestPlanning.status)}</span></dd></div><div><dt class="label">Reference</dt><dd class="font-semibold">{latestPlanning.applicationReference ?? 'Not set'}</dd></div><div><dt class="label">Submitted</dt><dd>{formatDate(latestPlanning.submissionDate)}</dd></div><div><dt class="label">Validated</dt><dd>{formatDate(latestPlanning.validDate)}</dd></div><div><dt class="label">Decision target</dt><dd>{formatDate(latestPlanning.decisionTargetDate)}</dd></div><div><dt class="label">Decision</dt><dd>{formatDate(latestPlanning.decisionDate)}</dd></div></dl> : <div class="mt-4 rounded-lg border border-dashed border-stone-300 p-5 text-center"><p class="font-semibold">No planning application has been added yet</p><a class="btn btn-secondary mt-3" href={`/projects/${project.id}/planning`}>Add planning record</a></div>}
      <form data-api-form data-action="/api/automation-jobs" data-method="POST" class="mt-4 border-t border-stone-100 pt-4">
        <input type="hidden" name="projectId" value={project.id} /><input type="hidden" name="type" value="PLANNING_APPLICATION" />{latestPlanning && <input type="hidden" name="planningApplicationId" value={latestPlanning.id} />}<button class="btn btn-secondary">Prepare planning job</button>
      </form>
    </section>

    <section id="building-warrant" class="panel scroll-mt-6 rounded-lg p-4">
      <div class="flex items-start justify-between gap-3"><div><h2 class="text-xl font-semibold">Building Warrant</h2><p class="mt-1 text-sm text-stone-500">Latest building warrant record</p></div><a class="text-sm font-semibold text-stone-600 hover:text-ink" href={`/projects/${project.id}/building-warrant`}>Manage</a></div>
      {latestWarrant ? <dl class="mt-4 grid gap-3 sm:grid-cols-2"><div><dt class="label">Status</dt><dd><span class="status-chip bg-moss/10 text-moss">{humanizeEnum(latestWarrant.status)}</span></dd></div><div><dt class="label">Reference</dt><dd class="font-semibold">{latestWarrant.warrantReference ?? 'Not set'}</dd></div><div><dt class="label">Type</dt><dd>{humanizeEnum(latestWarrant.warrantType)}</dd></div><div><dt class="label">Submitted</dt><dd>{formatDate(latestWarrant.submissionDate)}</dd></div><div><dt class="label">First response</dt><dd>{formatDate(latestWarrant.firstResponseTargetDate)}</dd></div><div><dt class="label">Completion certificate</dt><dd>{humanizeEnum(latestWarrant.completionCertificateStatus)}</dd></div></dl> : <div class="mt-4 rounded-lg border border-dashed border-stone-300 p-5 text-center"><p class="font-semibold">No building warrant has been added yet</p><a class="btn btn-secondary mt-3" href={`/projects/${project.id}/building-warrant`}>Add building warrant</a></div>}
      <form data-api-form data-action="/api/automation-jobs" data-method="POST" class="mt-4 border-t border-stone-100 pt-4">
        <input type="hidden" name="projectId" value={project.id} /><input type="hidden" name="type" value="BUILDING_WARRANT" />{latestWarrant && <input type="hidden" name="buildingWarrantApplicationId" value={latestWarrant.id} />}<button class="btn btn-secondary">Prepare warrant job</button>
      </form>
    </section>
  </div>

  <section id="deadlines" class="panel mt-6 scroll-mt-6 rounded-lg p-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><h2 class="text-xl font-semibold">Deadlines</h2><p class="mt-1 text-sm text-stone-500">{activeDeadlines.length} upcoming Â· {overdueCount} overdue Â· {completedDeadlines.length} completed</p></div><a class="btn btn-secondary" href={`/deadlines?projectId=${project.id}`}>Add or manage deadlines</a></div>
    {activeDeadlines.length ? <div class="mt-4 divide-y divide-stone-100 rounded-lg border border-stone-200">{activeDeadlines.slice(0, 6).map((deadline) => <a href={`/deadlines?projectId=${project.id}`} class="flex flex-col gap-2 px-4 py-3 hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between"><div><p class="font-semibold">{deadline.title}</p><p class="mt-1 text-xs text-stone-500">{humanizeEnum(deadline.type)} Â· {humanizeEnum(deadline.priority)}</p></div><span class={`status-chip ${isProjectDateOverdue(deadline.dueDate) ? 'bg-red-100 text-red-800' : 'bg-stone-100 text-stone-700'}`}>{formatDate(deadline.dueDate)}</span></a>)}</div> : <div class="mt-4 rounded-lg border border-dashed border-stone-300 p-6 text-center"><p class="font-semibold">No deadlines added yet</p><p class="mt-1 text-sm text-stone-500">Add an internal task or statutory date for this project.</p></div>}
  </section>

  <section id="automation" class="panel mt-6 scroll-mt-6 rounded-lg p-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><h2 class="text-xl font-semibold">Automation</h2><p class="mt-1 text-sm text-stone-500">Prepared desktop automation jobs for this project.</p></div><a class="btn btn-secondary" href={`/automation-jobs?projectId=${project.id}`}>View job queue</a></div>
    {automationJobs.length ? <div class="mt-4 space-y-3">{automationJobs.map((job) => <article class="rounded-lg border border-stone-200 p-3"><div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><p class="font-semibold">{job.title}</p><p class="mt-1 text-xs text-stone-500">{humanizeEnum(job.type)} Â· {formatDate(job.createdAt)}</p></div><div class="flex flex-wrap gap-2"><span class={`status-chip ${jobTone(job.status)}`}>{humanizeEnum(job.status)}</span>{job.status !== AutomationJobStatus.READY && job.status !== AutomationJobStatus.COMPLETED && job.status !== AutomationJobStatus.CANCELLED && <form data-api-form data-action={`/api/automation-jobs/${job.id}`} data-method="PATCH"><input type="hidden" name="status" value="READY" /><button class="btn btn-secondary">Mark ready</button></form>}{job.status !== AutomationJobStatus.CANCELLED && job.status !== AutomationJobStatus.COMPLETED && <form data-api-form data-action={`/api/automation-jobs/${job.id}`} data-method="PATCH" data-confirm="Cancel this automation job?"><input type="hidden" name="status" value="CANCELLED" /><button class="btn btn-secondary">Cancel</button></form>}</div></div><details class="mt-3"><summary class="cursor-pointer text-sm font-semibold text-stone-600">View snapshot</summary><div class="mt-3 grid gap-3 xl:grid-cols-2"><pre class="max-h-80 overflow-auto rounded-md bg-stone-50 p-3 text-xs">{JSON.stringify(job.dataSnapshot, null, 2)}</pre><pre class="max-h-80 overflow-auto rounded-md bg-stone-50 p-3 text-xs">{JSON.stringify(job.documentSnapshot, null, 2)}</pre></div></details></article>)}</div> : <div class="mt-4 rounded-lg border border-dashed border-stone-300 p-6 text-center"><p class="font-semibold">No desktop automation jobs prepared yet</p><p class="mt-1 text-sm text-stone-500">Use the project quick actions when the project data is ready.</p></div>}
  </section>

  <section id="notes" class="panel mt-6 scroll-mt-6 rounded-lg p-4">
    <h2 class="text-xl font-semibold">Notes</h2>
    <p class="mt-1 text-sm text-stone-500">Keep the client brief, useful email excerpts and manual source notes with the project.</p>
    <form data-api-form data-action={`/api/projects/${project.id}`} data-method="PATCH" class="mt-4">
      <label class="block"><span class="label">Project notes</span><textarea name="notes" rows="6" class="field" placeholder="Client brief, source notes and important context">{project.notes ?? ''}</textarea></label>
      <details class="mt-4 rounded-lg border border-stone-200 p-3">
        <summary class="cursor-pointer text-sm font-semibold">Edit project details</summary>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <label class="block md:col-span-2"><span class="label">Project name</span><input required name="name" value={project.name} class="field" /></label>
          <label class="block"><span class="label">Internal reference</span><input name="internalReference" value={project.internalReference ?? ''} class="field" /></label>
          <label class="block"><span class="label">Project type</span><input name="projectType" value={project.projectType ?? ''} class="field" /></label>
          <label class="block"><span class="label">Stage</span><select name="stage" class="field">{Object.values(ProjectStage).map((value) => <option value={value} selected={value === project.stage}>{humanizeEnum(value)}</option>)}</select></label>
          <label class="block"><span class="label">Status</span><select name="status" class="field">{Object.values(ProjectStatus).map((value) => <option value={value} selected={value === project.status}>{humanizeEnum(value)}</option>)}</select></label>
          <label class="block"><span class="label">Client</span><select name="clientId" class="field"><option value="">Not linked</option>{clients.map((client) => <option value={client.id} selected={client.id === project.clientId}>{client.name}</option>)}</select></label>
          <label class="block"><span class="label">Linked site</span><select name="siteId" class="field"><option value="">Not linked</option>{sites.map((site) => <option value={site.id} selected={site.id === project.siteId}>{site.addressLine1}, {site.postcode}</option>)}</select></label>
          <label class="block"><span class="label">Local authority</span><input name="localAuthority" value={project.localAuthority ?? ''} class="field" /></label>
          <label class="block"><span class="label">Manual site address</span><input name="siteAddress" value={project.siteAddress ?? ''} class="field" /></label>
        </div>
      </details>
      <div class="mt-4 flex flex-wrap items-center gap-3"><button class="btn btn-primary">Save project</button><span data-form-status class="text-sm text-stone-500"></span></div>
    </form>
    <details class="mt-5 border-t border-stone-100 pt-4"><summary class="cursor-pointer text-sm font-semibold text-red-700">Delete project</summary><p class="mt-3 text-sm text-stone-500">Deleting a project also removes its linked files, applications, deadlines and submission packages.</p><form data-api-form data-action={`/api/projects/${project.id}`} data-method="DELETE" data-redirect="/projects" data-confirm="Delete this project and its linked records?" class="mt-3"><button class="btn border border-red-200 bg-red-50 text-red-700 hover:bg-red-100">Delete project</button><span data-form-status class="ml-3 text-sm text-stone-500"></span></form></details>
  </section>
</AppShell>

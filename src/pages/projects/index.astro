---
import AppShell from '@/components/layout/AppShell.astro';
import LiveDataPanel from '@/components/live/LiveDataPanel';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

---
<AppShell title="Projects" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-semibold">Projects</h1>
      <p class="mt-1 text-sm text-stone-500">Manage project records, statutory trackers, files and deadlines.</p>
    </div>
    <a href="/projects/new" class="btn btn-primary">New project</a>
  </div>

  <LiveDataPanel client:idle variant="projects" endpoint="/api/projects" />
</AppShell>

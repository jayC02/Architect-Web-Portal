---
import { AutomationJobStatus, DeadlineStatus, DocumentStatus, DocumentType, ProjectStage, ProjectStatus, type Prisma } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { formatDate, humanizeEnum } from '@/lib/format';
import { getProjectNextAction, isProjectDateOverdue } from '@/lib/projects/next-action';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 120);
const rawStatus = Astro.url.searchParams.get('status');
const rawStage = Astro.url.searchParams.get('stage');
const rawScope = Astro.url.searchParams.get('scope');
const status = Object.values(ProjectStatus).includes(rawStatus as ProjectStatus) ? rawStatus as ProjectStatus : undefined;
const stage = Object.values(ProjectStage).includes(rawStage as ProjectStage) ? rawStage as ProjectStage : undefined;
const scope = rawScope === 'archived' || rawScope === 'all' ? rawScope : 'active';

const where: Prisma.ProjectWhereInput = { organisationId: auth.organisation.id };
if (status) where.status = status;
else if (scope === 'active') where.status = { not: ProjectStatus.ARCHIVED };
else if (scope === 'archived') where.status = ProjectStatus.ARCHIVED;
if (stage) where.stage = stage;
if (query) {
  where.OR = [
    { name: { contains: query, mode: 'insensitive' } },
    { internalReference: { contains: query, mode: 'insensitive' } },
    { siteAddress: { contains: query, mode: 'insensitive' } },
    { client: { is: { name: { contains: query, mode: 'insensitive' } } } },
    { site: { is: { addressLine1: { contains: query, mode: 'insensitive' } } } },
    { site: { is: { postcode: { contains: query, mode: 'insensitive' } } } },
  ];
}

const projects = await prisma.project.findMany({
  where,
  select: {
    id: true,
    name: true,
    internalReference: true,
    projectType: true,
    stage: true,
    status: true,
    siteAddress: true,
    updatedAt: true,
    client: { select: { name: true } },
    site: { select: { addressLine1: true, townCity: true, postcode: true } },
    documents: {
      where: { OR: [{ status: DocumentStatus.IN_REVIEW }, { type: DocumentType.LOCATION_PLAN }] },
      select: { id: true, status: true, type: true },
    },
    planningApplications: {
      orderBy: { updatedAt: 'desc' },
      take: 1,
      select: { status: true },
    },
    warrantApplications: {
      orderBy: { updatedAt: 'desc' },
      take: 1,
      select: { status: true },
    },
    deadlines: {
      where: { status: { notIn: [DeadlineStatus.COMPLETED, DeadlineStatus.CANCELLED] } },
      orderBy: { dueDate: 'asc' },
      take: 1,
      select: { id: true, title: true, dueDate: true, status: true, priority: true },
    },
    _count: {
      select: {
        documents: true,
        automationJobs: { where: { status: AutomationJobStatus.READY } },
      },
    },
  },
  orderBy: [{ updatedAt: 'desc' }, { name: 'asc' }],
  take: 200,
});

const projectRows = projects.map((project) => {
  const documentReviewCount = project.documents.filter((document) => document.status === DocumentStatus.IN_REVIEW).length;
  const hasLocationPlan = project.documents.some((document) => document.type === DocumentType.LOCATION_PLAN);
  const nextDeadline = project.deadlines[0] ?? null;
  const readyAutomationJobCount = project._count.automationJobs;
  const nextAction = getProjectNextAction({
    projectId: project.id,
    stage: project.stage,
    documentCount: project._count.documents,
    documentReviewCount,
    hasLocationPlan,
    planningStatus: project.planningApplications[0]?.status,
    warrantStatus: project.warrantApplications[0]?.status,
    readyAutomationJobCount,
    nextDeadline,
  });
  const siteSummary = project.site
    ? [project.site.addressLine1, project.site.postcode].filter(Boolean).join(', ')
    : project.siteAddress ?? 'No site address';

  return { ...project, documentReviewCount, readyAutomationJobCount, nextDeadline, nextAction, siteSummary };
});

const hasFilters = Boolean(query || status || stage || scope !== 'active');

const statusDotClass = (value: ProjectStatus) => {
  if (value === ProjectStatus.ACTIVE) return 'bg-moss';
  if (value === ProjectStatus.ON_HOLD) return 'bg-amber-500';
  if (value === ProjectStatus.COMPLETED) return 'bg-stone-400';
  return 'bg-stone-300';
};

const actionTextClass = (tone: string) => {
  if (tone === 'danger') return 'text-red-800';
  if (tone === 'warning') return 'text-amber-800';
  return 'text-ink';
};

const attentionTextClass = (count: number) => count > 0 ? 'font-semibold text-amber-800' : 'text-stone-500';
const automationTextClass = (count: number) => count > 0 ? 'font-semibold text-moss' : 'text-stone-500';
---
<AppShell title="Projects" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Projects</h1>
      <p class="mt-1 text-sm text-stone-500">A clean register of project records, deadlines and document actions.</p>
    </div>
    <a href="/projects/new" class="btn btn-primary">New project</a>
  </div>

  <form method="GET" class="panel mb-5 rounded-lg p-4">
    <div class="grid gap-3 lg:grid-cols-[minmax(280px,1fr)_180px_180px_170px_auto] lg:items-end">
      <label class="block">
        <span class="label">Search</span>
        <input name="q" value={query} class="field h-11" placeholder="Project, reference, client or address" />
      </label>
      <label class="block">
        <span class="label">Status</span>
        <select name="status" class="field h-11">
          <option value="">All statuses</option>
          {Object.values(ProjectStatus).map((value) => <option value={value} selected={status === value}>{humanizeEnum(value)}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="label">Stage</span>
        <select name="stage" class="field h-11">
          <option value="">All stages</option>
          {Object.values(ProjectStage).map((value) => <option value={value} selected={stage === value}>{humanizeEnum(value)}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="label">View</span>
        <select name="scope" class="field h-11">
          <option value="active" selected={scope === 'active'}>Active projects</option>
          <option value="archived" selected={scope === 'archived'}>Archived projects</option>
          <option value="all" selected={scope === 'all'}>All projects</option>
        </select>
      </label>
      <button class="btn btn-primary h-11 px-5">Apply</button>
    </div>
  </form>

  <div class="mb-3 flex items-center justify-between gap-3">
    <p class="text-sm text-stone-500">{projectRows.length} project{projectRows.length === 1 ? '' : 's'}</p>
    {hasFilters && <a class="text-sm font-semibold text-stone-600 hover:text-ink" href="/projects">Clear filters</a>}
  </div>

  {projectRows.length ? (
    <section class="panel overflow-hidden rounded-lg">
      <div class="hidden border-b border-stone-200 bg-stone-50/70 px-4 py-3 text-xs font-semibold uppercase text-stone-500 lg:grid lg:grid-cols-[minmax(260px,1.35fr)_minmax(150px,0.75fr)_130px_minmax(190px,1fr)_145px_150px_125px_90px] lg:items-center lg:gap-4">
        <span>Project</span>
        <span>Client</span>
        <span>Stage</span>
        <span>Next action</span>
        <span>Deadline</span>
        <span>Documents</span>
        <span>Automation</span>
        <span class="text-right">Action</span>
      </div>

      <div class="divide-y divide-stone-100">
        {projectRows.map((project) => {
          const deadlineIsOverdue = project.nextDeadline ? isProjectDateOverdue(project.nextDeadline.dueDate) : false;
          return (
            <article class="grid gap-4 px-4 py-4 transition hover:bg-stone-50/70 lg:grid-cols-[minmax(260px,1.35fr)_minmax(150px,0.75fr)_130px_minmax(190px,1fr)_145px_150px_125px_90px] lg:items-center lg:gap-4">
              <div class="min-w-0">
                <a href={`/projects/${project.id}`} class="block truncate text-base font-semibold text-ink hover:underline">{project.name}</a>
                <p class="mt-1 truncate text-sm text-stone-500">{project.siteSummary}{project.internalReference ? <span> &middot; Ref {project.internalReference}</span> : null}</p>
              </div>

              <div class="min-w-0">
                <p class="label lg:hidden">Client</p>
                <p class="truncate text-sm text-stone-700">{project.client?.name ?? 'Not linked'}</p>
              </div>

              <div>
                <p class="label lg:hidden">Status / stage</p>
                <div class="flex items-center gap-2 text-sm text-stone-700">
                  <span class={`h-2 w-2 shrink-0 rounded-full ${statusDotClass(project.status)}`}></span>
                  <span>{humanizeEnum(project.status)}</span>
                </div>
                <p class="mt-1 text-xs text-stone-500">{humanizeEnum(project.stage)}</p>
              </div>

              <div class="min-w-0">
                <p class="label lg:hidden">Next action</p>
                <a href={project.nextAction.href} class={`block truncate text-sm font-semibold hover:underline ${actionTextClass(project.nextAction.tone)}`}>{project.nextAction.label}</a>
                <p class="mt-1 text-xs text-stone-500">Based on current records</p>
              </div>

              <div>
                <p class="label lg:hidden">Deadline</p>
                {project.nextDeadline ? (
                  <>
                    <p class={`truncate text-sm font-medium ${deadlineIsOverdue ? 'text-red-800' : 'text-stone-700'}`}>{formatDate(project.nextDeadline.dueDate)}</p>
                    <p class="mt-1 truncate text-xs text-stone-500">{project.nextDeadline.title}</p>
                  </>
                ) : (
                  <p class="text-sm text-stone-500">No upcoming deadline</p>
                )}
              </div>

              <div>
                <p class="label lg:hidden">Documents</p>
                <a href={`/projects/${project.id}/files`} class={`text-sm hover:underline ${attentionTextClass(project.documentReviewCount)}`}>
                  {project.documentReviewCount > 0 ? `${project.documentReviewCount} need review` : 'All reviewed'}
                </a>
              </div>

              <div>
                <p class="label lg:hidden">Automation</p>
                <a href={`/automation-jobs?projectId=${project.id}`} class={`text-sm hover:underline ${automationTextClass(project.readyAutomationJobCount)}`}>
                  {project.readyAutomationJobCount > 0 ? `${project.readyAutomationJobCount} ready` : 'None ready'}
                </a>
              </div>

              <div class="lg:text-right">
                <a href={`/projects/${project.id}`} class="btn btn-secondary h-9 px-3">Open</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  ) : (
    <section class="panel rounded-lg p-8 text-center">
      <h2 class="text-xl font-semibold">{hasFilters ? 'No projects match these filters' : 'No projects yet'}</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm text-stone-500">{hasFilters ? 'Clear the filters or try a different search.' : 'Create your first project to organise documents, applications and deadlines.'}</p>
      <div class="mt-5 flex justify-center gap-2">
        {hasFilters && <a class="btn btn-secondary" href="/projects">Clear filters</a>}
        <a class="btn btn-primary" href="/projects/new">New project</a>
      </div>
    </section>
  )}
</AppShell>
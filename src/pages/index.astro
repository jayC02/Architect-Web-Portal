---
import HomePage from '@/components/home/HomePage.astro';
import { getSessionUser } from '@/lib/auth/session';
import { privateNoStore, setAstroCache } from '@/lib/server/cache-control';

export const prerender = false;

setAstroCache(Astro, privateNoStore);

if (await getSessionUser(Astro)) {
  return Astro.redirect('/dashboard');
}

// Keep older account-recovery and sign-in links working after separating the homepage.
const loginParameters = new URLSearchParams();
if (Astro.url.searchParams.get('reset') === 'success') loginParameters.set('reset', 'success');
if (Astro.url.searchParams.has('authError')) loginParameters.set('authError', Astro.url.searchParams.get('authError') ?? 'google_failed');
if (Astro.url.searchParams.has('returnTo')) loginParameters.set('returnTo', Astro.url.searchParams.get('returnTo') ?? '/dashboard');
if (loginParameters.size) return Astro.redirect(`/login?${loginParameters.toString()}`);
---
<HomePage />

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSessionUser } from '@/lib/auth/session';
import { privateNoStore, setAstroCache } from '@/lib/server/cache-control';

setAstroCache(Astro, privateNoStore);
const user = await getSessionUser(Astro as never);
if (user) return Astro.redirect('/dashboard');
---
<BaseLayout title="Architect Web Portal">
  <main class="min-h-screen bg-paper">
    <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_420px] lg:px-8 lg:py-20">
      <div class="flex flex-col justify-center">
        <p class="font-mono text-xs font-semibold uppercase text-moss">Practice operations</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-normal text-ink sm:text-6xl">Projects, documents and statutory deadlines in one workspace.</h1>
        <p class="mt-5 max-w-2xl text-lg text-stone-600">A private dashboard foundation for architecture practices managing clients, sites, planning applications, building warrants and project files.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/register">Create workspace</a>
          <a class="btn btn-secondary" href="/login">Sign in</a>
        </div>
      </div>
      <div class="panel rounded-lg p-5">
        <div class="border-b border-stone-200 pb-4">
          <p class="text-sm font-semibold">North Lane Extension</p>
          <p class="text-xs text-stone-500">Planning package preparation</p>
        </div>
        <div class="mt-4 space-y-3">
          {['Location plan missing', 'Planning decision target in 42 days', 'Building warrant not started', '6 recent documents'].map((item) => (
            <div class="flex items-center justify-between rounded-md bg-stone-50 px-3 py-3 text-sm">
              <span>{item}</span>
              <span class="font-mono text-xs text-moss">OPEN</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

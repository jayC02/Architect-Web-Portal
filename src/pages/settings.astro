---
import AppShell from '@/components/layout/AppShell.astro';
import LiveDataPanel from '@/components/live/LiveDataPanel';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');
---
<AppShell title="Settings" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <h1 class="text-3xl font-semibold">Settings</h1>
    <p class="mt-1 text-sm text-stone-500">Organisation configuration and integration foundations.</p>
  </div>
  <LiveDataPanel client:idle variant="settingsOverview" endpoint="/api/settings/overview" />
</AppShell>

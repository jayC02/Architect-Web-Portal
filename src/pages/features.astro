---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import ClosingCta from '@/components/marketing/ClosingCta.astro';
import ProjectsDemo from '@/components/marketing/demos/ProjectsDemo.astro';
import SortDemo from '@/components/marketing/demos/SortDemo.astro';
import ApplicationDemo from '@/components/marketing/demos/ApplicationDemo.astro';
import AgentDemo from '@/components/marketing/demos/AgentDemo.astro';
import TrackingDemo from '@/components/marketing/demos/TrackingDemo.astro';
import { payAsYouGoRate, lowestPlanMonthly, formatPrice } from '@/lib/marketing/plans';
import { marketingRoutes } from '@/lib/marketing/routes';
import { MANUAL_MIN, AUTO_MIN } from '@/components/home/scroll-story/story.js';
import { publicPageShort, setAstroCache } from '@/lib/server/cache-control';

export const prerender = true;
setAstroCache(Astro, publicPageShort);

// The five steps a job goes through, in order. Each has a demo to try.
const features = [
  {
    id: 'projects',
    name: 'Projects',
    does: 'Keeps every job in one record',
    title: 'Every job in one place, with what happens next.',
    body: 'Add the site, client and authority once. Each project shows its stage and the next thing to do, so anyone in the practice can pick it up.',
    points: ['Stage and next action beside every project', 'Clients, applicants and agents reused across jobs', 'Scottish address lookup for sites'],
    world: 'site',
  },
  {
    id: 'documents',
    name: 'Documents',
    does: 'Sorts your drawings automatically',
    title: 'Drop in the drawings. They sort themselves.',
    body: 'Upload a folder of PDFs, however they are named. AI reads each sheet and labels what it is, with its revision and paper size. Anything it is unsure of, it asks you.',
    points: ['Drawing type, number, revision and paper size read from the sheet', 'You confirm anything uncertain before it is used', 'File checks before anything is sent'],
    world: 'design',
  },
  {
    id: 'applications',
    name: 'Applications',
    does: 'Fills in planning, warrant and completion',
    title: 'Applications filled in from the record.',
    body: 'Pick planning permission, building warrant or completion certificate. Every field is filled from the project, the right drawings are attached and the building standards fee is worked out. You check it on one page.',
    points: ['Nothing typed twice between the three applications', 'Each value shows where it came from', 'Building standards fee calculated for you'],
    world: 'portal',
  },
  {
    id: 'agent',
    name: 'Desktop Agent',
    does: 'Completes the portal for you',
    title: 'The portal, completed for you.',
    body: 'The Agent runs on a licensed PC in your office. It signs in with your practice’s own account, keys in every field, uploads each document and stops at payment for you to approve.',
    points: ['Works from a frozen copy of the draft you approved', 'Live progress and an estimated finish time', 'Picks up where it left off if the portal times out'],
    world: 'automation',
  },
  {
    id: 'tracking',
    name: 'Tracking',
    does: 'Matches replies and decisions',
    title: 'Replies matched to the right application.',
    body: 'Connect Gmail and council and verifier emails are recognised, matched to the project and update its status. Deadlines go straight into your calendar.',
    points: ['Validation, further information and decisions tracked', 'Deadlines synced to Google Calendar', 'Daily checks for anything waiting on you'],
    world: 'tracking',
  },
] as const;

const extras = [
  { title: 'Deadlines that find you', body: 'Determination dates, warrant expiries and follow-ups gather in one list, synced to Google Calendar.', icon: '<path d="M4 7h16v13H4zM4 11h16M9 4v5M15 4v5"/>' },
  { title: 'Clients and sites', body: 'Every applicant, agent and address lives once and fills every application that needs it.', icon: '<path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>' },
  { title: 'U-value calculator', body: 'Build up walls, roofs and floors and export a report to attach to the warrant.', icon: '<path d="M5 4h14v16H5zM5 9h14M5 14h14M10 4v16"/>' },
  { title: 'Xero overview', body: 'Read-only invoices and fee positions per project, without leaving the workspace.', icon: '<path d="M4 19V5M4 19h16M8 15l4-4 3 3 5-6"/>' },
  { title: 'Roles and permissions', body: 'Owners, architects and assistants see and change only what their role allows.', icon: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M17 11l2 2 3-4"/>' },
  { title: 'Audit history', body: 'Every prepared draft, submission and reply is recorded with who did it and when.', icon: '<path d="M12 7v5l3 2"/><circle cx="12" cy="12" r="8"/>' },
];

const connections = [
  { title: 'eDevelopment portal', body: 'The Scottish service for planning and building standards. The Agent signs in with your practice’s own account.' },
  { title: 'Gmail', body: 'Council and verifier emails are matched to the right application and update its status.' },
  { title: 'Google Calendar', body: 'Determination dates, warrant expiries and follow-ups appear in your calendar.' },
  { title: 'Xero', body: 'Read-only invoices and fee positions per project, without leaving the workspace.' },
];
---
<MarketingLayout
  title="Features | Architect Pro"
  description="Project records, AI document sorting, planning, building warrant and completion certificate preparation, a desktop Agent that completes the portal, and tracking of every reply. Try each one."
  world="site"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Features</p>
        <h1>One project record. Every application.</h1>
        <p class="lede">Architect Pro takes a job from first drawing to completion certificate. Each step below has a working example you can try.</p>
        <div class="actions">
          <a class="button primary" href={marketingRoutes.demo}>Book a demo</a>
          <a class="button" href={marketingRoutes.pricing}>See pricing</a>
        </div>
      </div>
      <nav class="feature-index" aria-label="Features on this page">
        <ol>
          {features.map((feature) => (
            <li>
              <a href={`#${feature.id}`}>
                <b>{feature.name}</b>
                <span>{feature.does}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  {features.map((feature, index) => (
    <section class:list={['section', 'feature', { flip: index % 2 === 1 }]} id={feature.id} aria-labelledby={`${feature.id}-title`}>
      <div class="wrap feature-grid">
        <div class="feature-copy">
          <p class="chapter-index"><b>{String(index + 1).padStart(2, '0')}</b>{feature.name}</p>
          <h2 id={`${feature.id}-title`}>{feature.title}</h2>
          <p>{feature.body}</p>
          <ul class="ticks">{feature.points.map((point) => <li>{point}</li>)}</ul>
        </div>
        <div class:list={['world', feature.world, 'feature-demo']}>
          {feature.id === 'projects' && <ProjectsDemo />}
          {feature.id === 'documents' && <SortDemo />}
          {feature.id === 'applications' && <ApplicationDemo />}
          {feature.id === 'agent' && <AgentDemo />}
          {feature.id === 'tracking' && <TrackingDemo />}
        </div>
      </div>
    </section>
  ))}

  <section class="section tint" aria-labelledby="also-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="also-title">Everything else a practice runs on.</h2>
        <p>The working tools around the applications, built for how Scottish practices actually run projects.</p>
      </div>
      <div class="grid three">
        {extras.map((item) => (
          <article class="card">
            <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} aria-hidden="true" /></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="connect-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="connect-title">Works with the accounts you already use.</h2>
        <p>Connect each one from your workspace settings. Architect Pro asks only for the access each feature needs, and you can disconnect at any time.</p>
      </div>
      <div class="connects">
        {connections.map((item) => (
          <article class="connect">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bordered" aria-labelledby="time-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="time-title">Time back on every project.</h2>
        <p>The same three applications, keyed in by hand or prepared and submitted for you.</p>
      </div>
      <div class="stats">
        <div class="stat"><b class="num">{MANUAL_MIN}<small>min</small></b><span>Typical time to key planning, warrant and completion certificate into the portal by hand.</span></div>
        <div class="stat"><b class="num">{AUTO_MIN}<small>min</small></b><span>Your time reviewing and approving the same three with Architect Pro.</span></div>
        <div class="stat"><b class="num">0</b><span>Fields re-typed from one application to the next.</span></div>
      </div>
      <p class="footnote">Illustrative figures from the homepage story. Actual times vary by project and portal availability. Planning and building standards decisions rest with the relevant authority.</p>
      <div class="price-band">
        <p>Pay as you go at <b>{formatPrice(payAsYouGoRate)}</b> an application, or plans with applications included from <b>{formatPrice(lowestPlanMonthly)}</b> a month.</p>
        <a class="button dark" href={marketingRoutes.pricing}>See pricing</a>
      </div>
    </div>
  </section>

  <ClosingCta />
</MarketingLayout>

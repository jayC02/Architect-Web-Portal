---
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const sites = await prisma.site.findMany({
  where: { organisationId: auth.organisation.id },
  include: { _count: { select: { projects: true } } },
  orderBy: { updatedAt: 'desc' },
});
---
<AppShell title="Sites" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <h1 class="text-3xl font-semibold">Sites</h1>
    <p class="mt-1 text-sm text-stone-500">Reusable site profiles for project addresses and authorities.</p>
  </div>
  <section class="grid gap-6 xl:grid-cols-[420px_1fr]">
    <form data-api-form data-action="/api/sites" data-method="POST" data-redirect="reload" class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Add site</h2>
      <div class="mt-4 space-y-4">
        <label class="block"><span class="label">Address line 1</span><input required name="addressLine1" class="field" /></label>
        <label class="block"><span class="label">Address line 2</span><input name="addressLine2" class="field" /></label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="label">Town/city</span><input required name="townCity" class="field" /></label>
          <label class="block"><span class="label">Postcode</span><input required name="postcode" class="field" /></label>
        </div>
        <label class="block"><span class="label">Local authority</span><input name="localAuthority" class="field" /></label>
        <label class="block"><span class="label">Notes</span><textarea name="notes" rows="3" class="field"></textarea></label>
      </div>
      <button class="btn btn-primary mt-4 w-full">Save site</button>
      <p data-form-status class="mt-3 text-sm text-stone-500"></p>
    </form>

    <div class="panel overflow-hidden rounded-lg">
      <table class="w-full min-w-[680px] border-collapse">
        <thead class="table-head"><tr><th class="px-4 py-3">Site</th><th class="px-4 py-3">Authority</th><th class="px-4 py-3">Projects</th></tr></thead>
        <tbody>
          {sites.map((site) => (
            <tr>
              <td class="table-cell"><p class="font-semibold">{site.addressLine1}</p><p class="text-xs text-stone-500">{site.townCity}, {site.postcode}</p></td>
              <td class="table-cell">{site.localAuthority ?? 'Not set'}</td>
              <td class="table-cell">{site._count.projects}</td>
            </tr>
          ))}
          {!sites.length && <tr><td colspan="3" class="px-4 py-10 text-center text-sm text-stone-500">No sites yet.</td></tr>}
        </tbody>
      </table>
    </div>
  </section>
</AppShell>

---
import { AutomationJobStatus, AutomationJobType, DocumentStatus, DocumentType } from '@prisma/client';
import { AlertTriangle, ArrowLeft, CheckCircle2, FileText, FolderOpen } from 'lucide-react';
import { ExistingAutomationJobButton } from '@/components/automation/AutomationLaunchButton';
import AppShell from '@/components/layout/AppShell.astro';
import { clientDisplayName } from '@/lib/clients/display';
import { prisma } from '@/lib/db/prisma';
import { TYPE_OF_WORK_DEFINITIONS } from '@/lib/projects/type-of-work';
import { requirePageAuth } from '@/lib/server/page-auth';
import { automationJobSnapshotV2Schema } from '@/lib/validation/automation-job';
import { applicationPreparationDraftSchema } from '@/lib/validation/document-intelligence';
import { buildApplicationPreparationDraft } from '@/server/services/application-preparation.service';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');
const id = Astro.params.id;
if (!id) return Astro.redirect('/automation-jobs');
const job = await prisma.automationJob.findFirst({
  where: { id, organisationId: auth.organisation.id },
  include: {
    project: { include: { client: true, site: true } },
    createdBy: { select: { name: true, email: true } },
  },
});
if (!job) return Astro.redirect('/automation-jobs');

const parsed = automationJobSnapshotV2Schema.safeParse(job.dataSnapshot);
const snapshot = parsed.success ? parsed.data : null;
const savedDraft = applicationPreparationDraftSchema.safeParse(job.preparationDraft);
const draft = snapshot
  ? savedDraft.success ? savedDraft.data : await buildApplicationPreparationDraft(job.id, auth.organisation.id)
  : null;
const [defaults, documents, certifierPresets] = await Promise.all([
  prisma.organisationDefaults.findUnique({ where: { organisationId: auth.organisation.id } }),
  prisma.projectDocument.findMany({
    where: { organisationId: auth.organisation.id, projectId: job.projectId },
    orderBy: [{ status: 'asc' }, { createdAt: 'desc' }],
  }),
  job.type === AutomationJobType.BUILDING_WARRANT
    ? prisma.organisationCertifierPreset.findMany({
        where: { organisationId: auth.organisation.id },
        orderBy: [{ isDefault: 'desc' }, { displayName: 'asc' }],
      })
    : Promise.resolve([]),
]);

const appLabel = job.type === AutomationJobType.BUILDING_WARRANT
  ? 'Building Warrant'
  : job.type === AutomationJobType.HOUSEHOLDER_PLANNING ? 'Householder Application' : 'Planning Application';
const currentApplicant = job.project.client;
const currentSite = job.project.site;
const suggestion = (key: string, current: unknown): string | number => {
  if (current !== null && current !== undefined && String(current).trim() !== '') {
    return typeof current === 'number' ? current : String(current);
  }
  const field = draft?.fields[key];
  if (field?.status !== 'suggested' || field.value === null) return '';
  return typeof field.value === 'number' ? field.value : String(field.value);
};
const fieldNote = (key: string) => {
  const field = draft?.fields[key];
  if (!field || !field.sources.length) return null;
  const source = field.sources[0];
  const location = `${source.filename}${source.page ? `, page ${source.page}` : ''}`;
  return field.status === 'conflict'
    ? `Conflicting information found in ${location}: ${source.evidence}`
    : `Found in ${location}`;
};
const fieldSource = (key: string) => draft?.fields[key]?.sources[0] ?? null;
const human = (value: string) => value.toLowerCase().replaceAll('_', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const attentionDocumentIds = new Set(draft?.documentSummary.unresolvedClassifications ?? []);
const blockers = snapshot?.preflight.missing.length ?? 0;
const isReady = job.status === AutomationJobStatus.READY && snapshot?.preflight.status === 'READY';
const canEdit = !new Set<AutomationJobStatus>([
  AutomationJobStatus.CLAIMED,
  AutomationJobStatus.IN_PROGRESS,
  AutomationJobStatus.AWAITING_PORTAL_REVIEW,
  AutomationJobStatus.COMPLETED,
]).has(job.status);
const preparation = snapshot?.buildingWarrant?.unusualAnswers;
const planning = snapshot?.planning?.answers;
const documentTypes = Object.values(DocumentType);
const buildingWarrantConfirmations = preparation ? [
  { name: 'applicantIsOwner', label: 'Is the applicant the owner?', value: preparation.applicantIsOwner },
  { name: 'applicationIsStaged', label: 'Is the application staged?', value: preparation.applicationIsStaged },
  {
    name: 'intendedLifeFiveYearsOrLess',
    label: 'Is the intended life of the building five years or less?',
    value: preparation.intendedLifeFiveYearsOrLess,
  },
  {
    name: 'fireAndRescueServiceEnforcingAuthority',
    label: 'Is Fire and Rescue Service the enforcing authority?',
    value: preparation.fireAndRescueServiceEnforcingAuthority,
  },
  {
    name: 'listedBuildingOrConservationArea',
    label: 'Is the building listed or in a conservation area?',
    value: preparation.listedBuildingOrConservationArea,
  },
  {
    name: 'otherHistoricalImportance',
    label: 'Does the building have other historical importance?',
    value: preparation.otherHistoricalImportance,
  },
  {
    name: 'scottishMinistersRelaxationDirection',
    label: 'Is the work subject to a Scottish Ministers relaxation direction?',
    value: preparation.scottishMinistersRelaxationDirection,
  },
  {
    name: 'dangerousBuildingNotice',
    label: 'Is the building subject to a dangerous building notice?',
    value: preparation.dangerousBuildingNotice,
  },
  {
    name: 'approvedCertifierOfConstruction',
    label: 'Will an approved certifier of construction be used?',
    value: preparation.approvedCertifierOfConstruction,
  },
  {
    name: 'coveredBySTAS',
    label: 'Are the proposals covered by STAS?',
    value: preparation.coveredBySTAS,
  },
  {
    name: 'restrictPublicInspection',
    label: 'Should any proposal information be restricted from public inspection?',
    value: preparation.restrictPublicInspection,
  },
] : [];
const suggestedClientName = currentApplicant
  ? clientDisplayName(currentApplicant)
  : String(
      suggestion('applicant.companyName', null)
      || [suggestion('applicant.firstName', null), suggestion('applicant.lastName', null)].filter(Boolean).join(' '),
    );
---
<AppShell title={`Prepare ${job.project.name}`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mx-auto max-w-6xl">
    <a class="inline-flex items-center gap-2 text-sm font-semibold text-stone-600 hover:text-ink" href="/automation-jobs">
      <ArrowLeft size={16} />Back to desktop automation
    </a>
    <header class="mt-5 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-stone-500">Application preparation</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight">Prepare {appLabel}</h1>
        <p class="mt-2 text-sm text-stone-600">{job.project.name}{job.project.internalReference ? ` · Ref ${job.project.internalReference}` : ''}</p>
      </div>
      <a class="btn btn-secondary inline-flex items-center gap-2" href={`/projects/${job.projectId}`}><FolderOpen size={16} />Open project</a>
    </header>

    {!snapshot || !draft ? (
      <section class="panel mt-6 rounded-lg p-6">
        <h2 class="font-semibold">Manual desktop review available</h2>
        <p class="mt-2 text-sm text-stone-600">This older job cannot use the consolidated preparation page. It remains available through the desktop app.</p>
      </section>
    ) : (
      <form
        class="mt-6 grid gap-5"
        enctype="multipart/form-data"
        data-api-form
        data-field-errors
        data-action={`/api/automation-jobs/${job.id}/preparation`}
        data-method="PATCH"
      >
        <section class="panel rounded-lg p-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h2 class="text-xl font-semibold">Information prepared from your documents</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-stone-600">
                We analysed {draft.analysedDocumentCount} document{draft.analysedDocumentCount === 1 ? '' : 's'} and combined the results with your existing project, client, site and practice information.
              </p>
            </div>
            <div class:list={['flex items-center gap-2 text-sm font-semibold', blockers ? 'text-amber-800' : 'text-emerald-800']}>
              {blockers ? <AlertTriangle size={17} /> : <CheckCircle2 size={17} />}
              {blockers ? `${blockers} detail${blockers === 1 ? '' : 's'} need attention` : 'Prepared'}
            </div>
          </div>
          {draft.failedDocumentCount > 0 && (
            <p class="mt-4 border-l-2 border-amber-500 pl-3 text-sm text-stone-600">
              {draft.failedDocumentCount} document{draft.failedDocumentCount === 1 ? '' : 's'} could not be fully analysed. Their classifications can still be corrected below.
            </p>
          )}
        </section>

        <section class="panel rounded-lg p-6">
          <h2 class="text-lg font-semibold">Project and site</h2>
          <p class="mt-1 text-sm text-stone-600">Corrections here update the Project and linked Site records.</p>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            <label class="block"><span class="label">Project name</span><input class="field" name="projectName" required value={suggestion('project.title', job.project.name)} />{fieldNote('project.title') && <a class="mt-1 block text-xs text-amber-700 hover:underline" href={`/api/documents/${fieldSource('project.title')?.documentId}`} target="_blank" rel="noopener">{fieldNote('project.title')}</a>}</label>
            <label class="block"><span class="label">Type of work</span><select class="field" name="projectType">{TYPE_OF_WORK_DEFINITIONS.map((item) => <option value={item.key} selected={item.key === job.project.projectType}>{item.label}</option>)}</select></label>
            <label class="block md:col-span-2"><span class="label">Address line 1</span><input class="field" name="siteAddressLine1" required value={suggestion('site.addressLine1', currentSite?.addressLine1 ?? job.project.siteAddress)} />{fieldNote('site.addressLine1') && <a class="mt-1 block text-xs text-amber-700 hover:underline" href={`/api/documents/${fieldSource('site.addressLine1')?.documentId}`} target="_blank" rel="noopener">{fieldNote('site.addressLine1')}</a>}</label>
            <label class="block"><span class="label">Address line 2</span><input class="field" name="siteAddressLine2" value={suggestion('site.addressLine2', currentSite?.addressLine2)} /></label>
            <label class="block"><span class="label">Town or city</span><input class="field" name="siteTownCity" required value={suggestion('site.townCity', currentSite?.townCity)} /></label>
            <label class="block"><span class="label">Postcode</span><input class="field" name="sitePostcode" required value={suggestion('site.postcode', currentSite?.postcode)} /></label>
            <label class="block"><span class="label">Local authority</span><input class="field" name="siteLocalAuthority" value={suggestion('site.localAuthority', currentSite?.localAuthority ?? job.project.localAuthority)} /></label>
          </div>
        </section>

        <section class="panel rounded-lg p-6">
          <h2 class="text-lg font-semibold">Applicant</h2>
          <p class="mt-1 text-sm text-stone-600">Saving updates the linked Client. If none is linked, a complete Client record is created here.</p>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            <label class="block"><span class="label">Title</span><input class="field" name="clientTitle" value={suggestion('applicant.title', currentApplicant?.title)} /></label>
            <label class="block"><span class="label">Company name</span><input class="field" name="clientCompanyName" value={suggestion('applicant.companyName', currentApplicant?.companyName)} /></label>
            <label class="block"><span class="label">First name</span><input class="field" name="clientFirstName" value={suggestion('applicant.firstName', currentApplicant?.firstName)} /></label>
            <label class="block"><span class="label">Last name</span><input class="field" name="clientLastName" value={suggestion('applicant.lastName', currentApplicant?.lastName)} /></label>
            <label class="block"><span class="label">Email</span><input class="field" name="clientEmail" type="email" value={suggestion('applicant.email', currentApplicant?.email)} /></label>
            <label class="block"><span class="label">Phone</span><input class="field" name="clientPhone" value={suggestion('applicant.phone', currentApplicant?.phone)} /></label>
            <label class="block md:col-span-2"><span class="label">Address line 1</span><input class="field" name="clientAddressLine1" value={suggestion('applicant.addressLine1', currentApplicant?.addressLine1 ?? currentApplicant?.address)} /></label>
            <label class="block"><span class="label">Town or city</span><input class="field" name="clientTownCity" value={suggestion('applicant.townCity', currentApplicant?.townCity)} /></label>
            <label class="block"><span class="label">Postcode</span><input class="field" name="clientPostcode" value={suggestion('applicant.postcode', currentApplicant?.postcode)} /></label>
            <label class="block"><span class="label">Country</span><input class="field" name="clientCountry" value={suggestion('applicant.country', currentApplicant?.country ?? 'United Kingdom')} /></label>
          </div>
        </section>

        <section class="panel rounded-lg p-6">
          <h2 class="text-lg font-semibold">Agent and practice</h2>
          <p class="mt-1 text-sm text-stone-600">These details are reused as your organisation defaults for future applications.</p>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            <label class="block md:col-span-2"><span class="label">Practice name</span><input class="field" name="practiceName" value={suggestion('agent.practiceName', defaults?.practiceName ?? auth.organisation.name)} /></label>
            <label class="block"><span class="label">First name</span><input class="field" name="agentFirstName" value={suggestion('agent.firstName', defaults?.agentFirstName)} /></label>
            <label class="block"><span class="label">Last name</span><input class="field" name="agentLastName" value={suggestion('agent.lastName', defaults?.agentLastName)} /></label>
            <label class="block"><span class="label">Email</span><input class="field" name="agentEmail" type="email" value={suggestion('agent.email', defaults?.agentEmail)} /></label>
            <label class="block"><span class="label">Phone</span><input class="field" name="agentPhone" value={suggestion('agent.phone', defaults?.agentPhone)} /></label>
            <label class="block md:col-span-2"><span class="label">Address line 1</span><input class="field" name="agentAddressLine1" value={suggestion('agent.addressLine1', defaults?.agentAddressLine1)} /></label>
            <label class="block"><span class="label">Address line 2</span><input class="field" name="agentAddressLine2" value={suggestion('agent.addressLine2', defaults?.agentAddressLine2)} /></label>
            <label class="block"><span class="label">Town or city</span><input class="field" name="agentTownCity" value={suggestion('agent.townCity', defaults?.agentTownCity)} /></label>
            <label class="block"><span class="label">Postcode</span><input class="field" name="agentPostcode" value={suggestion('agent.postcode', defaults?.agentPostcode)} /></label>
            <label class="block"><span class="label">Country</span><input class="field" name="agentCountry" value={suggestion('agent.country', defaults?.agentCountry ?? 'United Kingdom')} /></label>
          </div>
        </section>

        <section class="panel rounded-lg p-6">
          <h2 class="text-lg font-semibold">Proposed application</h2>
          <p class="mt-1 text-sm text-stone-600">Review the prepared description before it is sent to the desktop app.</p>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            <label class="block md:col-span-2"><span class="label">Description of work</span><textarea class="field" name="description" rows="4" required minlength="12">{suggestion('application.descriptionOfWork', snapshot.buildingWarrant?.description ?? snapshot.planning?.description)}</textarea>{fieldNote('application.descriptionOfWork') && <a class="mt-1 block text-xs text-emerald-700 hover:underline" href={`/api/documents/${fieldSource('application.descriptionOfWork')?.documentId}`} target="_blank" rel="noopener">{fieldNote('application.descriptionOfWork')}</a>}</label>
            {snapshot.buildingWarrant && <>
              <label class="block"><span class="label">Type of Work</span><select class="field" name="presetKey">{TYPE_OF_WORK_DEFINITIONS.map((item) => <option value={item.key} selected={item.key === snapshot.buildingWarrant?.presetKey}>{item.label}</option>)}</select></label>
              <label class="block"><span class="label">Estimated value</span><input class="field" name="estimatedValue" type="number" min="0" step="0.01" value={suggestion('application.estimatedValue', snapshot.buildingWarrant.estimatedValue)} /></label>
              <label class="block"><span class="label">Current use</span><input class="field" name="currentUse" value={suggestion('application.currentUse', snapshot.buildingWarrant.currentUse)} /></label>
              <label class="block"><span class="label">Proposed use</span><input class="field" name="proposedUse" value={suggestion('application.proposedUse', snapshot.buildingWarrant.proposedUse)} /></label>
              <label class="block md:col-span-2"><span class="label">Approved certifier of design</span><select class="field" name="selectedCertifierPresetId"><option value="">No design certificate selected</option>{certifierPresets.map((preset) => <option value={preset.id} selected={preset.id === snapshot.buildingWarrant?.certifier?.presetId}>{preset.displayName}</option>)}</select></label>
            </>}
          </div>
        </section>

        <section class="panel rounded-lg p-6">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div><h2 class="text-lg font-semibold">Documents</h2><p class="mt-1 text-sm text-stone-600">Correct classifications here. The original files are never changed.</p></div>
            <label class="inline-flex items-center gap-2 text-sm font-medium"><input id="attention-only" type="checkbox" checked />Needs attention only</label>
          </div>
          <div class="mt-5 overflow-hidden rounded-lg border border-stone-200">
            <div class="hidden grid-cols-[minmax(0,1fr)_15rem_8rem] gap-4 border-b border-stone-200 bg-stone-50 px-4 py-3 text-xs font-semibold uppercase text-stone-500 md:grid">
              <span>Document</span><span>Type</span><span>Status</span>
            </div>
            {documents.map((document) => {
              const needsAttention = attentionDocumentIds.has(document.id) || document.status !== DocumentStatus.APPROVED;
              return (
                <div class="document-row grid gap-3 border-b border-stone-100 px-4 py-4 last:border-b-0 md:grid-cols-[minmax(0,1fr)_15rem_8rem] md:items-center" data-needs-attention={String(needsAttention)}>
                  <div class="flex min-w-0 gap-3">
                    <FileText size={18} className="mt-0.5 shrink-0 text-stone-500" />
                    <div class="min-w-0">
                      <a class="block truncate text-sm font-semibold hover:underline" href={`/api/documents/${document.id}`} target="_blank" rel="noopener">{document.originalName}</a>
                      <input type="hidden" name="documentId" value={document.id} />
                      <div class="mt-2 grid gap-2 sm:grid-cols-2">
                        <input class="field !py-2 text-sm" name="documentTitle" placeholder="Drawing title" value={document.drawingTitle ?? ''} />
                        <input class="field !py-2 text-sm" name="documentRevision" placeholder="Revision" value={document.revision ?? ''} />
                      </div>
                    </div>
                  </div>
                  <select class="field" name="documentType">{documentTypes.map((type) => <option value={type} selected={type === document.type}>{human(type)}</option>)}</select>
                  <span class:list={['text-sm font-medium', needsAttention ? 'text-amber-800' : 'text-stone-600']}>{needsAttention ? 'Needs review' : 'Prepared'}</span>
                </div>
              );
            })}
            {!documents.length && <p class="px-4 py-8 text-center text-sm text-stone-500">No documents are linked to this project yet.</p>}
          </div>
        </section>

        <section class="panel rounded-lg p-6">
          <h2 class="text-lg font-semibold">Confirmations</h2>
          <p class="mt-1 text-sm text-stone-600">
            {snapshot.buildingWarrant
              ? 'Review the application answers that control Building Warrant portal questions.'
              : 'Review the Householder planning questions before opening the desktop app.'}
          </p>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            {snapshot.buildingWarrant ? <>
              {buildingWarrantConfirmations.map((question) => (
                <label class="block">
                  <span class="label">{question.label}</span>
                  <select class="field" name={question.name}>
                    <option value="true" selected={question.value}>Yes</option>
                    <option value="false" selected={!question.value}>No</option>
                  </select>
                </label>
              ))}
              <input type="hidden" name="soleOwner" value="false" /><input type="hidden" name="agriculturalHolding" value="false" />
            </> : <>
              <label class="block"><span class="label">Is the applicant the sole owner of all land?</span><select class="field" name="soleOwner"><option value="true" selected={planning?.soleOwner === true}>Yes</option><option value="false" selected={planning?.soleOwner === false}>No</option></select></label>
              <label class="block"><span class="label">Is any land part of an agricultural holding?</span><select class="field" name="agriculturalHolding"><option value="false" selected={planning?.agriculturalHolding === false}>No</option><option value="true" selected={planning?.agriculturalHolding === true}>Yes</option></select></label>
              <label class="block"><span class="label">Discussed with planning authority?</span><select class="field" name="discussedWithPlanningAuthority"><option value="false" selected={!planning?.discussedWithPlanningAuthority}>No</option><option value="true" selected={planning?.discussedWithPlanningAuthority}>Yes</option></select></label>
              <label class="block"><span class="label">Trees on or adjacent to site?</span><select class="field" name="treesOnOrAdjacentToSite"><option value="false" selected={!planning?.treesOnOrAdjacentToSite}>No</option><option value="true" selected={planning?.treesOnOrAdjacentToSite}>Yes</option></select></label>
              <label class="block"><span class="label">New or altered vehicle access?</span><select class="field" name="newOrAlteredVehicleAccess" data-vehicle-access><option value="false" selected={!planning?.newOrAlteredVehicleAccess}>No</option><option value="true" selected={planning?.newOrAlteredVehicleAccess}>Yes</option></select></label>
              <div class="grid gap-4 sm:grid-cols-2 md:col-span-2" data-parking-fields hidden={!planning?.newOrAlteredVehicleAccess}>
                <label class="block"><span class="label">Current parking spaces</span><input class="field" type="number" min="0" max="999" name="currentParkingSpaces" value={planning?.currentParkingSpaces ?? ''} /></label>
                <label class="block"><span class="label">Proposed parking spaces</span><input class="field" type="number" min="0" max="999" name="proposedParkingSpaces" value={planning?.proposedParkingSpaces ?? ''} /></label>
              </div>
              <input type="hidden" name="applicantIsOwner" value="false" /><input type="hidden" name="applicationIsStaged" value="false" /><input type="hidden" name="approvedCertifierOfConstruction" value="false" />
            </>}
          </div>
        </section>

        <section class="panel rounded-lg p-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-lg font-semibold">{isReady ? 'Ready for desktop' : blockers ? `${blockers} detail${blockers === 1 ? '' : 's'} need attention` : 'Save to validate readiness'}</h2>
              <p class="mt-1 text-sm text-stone-600">Saving updates the linked records and validates the prepared desktop snapshot automatically.</p>
              <p data-form-status class="mt-2 text-sm text-stone-500"></p>
            </div>
            <div class="flex flex-wrap gap-2">
              {canEdit && <button class="btn btn-primary" type="submit">{isReady ? 'Save application details' : 'Save application details'}</button>}
              {isReady && <ExistingAutomationJobButton client:load jobId={job.id} label="Open in desktop app" />}
            </div>
          </div>
        </section>
      </form>
    )}
  </div>
  <script>
    const filter = document.querySelector('#attention-only');
    const updateDocumentRows = () => {
      const attentionOnly = filter instanceof HTMLInputElement && filter.checked;
      document.querySelectorAll('.document-row').forEach((row) => {
        if (!(row instanceof HTMLElement)) return;
        row.hidden = attentionOnly && row.dataset.needsAttention !== 'true';
      });
    };
    filter?.addEventListener('change', updateDocumentRows);
    updateDocumentRows();

    const vehicleAccess = document.querySelector('[data-vehicle-access]');
    const parkingFields = document.querySelector('[data-parking-fields]');
    const updateParkingFields = () => {
      if (!(vehicleAccess instanceof HTMLSelectElement) || !(parkingFields instanceof HTMLElement)) return;
      const visible = vehicleAccess.value === 'true';
      parkingFields.hidden = !visible;
      parkingFields.querySelectorAll('input').forEach((input) => {
        input.required = visible;
      });
    };
    vehicleAccess?.addEventListener('change', updateParkingFields);
    updateParkingFields();
  </script>
</AppShell>

---
import AppShell from '@/components/layout/AppShell.astro';
import LiveDataPanel from '@/components/live/LiveDataPanel';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');
---
<AppShell title="Documents" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold">Documents</h1>
      <p class="mt-1 text-sm text-stone-500">Project folders, batch upload and automatic sorting for the whole practice.</p>
    </div>
    <nav class="flex flex-wrap gap-2 text-sm">
      <a href="/documents/upload" class="btn btn-primary">Upload documents</a>
      <a href="#project-folders" class="btn btn-secondary">Project folders</a>
    </nav>
  </div>

  <LiveDataPanel client:idle variant="documentsHub" endpoint="/api/documents/hub" />
</AppShell>

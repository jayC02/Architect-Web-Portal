---
import { DocumentType } from '@prisma/client';
import type { Prisma } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { documentGroupType, documentTypeLabel, preferredDocumentTypes } from '@/lib/document-categories';
import { formatBytes, formatDate } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';
import { withPerf } from '@/lib/utils/perf';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const search = Astro.url.searchParams.get('q')?.trim() ?? '';
const sort = Astro.url.searchParams.get('sort') ?? 'recent';
const typeFilter = Astro.url.searchParams.get('type') ?? '';
const show = Astro.url.searchParams.get('show') ?? '';
const documentSortOptions = new Set(['recent', 'oldest', 'name', 'largest', 'smallest']);
const selectedSort = documentSortOptions.has(sort) ? sort : 'recent';
const selectedType = preferredDocumentTypes.some((type) => type === typeFilter) ? typeFilter as DocumentType : '';
const expandedSection = show === 'recent' || show === 'all' ? show : '';
const orderBy = (() => {
  if (selectedSort === 'oldest') return { createdAt: 'asc' } satisfies Prisma.ProjectDocumentOrderByWithRelationInput;
  if (selectedSort === 'name') return { originalName: 'asc' } satisfies Prisma.ProjectDocumentOrderByWithRelationInput;
  if (selectedSort === 'largest') return { sizeBytes: 'desc' } satisfies Prisma.ProjectDocumentOrderByWithRelationInput;
  if (selectedSort === 'smallest') return { sizeBytes: 'asc' } satisfies Prisma.ProjectDocumentOrderByWithRelationInput;
  return { createdAt: 'desc' } satisfies Prisma.ProjectDocumentOrderByWithRelationInput;
})();

const typeFilterValues = selectedType
  ? selectedType === DocumentType.PROPOSED_DRAWING
    ? [DocumentType.PROPOSED_DRAWING, DocumentType.SITE_PLAN, DocumentType.BLOCK_PLAN]
    : selectedType === DocumentType.CALCULATIONS
      ? [DocumentType.CALCULATIONS, DocumentType.STRUCTURAL, DocumentType.ENERGY]
      : selectedType === DocumentType.SPECIFICATIONS
        ? [DocumentType.SPECIFICATIONS, DocumentType.SUPPORTING_DOCUMENT]
        : selectedType === DocumentType.OTHER
          ? [DocumentType.OTHER, DocumentType.DRAINAGE, DocumentType.CERTIFICATE, DocumentType.CORRESPONDENCE]
          : [selectedType]
  : [];

const documentWhere: Prisma.ProjectDocumentWhereInput = {
  organisationId: auth.organisation.id,
  ...(search ? {
    OR: [
      { originalName: { contains: search, mode: 'insensitive' } },
      { fileName: { contains: search, mode: 'insensitive' } },
      { drawingNumber: { contains: search, mode: 'insensitive' } },
      { drawingTitle: { contains: search, mode: 'insensitive' } },
      { project: { name: { contains: search, mode: 'insensitive' } } },
    ],
  } : {}),
  ...(typeFilterValues.length ? { type: { in: typeFilterValues } } : {}),
};

const activeProjectWhere: Prisma.ProjectWhereInput = {
  organisationId: auth.organisation.id,
  status: { notIn: ['COMPLETED', 'ARCHIVED'] },
};

const [
  projects,
  totalDocumentCount,
  filteredDocumentCount,
  recentDocuments,
  allDocuments,
  projectsMissingLocation,
] = await Promise.all([
  withPerf('documents.projectFolders', () =>
    prisma.project.findMany({
      where: { organisationId: auth.organisation.id },
      select: {
        id: true,
        name: true,
        internalReference: true,
        siteAddress: true,
        status: true,
        client: { select: { name: true } },
        site: { select: { addressLine1: true, postcode: true } },
        documents: {
          select: { createdAt: true },
          orderBy: { createdAt: 'desc' },
          take: 1,
        },
        _count: { select: { documents: true } },
      },
      orderBy: { updatedAt: 'desc' },
    }),
  ),
  withPerf('documents.totalCount', () => prisma.projectDocument.count({ where: { organisationId: auth.organisation.id } })),
  withPerf('documents.filteredCount', () => prisma.projectDocument.count({ where: documentWhere })),
  withPerf('documents.recent', () =>
    prisma.projectDocument.findMany({
      where: { organisationId: auth.organisation.id },
      include: { project: { select: { id: true, name: true } }, uploadedBy: { select: { name: true } } },
      orderBy: { createdAt: 'desc' },
      take: expandedSection === 'recent' ? 50 : 12,
    }),
  ),
  expandedSection === 'all'
    ? withPerf('documents.all', () =>
        prisma.projectDocument.findMany({
          where: documentWhere,
          include: { project: { select: { id: true, name: true } }, uploadedBy: { select: { name: true } } },
          orderBy,
          take: 200,
        }),
      )
    : Promise.resolve([]),
  withPerf('documents.missingLocation', () =>
    prisma.project.findMany({
      where: { ...activeProjectWhere, documents: { none: { type: DocumentType.LOCATION_PLAN } } },
      select: { id: true },
    }),
  ),
]);

const missingLocationProjectIds = new Set(projectsMissingLocation.map((project) => project.id));

const withDocumentsParams = (nextShow: 'recent' | 'all') => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('show', nextShow);
  return `/documents?${params.toString()}#${nextShow === 'recent' ? 'recent-documents' : 'all-documents'}`;
};

const getProjectSummary = (project: typeof projects[number]) => {
  const parts = [];
  if (project.client?.name) parts.push(project.client.name);
  if (project.site) parts.push([project.site.addressLine1, project.site.postcode].filter(Boolean).join(', '));
  return parts.join(' - ') || project.siteAddress || 'No client or site linked yet';
};

const getMissingWarnings = (project: typeof projects[number]) => {
  if (project.status === 'COMPLETED' || project.status === 'ARCHIVED') return [];
  return missingLocationProjectIds.has(project.id) ? ['Location plan missing'] : [];
};
---
<AppShell title="Documents" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold">Documents</h1>
      <p class="mt-1 text-sm text-stone-500">Project folders, batch upload and automatic sorting for the whole practice.</p>
    </div>
    <nav class="flex flex-wrap gap-2 text-sm">
      <a href="/documents/upload" class="btn btn-primary">Upload documents</a>
      <a href="#project-folders" class="btn btn-primary">Project folders</a>
      <a href="#recent-documents" class="btn btn-secondary">Recent documents</a>
      <a href="#all-documents" class="btn btn-secondary">All documents</a>
    </nav>
  </div>

  <section class="mb-6 grid gap-4 md:grid-cols-3">
    <div class="panel rounded-lg p-4">
      <p class="text-xs font-semibold uppercase text-stone-500">Project folders</p>
      <p class="mt-2 text-2xl font-semibold">{projects.length}</p>
    </div>
    <div class="panel rounded-lg p-4">
      <p class="text-xs font-semibold uppercase text-stone-500">Documents</p>
      <p class="mt-2 text-2xl font-semibold">{totalDocumentCount}</p>
    </div>
    <div class="panel rounded-lg p-4">
      <p class="text-xs font-semibold uppercase text-stone-500">Missing location plans</p>
      <p class="mt-2 text-2xl font-semibold">{projectsMissingLocation.length}</p>
    </div>
  </section>

  <section class="panel mb-6 rounded-lg p-4">
    <form method="GET" action="/documents" class="grid gap-4 lg:grid-cols-[minmax(240px,1fr)_220px_220px_auto] lg:items-end">
      <label class="block">
        <span class="label">Search documents</span>
        <input name="q" value={search} class="field" placeholder="Search by file, drawing, or project name" />
      </label>
      <label class="block">
        <span class="label">Sort by</span>
        <select name="sort" class="field">
          <option value="recent" selected={selectedSort === 'recent'}>Most recent</option>
          <option value="oldest" selected={selectedSort === 'oldest'}>Oldest first</option>
          <option value="name" selected={selectedSort === 'name'}>Name A-Z</option>
          <option value="largest" selected={selectedSort === 'largest'}>Largest file</option>
          <option value="smallest" selected={selectedSort === 'smallest'}>Smallest file</option>
        </select>
      </label>
      <label class="block">
        <span class="label">Document type</span>
        <select name="type" class="field">
          <option value="" selected={!selectedType}>All types</option>
          {preferredDocumentTypes.map((type) => <option value={type} selected={selectedType === type}>{documentTypeLabel(type)}</option>)}
        </select>
      </label>
      <div class="flex flex-wrap gap-2">
        <button class="btn btn-primary">Apply filters</button>
        {(search || selectedSort !== 'recent' || selectedType) && <a href="/documents" class="btn btn-secondary">Clear</a>}
      </div>
    </form>
    <p class="mt-3 text-sm text-stone-500">
      {filteredDocumentCount} document{filteredDocumentCount === 1 ? '' : 's'}{search ? ` matching "${search}"` : ''}{selectedType ? ` in ${documentTypeLabel(selectedType)}` : ''}.
    </p>
  </section>

  <section id="project-folders" class="scroll-mt-6">
    <div class="mb-3 flex items-center justify-between gap-3">
      <h2 class="text-xl font-semibold">Project folders</h2>
      <span class="text-sm text-stone-500">{projects.length} folders</span>
    </div>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((project) => {
        const warnings = getMissingWarnings(project);
        const latestUpload = project.documents[0]?.createdAt;
        return (
          <article class="panel rounded-lg p-4">
            <a href={`/documents/projects/${project.id}`} class="block">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="truncate text-lg font-semibold">{project.name}</h3>
                  {project.internalReference && <p class="mt-1 text-sm font-medium text-stone-500">{project.internalReference}</p>}
                </div>
                <span class="rounded-md bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-600">Folder</span>
              </div>
              <p class="mt-3 min-h-10 text-sm text-stone-500">{getProjectSummary(project)}</p>
              <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-md border border-stone-200 p-3">
                  <p class="text-xs font-semibold uppercase text-stone-500">Documents</p>
                  <p class="mt-1 text-lg font-semibold">{project._count.documents}</p>
                </div>
                <div class="rounded-md border border-stone-200 p-3">
                  <p class="text-xs font-semibold uppercase text-stone-500">Latest upload</p>
                  <p class="mt-1 text-sm font-semibold">{latestUpload ? formatDate(latestUpload) : 'None'}</p>
                </div>
              </div>
              {warnings.length > 0 && (
                <div class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-800">
                  {warnings.slice(0, 2).join(' - ')}
                </div>
              )}
            </a>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href={`/documents/projects/${project.id}`} class="btn btn-primary">Open folder</a>
              <a href={`/documents/upload?projectId=${project.id}`} class="btn btn-secondary">Upload documents</a>
            </div>
          </article>
        );
      })}
      {!projects.length && <div class="panel rounded-lg p-8 text-center text-sm text-stone-500 md:col-span-2 xl:col-span-3">Create a project to start building document folders.</div>}
    </div>
  </section>

  <section id="recent-documents" class="mt-8 scroll-mt-6">
    <div class="panel overflow-hidden rounded-lg">
      <div class="flex items-center justify-between gap-3 px-4 py-4">
        <div>
          <h2 class="text-xl font-semibold">Recent documents</h2>
          <p class="mt-1 text-sm text-stone-500">{Math.min(totalDocumentCount, expandedSection === 'recent' ? 50 : 12)} latest documents</p>
        </div>
        {expandedSection === 'recent'
          ? <a href="/documents#recent-documents" class="btn btn-secondary min-h-9 px-3 py-1.5">Show less</a>
          : <a href={withDocumentsParams('recent')} class="btn btn-secondary min-h-9 px-3 py-1.5">See more</a>}
      </div>
      {expandedSection === 'recent' && (
        <div class="border-t border-stone-100">
        <table class="w-full min-w-[760px] border-collapse">
          <thead class="table-head"><tr><th class="px-4 py-3">Document</th><th class="px-4 py-3">Project</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Uploaded</th></tr></thead>
          <tbody>
            {recentDocuments.map((document) => (
              <tr>
                <td class="table-cell"><a href={document.storageUrl} target="_blank" rel="noreferrer" class="font-semibold hover:underline">{document.originalName}</a><p class="text-xs text-stone-500">{document.uploadedBy.name}</p></td>
                <td class="table-cell"><a href={`/documents/projects/${document.projectId}`} class="hover:underline">{document.project.name}</a></td>
                <td class="table-cell">{documentTypeLabel(documentGroupType(document.type))}</td>
                <td class="table-cell">{formatDate(document.createdAt)}</td>
              </tr>
            ))}
            {!recentDocuments.length && <tr><td colspan="4" class="px-4 py-10 text-center text-sm text-stone-500">No documents uploaded yet.</td></tr>}
          </tbody>
        </table>
        </div>
      )}
    </div>
  </section>

  <section id="all-documents" class="mt-8 scroll-mt-6">
    <div class="panel overflow-hidden rounded-lg">
      <div class="flex items-center justify-between gap-3 px-4 py-4">
        <div>
          <h2 class="text-xl font-semibold">All documents</h2>
          <p class="mt-1 text-sm text-stone-500">{filteredDocumentCount} filtered document{filteredDocumentCount === 1 ? '' : 's'}</p>
        </div>
        {expandedSection === 'all'
          ? <a href="/documents#all-documents" class="btn btn-secondary min-h-9 px-3 py-1.5">Show less</a>
          : <a href={withDocumentsParams('all')} class="btn btn-secondary min-h-9 px-3 py-1.5">See more</a>}
      </div>
      {expandedSection === 'all' && (
        <div class="border-t border-stone-100">
        <table class="w-full min-w-[820px] border-collapse">
          <thead class="table-head"><tr><th class="px-4 py-3">Document</th><th class="px-4 py-3">Project</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Uploaded</th><th class="px-4 py-3">Size</th></tr></thead>
          <tbody>
            {allDocuments.map((document) => (
              <tr>
                <td class="table-cell"><a href={document.storageUrl} target="_blank" rel="noreferrer" class="font-semibold hover:underline">{document.originalName}</a><p class="text-xs text-stone-500">{document.uploadedBy.name}</p></td>
                <td class="table-cell"><a href={`/documents/projects/${document.projectId}`} class="hover:underline">{document.project.name}</a></td>
                <td class="table-cell">{documentTypeLabel(documentGroupType(document.type))}</td>
                <td class="table-cell">{formatDate(document.createdAt)}</td>
                <td class="table-cell">{formatBytes(document.sizeBytes)}</td>
              </tr>
            ))}
            {!allDocuments.length && <tr><td colspan="5" class="px-4 py-10 text-center text-sm text-stone-500">No documents uploaded yet.</td></tr>}
          </tbody>
        </table>
        </div>
      )}
    </div>
  </section>
</AppShell>

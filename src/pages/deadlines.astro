---
import AppShell from '@/components/layout/AppShell.astro';
import LiveDataPanel from '@/components/live/LiveDataPanel';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

---
<AppShell title="Deadlines" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-7">
    <h1 class="text-4xl font-semibold tracking-normal text-ink">Deadlines</h1>
    <p class="mt-2 text-sm text-stone-500">Keep track of important project deadlines and milestones with automatic updates.</p>
  </div>
  <LiveDataPanel client:load variant="deadlines" endpoint="/api/deadlines" />
</AppShell>

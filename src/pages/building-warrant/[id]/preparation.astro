---
import { AutomationJobType } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import WarrantBranchFields from '@/components/forms/WarrantBranchFields.astro';
import { permitsSTAS } from '@/lib/building-warrant-branches';
import { readProjectScreener } from '@/lib/projects/screener';
import WarrantOwnerDetails from '@/components/forms/WarrantOwnerDetails.astro';
import { ownerDetailsSchema } from '@/lib/building-warrant-owner';
import WarrantFollowUps from '@/components/forms/WarrantFollowUps.astro';
import PreparationOverview from '@/components/forms/PreparationOverview.astro';
import ProjectScreener from '@/components/forms/ProjectScreener.astro';
import PreparationQuestion from '@/components/forms/PreparationQuestion.astro';
import PreparationSection from '@/components/forms/PreparationSection.astro';
import { warrantSectionForRequirement, type WarrantSectionId } from '@/lib/preparation-sections';
import { warrantSustainabilitySchema } from '@/lib/building-warrant-follow-ups';
import { editablePreparationStatuses } from '@/lib/automation/preparation-editability';
import { resolveApplicationDescription } from '@/server/services/application-description.service';
import { CERTIFIER_REGISTRATION_PART1_CODES } from '@/lib/certifier-registration';
import { prisma } from '@/lib/db/prisma';
import {
  calculateBuildingStandardsFee,
  decimalMoneyToMinorUnits,
} from '@/lib/fees/building-standards-fee';
import { normaliseTypeOfWorkKeys, TYPE_OF_WORK_DEFINITIONS } from '@/lib/projects/type-of-work';
import { requirePageAuth } from '@/lib/server/page-auth';
import { automationJobSnapshotV2Schema } from '@/lib/validation/automation-job';
import { buildingWarrantPreparationSchema } from '@/lib/validation/domain';
import { automationJobApplicationId, findReusableAutomationJob } from '@/server/services/desktop-automation-status.service';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');
const id = Astro.params.id;
if (!id) return Astro.redirect('/projects');

const application = await prisma.buildingWarrantApplication.findFirst({
  where: { id, organisationId: auth.organisation.id },
  include: {
    project: { include: { client: true, site: true } },
    selectedCertifierPreset: true,
  },
});
if (!application) return Astro.redirect('/projects');
const description = await resolveApplicationDescription(auth.organisation.id, application.projectId, application.description);

const suppliedJobId = Astro.url.searchParams.get('job');
const suppliedJob = suppliedJobId ? await prisma.automationJob.findFirst({
  where: {
    id: suppliedJobId,
    organisationId: auth.organisation.id,
    projectId: application.projectId,
    type: AutomationJobType.BUILDING_WARRANT,
  },
  select: { id: true, projectId: true, type: true, status: true, dataSnapshot: true },
}) : null;
const reusableJob = suppliedJob ?? await findReusableAutomationJob({
  organisationId: auth.organisation.id,
  projectId: application.projectId,
  type: AutomationJobType.BUILDING_WARRANT,
  applicationId: application.id,
});
const job = reusableJob && editablePreparationStatuses.has(reusableJob.status)
  && automationJobApplicationId(reusableJob) === application.id ? reusableJob : null;

const defaults = await prisma.organisationDefaults.findUnique({
  where: { organisationId: auth.organisation.id },
  include: { defaultCertifierPreset: true },
});
const presets = await prisma.organisationCertifierPreset.findMany({
  where: { organisationId: auth.organisation.id },
  orderBy: [{ isDefault: 'desc' }, { displayName: 'asc' }],
});
const preparation = application.preparationData && typeof application.preparationData === 'object' && !Array.isArray(application.preparationData)
  ? application.preparationData as Record<string, unknown>
  : {};
const warrantAnswers = buildingWarrantPreparationSchema.parse(preparation);
const projectScreen = readProjectScreener(application.project);
const selectedTypeOfWorkKeys = normaliseTypeOfWorkKeys(
  projectScreen.typeOfWorkKeys.length ? projectScreen.typeOfWorkKeys : preparation.typeOfWorkKeys,
  application.presetKey ?? application.project.projectType,
);
const showSTAS = permitsSTAS(projectScreen.buildingUse, selectedTypeOfWorkKeys);
const requiresExistingUse = selectedTypeOfWorkKeys.some(key => key === 'domestic_alteration_extension' || key === 'conversion_change_of_use');
const designSelected = warrantAnswers.designCertifierSelected ?? warrantAnswers.certifierOfDesignCertificateAvailable === true;
const warrantQuestions = [
  ['applicantIsOwner', 'Applicant is the legal owner'],
  ['fireAndRescueServiceEnforcingAuthority', 'Fire and Rescue Service is the enforcing authority'],
  ['listedBuildingOrConservationArea', 'Building is listed or within a conservation area'],
  ['otherHistoricalImportance', 'Building has other historical importance'],
  ['scottishMinistersRelaxationDirection', 'Work is subject to a Scottish Ministers relaxation direction'],
  ['dangerousBuildingNotice', 'Building is subject to a dangerous building notice'],
  ['coveredBySTAS', 'Proposals are covered by STAS'],
] as const;
const savedCertifier = preparation.certifier && typeof preparation.certifier === 'object' && !Array.isArray(preparation.certifier)
  ? preparation.certifier as Record<string, unknown>
  : {};
const selectedPreset = application.selectedCertifierPreset ?? defaults?.defaultCertifierPreset ?? null;
const savedValue = (key: string) => typeof savedCertifier[key] === 'string' ? savedCertifier[key] as string : null;
const registrationAPart1 = savedValue('registrationAPart1') ?? selectedPreset?.registrationAPart1 ?? '';
const registrationAPart2 = savedValue('registrationAPart2') ?? selectedPreset?.registrationAPart2 ?? '';
const certifierName = savedValue('certifierName') ?? selectedPreset?.certifierName ?? '';
const registrationBPart1 = savedValue('registrationBPart1') ?? selectedPreset?.registrationBPart1 ?? '';
const registrationBPart2 = savedValue('registrationBPart2') ?? selectedPreset?.registrationBPart2 ?? '';
const approvedBody = savedValue('approvedBody') ?? selectedPreset?.approvedBody ?? '';
const schemeType = savedValue('schemeType') ?? selectedPreset?.schemeType ?? '';
const designCertifierSelected = designSelected && Boolean(
  registrationAPart1 || registrationAPart2 || registrationBPart1 || registrationBPart2 || certifierName,
);
const feeCalculation = calculateBuildingStandardsFee({
  effectiveDate: new Date(),
  submissionType: 'BUILDING_WARRANT',
  valueOfWorksMinorUnits: decimalMoneyToMinorUnits(application.estimatedValue?.toString()),
  workStartedBeforeApplication: warrantAnswers.workStartedBeforeApplication ?? null,
  conversionOnly: selectedTypeOfWorkKeys.length === 1 && selectedTypeOfWorkKeys[0] === 'conversion_change_of_use',
  demolitionOnly: selectedTypeOfWorkKeys.length === 1 && selectedTypeOfWorkKeys[0] === 'demolition',
  disabledPersonsFacilitiesOnly: warrantAnswers.disabledPersonsFacilitiesOnly ?? null,
  certifierOfDesign: {
    selected: designCertifierSelected,
    certificateAvailable: warrantAnswers.certifierOfDesignCertificateAvailable ?? null,
  },
  certifierOfConstruction: {
    selected: warrantAnswers.approvedCertifierOfConstruction,
    certificateAvailable: warrantAnswers.certifierOfConstructionCertificateAvailable ?? null,
  },
});
const feeMoney = (minorUnits: number) => new Intl.NumberFormat('en-GB', {
  style: 'currency',
  currency: 'GBP',
}).format(minorUnits / 100);
const parsedSnapshot = automationJobSnapshotV2Schema.safeParse(job?.dataSnapshot);
const remainingRequirements = parsedSnapshot.success ? parsedSnapshot.data.preflight.missing : [];
const incompleteSave = Astro.url.searchParams.get('incomplete') === '1';
const address = [application.project.site?.addressLine1, application.project.site?.townCity, application.project.site?.postcode]
  .filter(Boolean)
  .join(', ') || application.project.siteAddress || 'Site address not recorded';
const clientName = application.project.client?.name ?? 'Client not recorded';
const documentCount = await prisma.projectDocument.count({ where: { organisationId: auth.organisation.id, projectId: application.projectId } });
const questionLabel = (name: (typeof warrantQuestions)[number][0]) => warrantQuestions.find(([key]) => key === name)![1];
const newBuilding = selectedTypeOfWorkKeys.includes('new_build');
const screeningSummary = `${projectScreen.buildingUse === 'residential' ? 'Residential' : 'Commercial'} — ${projectScreen.typeOfWorkKeys.map(key => TYPE_OF_WORK_DEFINITIONS.find(type => type.key === key)?.label).join(', ')}`;
const sections: ReadonlyArray<{ id: WarrantSectionId; title: string; description?: string }> = [
  { id: 'details', title: 'Warrant details', description: 'These details must be complete before the job can open in desktop.' },
  { id: 'questions', title: 'Additional warrant questions', description: 'Tick each statement that applies. Unticked statements are saved as No.' },
  { id: 'sustainability', title: 'New-building sustainability', description: 'Use the levels specified in the project design. Choose a level for each applicable aspect.' },
  { id: 'certificates', title: 'Certificate information', description: 'Choose a saved profile or enter certifier details. Valid details are saved for future applications.' },
  { id: 'fee', title: 'Fee information', description: 'Architect Pro uses these answers to calculate the application fee. Desktop uses the saved result and does not recalculate it.' },
  { id: 'declaration', title: 'Declaration' },
];
const visibleSections = sections.filter(section => section.id !== 'sustainability' || newBuilding);
const sectionProps = (id: WarrantSectionId) => {
  const section = sections.find(item => item.id === id)!;
  return {
    id,
    title: section.title,
    description: section.description,
    hidden: !visibleSections.includes(section),
    serverMissing: incompleteSave ? remainingRequirements.filter(requirement => warrantSectionForRequirement(requirement.field) === id).length : 0,
  };
};
const followUpProps = {
  fireAuthorityName: typeof preparation.fireAuthorityName === 'string' ? preparation.fireAuthorityName : null,
  fireEnforcingAuthority: warrantAnswers.fireAndRescueServiceEnforcingAuthority,
  historical: warrantAnswers.otherHistoricalImportance,
  historicalDetails: typeof preparation.historicalBuildingDetails === 'string' ? preparation.historicalBuildingDetails : '',
  dangerous: warrantAnswers.dangerousBuildingNotice,
  dangerousReferences: typeof preparation.dangerousBuildingReferences === 'string' ? preparation.dangerousBuildingReferences : '',
  relaxation: warrantAnswers.scottishMinistersRelaxationDirection,
  relaxationDirections: Array.isArray(preparation.relaxationDirections) ? preparation.relaxationDirections as Array<{ reference: string; date: string }> : undefined,
  relaxationReference: typeof preparation.relaxationReference === 'string' ? preparation.relaxationReference : '',
  relaxationDate: typeof preparation.relaxationDate === 'string' ? preparation.relaxationDate : '',
  newBuilding,
  sustainability: warrantSustainabilitySchema.parse(preparation.sustainability ?? {}),
};
const branchProps = {
  workTypes: selectedTypeOfWorkKeys,
  listed: warrantAnswers.listedBuildingOrConservationArea,
  stas: showSTAS && warrantAnswers.coveredBySTAS,
  construction: warrantAnswers.approvedCertifierOfConstruction,
  constructionAvailable: warrantAnswers.certifierOfConstructionCertificateAvailable,
  authorised: warrantAnswers.declarationAuthorised,
  preparation,
};
---
<AppShell title="Complete Building Warrant details" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={`/projects/${application.projectId}`} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to project</a>
    <h1 class="mt-2 text-3xl font-semibold text-ink">Building Warrant application details</h1>
    <p class="mt-1 text-sm text-stone-500">Complete the warrant and certificate information required by the desktop application.</p>
  </div>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
    <div class="min-w-0 space-y-6">
    <section id="screening" class="panel scroll-mt-44 rounded-lg p-5 lg:scroll-mt-6" aria-labelledby="screening-heading">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 id="screening-heading" class="text-xl font-semibold">Project screening</h2>
          {projectScreen.complete
            ? <p class="mt-1 text-sm text-ink">{screeningSummary}</p>
            : <p class="mt-1 text-sm text-stone-500">Choose the building use and every type of work. These answers decide which questions this application needs, and are shared by the project's warrant applications.</p>}
        </div>
        {projectScreen.complete && <button type="button" class="btn btn-secondary shrink-0" data-screening-toggle aria-expanded="false" aria-controls="prep-screening">Change</button>}
      </div>
      <form id="prep-screening" class="mt-4 grid gap-5" data-screening-action={`/api/projects/${application.projectId}/screener`} hidden={projectScreen.complete}>
        <ProjectScreener buildingUse={projectScreen.buildingUse} typeOfWorkKeys={projectScreen.typeOfWorkKeys} embedded />
        <div class="flex flex-wrap items-center gap-3"><button class="btn btn-primary">Save project screening</button><span data-screening-status class="text-sm text-stone-500" aria-live="polite"></span></div>
      </form>
    </section>
    <form data-api-form data-action={`/api/building-warrant/${application.id}/certifier-details`} data-method="POST" class="panel prep-form rounded-lg p-5">
      {job && <input type="hidden" name="jobId" value={job.id} />}
      {incompleteSave && remainingRequirements.length > 0 && (
        <div class="mb-5 border-l-4 border-amber-600 bg-amber-50 px-4 py-3" role="alert">
          <p class="font-semibold text-amber-900">More information is still required</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-amber-900">
            {remainingRequirements.map((requirement) => {
              const target = warrantSectionForRequirement(requirement.field);
              return <li>{target && visibleSections.some(section => section.id === target) ? <a href={`#${target}`} class="underline">{requirement.message}</a> : requirement.message}</li>;
            })}
          </ul>
        </div>
      )}
      <div class="mb-5 scroll-mt-44 border-l-4 border-amber-600 bg-amber-50 px-4 py-3 outline-none lg:scroll-mt-6" tabindex="-1" role="alert" data-prep-summary hidden>
        <p class="font-semibold text-amber-900">Complete these answers before saving</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-amber-900" data-prep-summary-list></ul>
      </div>

      <PreparationSection {...sectionProps('details')}>
        {!projectScreen.complete && <p class="mt-5 text-sm text-amber-900"><a href="#screening" class="font-semibold underline" data-prep-static-missing="Project screening">Complete the project screening above</a> so this page shows the questions this application needs.</p>}
        {selectedTypeOfWorkKeys.map(key => <input type="hidden" name="typeOfWorkKeys" value={key} />)}
        <label class="mt-5 block"><span class="label">Description of work</span><textarea required maxlength="4000" name="description" rows="4" class="field">{description ?? ''}</textarea></label>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          <label class="block"><span class="label">Estimated value of work</span><input required type="number" min="0.01" step="0.01" name="estimatedValue" value={application.estimatedValue ? String(application.estimatedValue) : ''} class="field" /></label>
          <label class="block"><span class="label">Current use</span><input required={requiresExistingUse} maxlength="160" name="currentUse" value={application.currentUse ?? ''} class="field" /></label>
          <label class="block"><span class="label">Proposed use</span><input required={requiresExistingUse} maxlength="160" name="proposedUse" value={application.proposedUse ?? ''} class="field" /></label>
        </div>
        <div class="mt-4"><WarrantBranchFields part="services" {...branchProps} /></div>
        <WarrantBranchFields part="conversion" {...branchProps} />
        <WarrantBranchFields part="demolition" {...branchProps} />
      </PreparationSection>

      <PreparationSection {...sectionProps('questions')}>
        <div class="mt-4 border-t border-stone-100">
          <PreparationQuestion name="applicantIsOwner" label={questionLabel('applicantIsOwner')} checked={warrantAnswers.applicantIsOwner}>
            <WarrantOwnerDetails applicantIsOwner={warrantAnswers.applicantIsOwner} ownerIsClient={typeof preparation.ownerIsClient === 'boolean' ? preparation.ownerIsClient : undefined} details={ownerDetailsSchema.parse(preparation.ownerDetails ?? {})} clientName={clientName} />
          </PreparationQuestion>
          <PreparationQuestion name="fireAndRescueServiceEnforcingAuthority" label={questionLabel('fireAndRescueServiceEnforcingAuthority')} checked={warrantAnswers.fireAndRescueServiceEnforcingAuthority}>
            <WarrantFollowUps part="fire" {...followUpProps} />
          </PreparationQuestion>
          <PreparationQuestion name="listedBuildingOrConservationArea" label={questionLabel('listedBuildingOrConservationArea')} checked={warrantAnswers.listedBuildingOrConservationArea}>
            <WarrantBranchFields part="listing" {...branchProps} />
          </PreparationQuestion>
          <PreparationQuestion name="otherHistoricalImportance" label={questionLabel('otherHistoricalImportance')} checked={warrantAnswers.otherHistoricalImportance}>
            <WarrantFollowUps part="historical" {...followUpProps} />
          </PreparationQuestion>
          <PreparationQuestion name="scottishMinistersRelaxationDirection" label={questionLabel('scottishMinistersRelaxationDirection')} checked={warrantAnswers.scottishMinistersRelaxationDirection}>
            <WarrantFollowUps part="relaxation" {...followUpProps} />
          </PreparationQuestion>
          <PreparationQuestion name="dangerousBuildingNotice" label={questionLabel('dangerousBuildingNotice')} checked={warrantAnswers.dangerousBuildingNotice}>
            <WarrantFollowUps part="dangerous" {...followUpProps} />
          </PreparationQuestion>
          {showSTAS ? (
            <PreparationQuestion name="coveredBySTAS" label={questionLabel('coveredBySTAS')} checked={warrantAnswers.coveredBySTAS}>
              <WarrantBranchFields part="stas" {...branchProps} />
            </PreparationQuestion>
          ) : <WarrantBranchFields part="stas" {...branchProps} />}
        </div>
      </PreparationSection>

      <PreparationSection {...sectionProps('sustainability')}>
        <WarrantFollowUps part="sustainability" {...followUpProps} />
      </PreparationSection>

      <PreparationSection {...sectionProps('certificates')}>
        <a slot="action" href="/settings" class="text-sm font-semibold text-stone-600 hover:text-ink">Manage saved certifiers</a>
        <label class="mt-5 block"><span class="prep-field-question">Use a certifier of design?</span><select name="designCertifierSelected" class="field"><option value="false" selected={!designSelected}>No certifier of design</option><option value="true" selected={designSelected}>Yes — choose a profile or enter details</option></select></label>
        <fieldset class="prep-followup mt-4" data-design-certificate-fields disabled={!designSelected} hidden={!designSelected}>
          <legend class="sr-only">Certifier of design details</legend>
          <label class="block">
            <span class="label">Saved certifier profile</span>
            <select name="selectedCertifierPresetId" class="field">
              <option value="">No saved profile</option>
              {presets.map((preset) => <option value={preset.id} selected={preset.id === selectedPreset?.id} data-scheme-type={preset.schemeType ?? ''} data-registration-a-part1={preset.registrationAPart1 ?? ''} data-registration-a-part2={preset.registrationAPart2 ?? ''} data-certifier-name={preset.certifierName ?? ''} data-registration-b-part1={preset.registrationBPart1 ?? ''} data-registration-b-part2={preset.registrationBPart2 ?? ''} data-approved-body={preset.approvedBody ?? ''}>{preset.displayName}</option>)}
            </select>
          </label>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class="block"><span class="label">Scheme Type</span><input maxlength="120" name="schemeType" value={schemeType} class="field" /></label>
            <label class="block"><span class="label">Registration number A Part 1</span><select required name="registrationAPart1" class="field"><option value="">Select code</option>{CERTIFIER_REGISTRATION_PART1_CODES.map((code) => <option value={code} selected={code === registrationAPart1}>{code}</option>)}</select></label>
            <label class="block"><span class="label">Registration number A Part 2</span><input required maxlength="80" name="registrationAPart2" value={registrationAPart2} class="field" /></label>
            <label class="block"><span class="label">Name of Certifier</span><input required maxlength="160" name="certifierName" value={certifierName} class="field" /></label>
            <label class="block"><span class="label">Registration number B Part 1</span><select required name="registrationBPart1" class="field"><option value="">Select code</option>{CERTIFIER_REGISTRATION_PART1_CODES.map((code) => <option value={code} selected={code === registrationBPart1}>{code}</option>)}</select></label>
            <label class="block"><span class="label">Registration number B Part 2</span><input required maxlength="80" name="registrationBPart2" value={registrationBPart2} class="field" /></label>
            <label class="block"><span class="label">Name of Approved Body</span><input required maxlength="160" name="approvedBody" value={approvedBody} class="field" /></label>
          </div>
          <label class="mt-4 block">
            <span class="prep-field-question">Will the appropriate Certifier of Design certificate be provided?</span>
            <select required name="certifierOfDesignCertificateAvailable" class="field">
              <option value="">Choose Yes or No</option>
              <option value="true" selected={warrantAnswers.certifierOfDesignCertificateAvailable === true}>Yes</option>
              <option value="false" selected={warrantAnswers.certifierOfDesignCertificateAvailable === false}>No</option>
            </select>
          </label>
          <label class="mt-4 block" data-design-certificate-timing hidden={warrantAnswers.certifierOfDesignCertificateAvailable !== true}><span class="prep-field-question">When will the design certificate be provided?</span><select name="designCertificateTiming" class="field" required={designSelected && warrantAnswers.certifierOfDesignCertificateAvailable === true}><option value="">Choose when</option><option value="with_application" selected={preparation.designCertificateWithApplication === true}>With this application</option><option value="following_application" selected={preparation.designCertificateFollowingApplication === true}>Following this application</option></select></label>
        </fieldset>
        <WarrantBranchFields part="construction" {...branchProps} />
      </PreparationSection>

      <PreparationSection {...sectionProps('fee')}>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="prep-field-question">Is all work solely for qualifying disabled-person facilities?</span>
            <select required name="disabledPersonsFacilitiesOnly" class="field">
              <option value="">Choose Yes or No</option>
              <option value="true" selected={warrantAnswers.disabledPersonsFacilitiesOnly === true}>Yes</option>
              <option value="false" selected={warrantAnswers.disabledPersonsFacilitiesOnly === false}>No</option>
            </select>
          </label>
          <p class="text-sm text-stone-600 sm:self-end sm:pb-2">Work started before application: <strong>No</strong></p>
        </div>
      </PreparationSection>

      <PreparationSection {...sectionProps('declaration')}>
        <div class="mt-4"><WarrantBranchFields part="declaration" {...branchProps} /></div>
      </PreparationSection>

      <div class="mt-6 flex flex-wrap items-center gap-3"><button class="btn btn-primary">Save and return to project</button><span data-form-status class="text-sm text-stone-500" /></div>
    </form>
    </div>

    <aside class="panel rounded-lg p-5 xl:sticky xl:top-6 xl:max-h-[calc(100vh-3rem)] xl:overflow-y-auto" aria-label="Building Warrant application summary">
      <h2 class="text-lg font-semibold">Application summary</h2>
      <dl class="mt-4 space-y-2 text-sm"><div class="prep-summary-row"><dt class="text-stone-500">Project</dt><dd class="font-semibold text-ink">{application.project.name}</dd></div><div class="prep-summary-row"><dt class="text-stone-500">Site</dt><dd>{address}</dd></div><div class="prep-summary-row"><dt class="text-stone-500">Client</dt><dd>{clientName}</dd></div><div class="prep-summary-row"><dt class="text-stone-500">Application</dt><dd>Building Warrant</dd></div><div class="prep-summary-row"><dt class="text-stone-500">Documents</dt><dd>{documentCount} document{documentCount === 1 ? '' : 's'}</dd></div></dl>
      <section class="mt-5 border-t border-stone-200 pt-5" aria-labelledby="calculated-fee-heading" data-fee-summary>
        <p class="label">2026 Building Standards fee</p>
        <h2 id="calculated-fee-heading" class="mt-1 text-lg font-semibold text-ink">Calculated application fee</h2>
        <div class:list={['mt-3', feeCalculation.calculationStatus === 'CALCULATED' ? '' : 'hidden']} data-fee-calculated>
          <dl class="space-y-2 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-stone-500">Base fee</dt><dd class="font-medium text-ink" data-fee-base>{feeCalculation.calculationStatus === 'CALCULATED' ? feeMoney(feeCalculation.baseFeeMinorUnits) : '—'}</dd></div>
            <div class:list={['flex justify-between gap-4', feeCalculation.calculationStatus === 'CALCULATED' && feeCalculation.multiplierPercent !== 100 ? '' : 'hidden']} data-fee-multiplier-row><dt class="text-stone-500" data-fee-multiplier-label>{feeCalculation.calculationStatus === 'CALCULATED' ? `${feeCalculation.multiplierPercent}% multiplier` : 'Multiplier'}</dt><dd class="font-medium text-ink" data-fee-subtotal>{feeCalculation.calculationStatus === 'CALCULATED' ? feeMoney(feeCalculation.subtotalMinorUnits) : '—'}</dd></div>
          </dl>
          <dl class="mt-2 space-y-2 text-sm" data-fee-adjustments>
            {feeCalculation.calculationStatus === 'CALCULATED' && feeCalculation.adjustments.map((adjustment) => <div class="flex justify-between gap-4"><dt class="text-stone-500">{adjustment.label}</dt><dd class="font-medium text-ink">{feeMoney(adjustment.amountMinorUnits)}</dd></div>)}
          </dl>
          <div class="mt-3 flex items-end justify-between gap-4 border-t border-stone-200 pt-3"><span class="text-sm font-semibold text-ink">Calculated fee</span><strong class="text-2xl font-semibold text-ink" aria-live="polite" data-fee-total>{feeCalculation.calculationStatus === 'CALCULATED' ? feeMoney(feeCalculation.totalFeeMinorUnits) : '—'}</strong></div>
          <details class="mt-3 text-sm text-stone-600">
            <summary class="cursor-pointer font-semibold text-moss">How was this calculated?</summary>
            <ul class="mt-2 list-disc space-y-1 pl-5" data-fee-explanation>{feeCalculation.explanation.map((line) => <li>{line}</li>)}</ul>
          </details>
        </div>
        <div class:list={['mt-3 border-l-4 border-amber-600 bg-amber-50 px-3 py-3 text-sm text-amber-950', feeCalculation.calculationStatus === 'NEEDS_INFORMATION' ? '' : 'hidden']} role="status" aria-live="polite" data-fee-needs-information>
          <p class="font-semibold">Fee cannot be calculated yet</p>
          <p class="mt-1" data-fee-message>{feeCalculation.explanation[0]}</p>
        </div>
      </section>
      <PreparationOverview sections={visibleSections} />
    </aside>
  </div>
  <script>
    import {
      calculateBuildingStandardsFee,
      decimalMoneyToMinorUnits,
    } from '@/lib/fees/building-standards-fee';
    import { initPreparationProgress } from '@/lib/preparation-progress';

    const profile = document.querySelector('select[name="selectedCertifierPresetId"]');
    const profileFields = {
      schemeType: document.querySelector('[name="schemeType"]'),
      registrationAPart1: document.querySelector('[name="registrationAPart1"]'),
      registrationAPart2: document.querySelector('[name="registrationAPart2"]'),
      certifierName: document.querySelector('[name="certifierName"]'),
      registrationBPart1: document.querySelector('[name="registrationBPart1"]'),
      registrationBPart2: document.querySelector('[name="registrationBPart2"]'),
      approvedBody: document.querySelector('[name="approvedBody"]'),
    };
    profile?.addEventListener('change', () => {
      if (!(profile instanceof HTMLSelectElement)) return;
      const option = profile.selectedOptions[0];
      if (!option?.value) return;
      for (const [key, field] of Object.entries(profileFields)) {
        const value = option.dataset[key];
        if ((field instanceof HTMLInputElement || field instanceof HTMLSelectElement) && value !== undefined) {
          field.value = value;
        }
      }
      updateFee();
    });

    const form = document.querySelector<HTMLFormElement>('form[data-api-form]');
    const summary = document.querySelector<HTMLElement>('[data-fee-summary]');
    const gbp = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' });
    const fieldValue = (name: string) => {
      const field = form?.elements.namedItem(name);
      if (field instanceof RadioNodeList) return field.value;
      if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) {
        return field.value;
      }
      return '';
    };
    const readBoolean = (name: string) => {
      const field = form?.querySelector(`[name="${name}"]`);
      if (!(field instanceof HTMLSelectElement) || !field.value) return null;
      return field.value === 'true';
    };
    const setText = (selector: string, value: string) => {
      const element = summary?.querySelector(selector);
      if (element) element.textContent = value;
    };
    const updateFee = () => {
      if (!(form instanceof HTMLFormElement) || !summary) return;
      const workTypes = Array.from(form.querySelectorAll('input[name="typeOfWorkKeys"]'))
        .filter((item): item is HTMLInputElement => item instanceof HTMLInputElement && (item.type === 'hidden' || item.checked))
        .map((item) => item.value);
      const hasDesignCertifier = fieldValue('designCertifierSelected') === 'true' && ['registrationAPart1', 'registrationAPart2', 'registrationBPart1', 'registrationBPart2', 'certifierName']
        .some((name) => fieldValue(name).trim());
      const constructionField = form.elements.namedItem('approvedCertifierOfConstruction');
      const result = calculateBuildingStandardsFee({
        effectiveDate: new Date(),
        submissionType: 'BUILDING_WARRANT',
        valueOfWorksMinorUnits: decimalMoneyToMinorUnits(fieldValue('estimatedValue')),
        workStartedBeforeApplication: false,
        conversionOnly: workTypes.length === 1 && workTypes[0] === 'conversion_change_of_use',
        demolitionOnly: workTypes.length === 1 && workTypes[0] === 'demolition',
        disabledPersonsFacilitiesOnly: readBoolean('disabledPersonsFacilitiesOnly'),
        certifierOfDesign: {
          selected: hasDesignCertifier,
          certificateAvailable: readBoolean('certifierOfDesignCertificateAvailable'),
        },
        certifierOfConstruction: {
          selected: constructionField instanceof HTMLSelectElement && constructionField.value === 'true',
          certificateAvailable: readBoolean('certifierOfConstructionCertificateAvailable'),
        },
      });
      const calculated = summary.querySelector('[data-fee-calculated]');
      const needsInformation = summary.querySelector('[data-fee-needs-information]');
      calculated?.classList.toggle('hidden', result.calculationStatus !== 'CALCULATED');
      needsInformation?.classList.toggle('hidden', result.calculationStatus !== 'NEEDS_INFORMATION');
      if (result.calculationStatus === 'NEEDS_INFORMATION') {
        setText('[data-fee-message]', result.explanation[0] || 'Complete the fee information above.');
        return;
      }
      setText('[data-fee-base]', gbp.format(result.baseFeeMinorUnits / 100));
      setText('[data-fee-multiplier-label]', `${result.multiplierPercent}% multiplier`);
      setText('[data-fee-subtotal]', gbp.format(result.subtotalMinorUnits / 100));
      summary.querySelector('[data-fee-multiplier-row]')?.classList.toggle('hidden', result.multiplierPercent === 100);
      setText('[data-fee-total]', gbp.format(result.totalFeeMinorUnits / 100));
      const adjustments = summary.querySelector('[data-fee-adjustments]');
      adjustments?.replaceChildren(...result.adjustments.map((adjustment) => {
        const row = document.createElement('div');
        row.className = 'flex justify-between gap-4';
        const label = document.createElement('dt');
        label.className = 'text-stone-500';
        label.textContent = adjustment.label;
        const amount = document.createElement('dd');
        amount.className = 'font-medium text-ink';
        amount.textContent = gbp.format(adjustment.amountMinorUnits / 100);
        row.append(label, amount);
        return row;
      }));
      const explanation = summary.querySelector('[data-fee-explanation]');
      explanation?.replaceChildren(...result.explanation.map((line) => {
        const item = document.createElement('li');
        item.textContent = line;
        return item;
      }));
    };
    const updateDesignFields = () => {
      const selected = fieldValue('designCertifierSelected') === 'true';
      const fields = form?.querySelector<HTMLFieldSetElement>('[data-design-certificate-fields]');
      if (fields) { fields.disabled = !selected; fields.hidden = !selected; }
      const timing = form?.querySelector<HTMLElement>('[data-design-certificate-timing]');
      const needsTiming = selected && fieldValue('certifierOfDesignCertificateAvailable') === 'true';
      if (timing) timing.hidden = !needsTiming;
      const timingField = form?.querySelector<HTMLSelectElement>('[name="designCertificateTiming"]');
      if (timingField) timingField.required = needsTiming;
    };
    form?.addEventListener('change', updateDesignFields);
    updateDesignFields();
    form?.addEventListener('input', updateFee);
    form?.addEventListener('change', updateFee);
    updateFee();
    initPreparationProgress();

    // Project screening saves through its own route, then reloads so the page shows the right questions.
    const screening = document.querySelector<HTMLFormElement>('#prep-screening');
    const screeningToggle = document.querySelector<HTMLButtonElement>('[data-screening-toggle]');
    const screeningStatus = document.querySelector<HTMLElement>('[data-screening-status]');
    let unsavedAnswers = false;
    form?.addEventListener('input', () => { unsavedAnswers = true; });
    form?.addEventListener('change', () => { unsavedAnswers = true; });
    screeningToggle?.addEventListener('click', () => {
      if (!screening) return;
      screening.hidden = !screening.hidden;
      screeningToggle.setAttribute('aria-expanded', String(!screening.hidden));
      screeningToggle.textContent = screening.hidden ? 'Change' : 'Cancel';
    });
    screening?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!screening.reportValidity()) return;
      const data = new FormData(screening);
      const typeOfWorkKeys = data.getAll('typeOfWorkKeys');
      const showStatus = (text: string, error = false) => {
        if (!screeningStatus) return;
        screeningStatus.textContent = text;
        screeningStatus.classList.toggle('text-red-700', error);
        screeningStatus.classList.toggle('text-stone-500', !error);
      };
      if (!typeOfWorkKeys.length) { showStatus('Select at least one type of work.', true); return; }
      if (unsavedAnswers && !window.confirm('Saving the screening reloads this page. Answers below that you have not saved will be lost. Continue?')) return;
      const button = screening.querySelector<HTMLButtonElement>('button:not([type="button"])');
      if (button) button.disabled = true;
      showStatus('Saving...');
      try {
        const response = await fetch(screening.dataset.screeningAction ?? '', {
          method: 'PATCH',
          headers: { accept: 'application/json', 'content-type': 'application/json' },
          body: JSON.stringify({ buildingUse: data.get('buildingUse'), typeOfWorkKeys }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) { showStatus(payload.error || 'The screening could not be saved.', true); return; }
        window.location.reload();
      } catch {
        showStatus('Network error. Please try again.', true);
      } finally {
        if (button) button.disabled = false;
      }
    });
  </script>
</AppShell>

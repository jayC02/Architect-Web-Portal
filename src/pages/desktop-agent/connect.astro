---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandLogo from '@/components/brand/BrandLogo.astro';
import AgentBrowserConnection from '@/components/integrations/AgentBrowserConnection';
import { getSessionAuth } from '@/lib/auth/session';
import { AGENT_SETUP_COOKIE } from '@/server/auth/agent-credential';
import { agentConnectionQuerySchema } from '@/lib/validation/desktop-agent';
import { privateNoStore, setAstroCache } from '@/lib/server/cache-control';

export const prerender = false;
setAstroCache(Astro, privateNoStore);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const query = Object.fromEntries(Astro.url.searchParams.entries());
const parsed = agentConnectionQuerySchema.safeParse(query);
const auth = await getSessionAuth(Astro);
if (!auth) {
  return Astro.redirect(`/login?returnTo=${encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`)}`);
}
const hasSetupIntent = Boolean(Astro.cookies.get(AGENT_SETUP_COOKIE)?.value);
---
<BaseLayout title="Connect Architect Pro Agent" noindex>
  <main class="grid min-h-screen place-items-center bg-paper px-4 py-12">
    <div class="w-full max-w-lg">
      <BrandLogo class="mx-auto mb-7 h-auto w-40" />
      {parsed.success ? (
        <AgentBrowserConnection client:load {...parsed.data} {hasSetupIntent} />
      ) : (
        <section class="panel rounded-lg p-6 sm:p-8">
          <h1 class="text-2xl font-semibold text-ink">Connection link expired</h1>
          <p class="mt-3 text-sm leading-6 text-stone-600">Return to Architect Pro Agent and select Try again.</p>
        </section>
      )}
    </div>
  </main>
</BaseLayout>

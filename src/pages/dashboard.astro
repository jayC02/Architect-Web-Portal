---
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { formatDate, humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const orgId = auth.organisation.id;
const dueSoon = new Date(Date.now() + 1000 * 60 * 60 * 24 * 14);

const [
  activeProjects,
  upcomingDeadlines,
  recentFiles,
  planningAwaitingAction,
  warrantsAwaitingAction,
  projectsForWarnings,
] = await Promise.all([
  prisma.project.count({ where: { organisationId: orgId, status: 'ACTIVE' } }),
  prisma.deadline.findMany({
    where: { organisationId: orgId, status: { in: ['UPCOMING', 'DUE_SOON', 'OVERDUE'] }, dueDate: { lte: dueSoon } },
    include: { project: { select: { id: true, name: true } } },
    orderBy: { dueDate: 'asc' },
    take: 6,
  }),
  prisma.projectDocument.findMany({
    where: { organisationId: orgId },
    include: { project: { select: { id: true, name: true } }, uploadedBy: { select: { name: true } } },
    orderBy: { createdAt: 'desc' },
    take: 6,
  }),
  prisma.planningApplication.findMany({
    where: { organisationId: orgId, status: { in: ['DRAFTING', 'FURTHER_INFORMATION_REQUESTED', 'IN_REVIEW'] } },
    include: { project: { select: { id: true, name: true } } },
    orderBy: { updatedAt: 'desc' },
    take: 6,
  }),
  prisma.buildingWarrantApplication.findMany({
    where: { organisationId: orgId, status: { in: ['DRAFTING', 'FURTHER_INFORMATION_REQUESTED', 'IN_REVIEW'] } },
    include: { project: { select: { id: true, name: true } } },
    orderBy: { updatedAt: 'desc' },
    take: 6,
  }),
  prisma.project.findMany({
    where: { organisationId: orgId, status: 'ACTIVE' },
    include: { documents: { select: { type: true } } },
    orderBy: { updatedAt: 'desc' },
    take: 20,
  }),
]);

const missingWarnings = projectsForWarnings.flatMap((project) => {
  const types = new Set(project.documents.map((document) => document.type));
  return ['LOCATION_PLAN', 'SITE_PLAN'].filter((type) => !types.has(type as never)).map((type) => ({
    project,
    type,
  }));
}).slice(0, 6);

const stats = [
  ['Active projects', activeProjects],
  ['Upcoming deadlines', upcomingDeadlines.length],
  ['Planning actions', planningAwaitingAction.length],
  ['Warrant actions', warrantsAwaitingAction.length],
];
---
<AppShell title="Dashboard" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-mono text-xs font-semibold uppercase text-moss">{auth.organisation.name}</p>
      <h1 class="mt-1 text-3xl font-semibold text-ink">Practice dashboard</h1>
    </div>
    <a href="/projects/new" class="btn btn-primary">New project</a>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {stats.map(([label, value]) => (
      <div class="panel rounded-lg p-4">
        <p class="text-sm text-stone-500">{label}</p>
        <p class="mt-3 text-3xl font-semibold">{value}</p>
      </div>
    ))}
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-2">
    <div class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Upcoming deadlines</h2>
      <div class="mt-4 space-y-3">
        {upcomingDeadlines.length ? upcomingDeadlines.map((deadline) => (
          <a href="/deadlines" class="block rounded-md border border-stone-200 p-3 hover:bg-stone-50">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-semibold">{deadline.title}</p>
                <p class="text-sm text-stone-500">{deadline.project?.name ?? 'General'} · {humanizeEnum(deadline.type)}</p>
              </div>
              <span class="status-chip bg-clay/10 text-clay">{formatDate(deadline.dueDate)}</span>
            </div>
          </a>
        )) : <p class="text-sm text-stone-500">No urgent deadlines in the next 14 days.</p>}
      </div>
    </div>

    <div class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Missing document warnings</h2>
      <div class="mt-4 space-y-3">
        {missingWarnings.length ? missingWarnings.map((warning) => (
          <a href={`/projects/${warning.project.id}/files`} class="block rounded-md border border-amber-200 bg-amber-50 p-3">
            <p class="font-semibold">{humanizeEnum(warning.type)} missing</p>
            <p class="text-sm text-stone-600">{warning.project.name}</p>
          </a>
        )) : <p class="text-sm text-stone-500">No missing location or site plan warnings found.</p>}
      </div>
    </div>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-3">
    <div class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Planning awaiting action</h2>
      <div class="mt-4 space-y-3">
        {planningAwaitingAction.length ? planningAwaitingAction.map((item) => (
          <a class="block rounded-md border border-stone-200 p-3 hover:bg-stone-50" href={`/projects/${item.projectId}/planning`}>
            <p class="font-semibold">{item.project.name}</p>
            <p class="text-sm text-stone-500">{humanizeEnum(item.status)}</p>
          </a>
        )) : <p class="text-sm text-stone-500">No planning applications waiting for action.</p>}
      </div>
    </div>

    <div class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Building warrants awaiting action</h2>
      <div class="mt-4 space-y-3">
        {warrantsAwaitingAction.length ? warrantsAwaitingAction.map((item) => (
          <a class="block rounded-md border border-stone-200 p-3 hover:bg-stone-50" href={`/projects/${item.projectId}/building-warrant`}>
            <p class="font-semibold">{item.project.name}</p>
            <p class="text-sm text-stone-500">{humanizeEnum(item.status)} · {humanizeEnum(item.warrantType)}</p>
          </a>
        )) : <p class="text-sm text-stone-500">No warrant applications waiting for action.</p>}
      </div>
    </div>

    <div class="panel rounded-lg p-4">
      <h2 class="text-lg font-semibold">Recent files</h2>
      <div class="mt-4 space-y-3">
        {recentFiles.length ? recentFiles.map((file) => (
          <a class="block rounded-md border border-stone-200 p-3 hover:bg-stone-50" href={`/projects/${file.projectId}/files`}>
            <p class="truncate font-semibold">{file.originalName}</p>
            <p class="text-sm text-stone-500">{file.project.name} · {humanizeEnum(file.type)}</p>
          </a>
        )) : <p class="text-sm text-stone-500">No documents uploaded yet.</p>}
      </div>
    </div>
  </section>
</AppShell>

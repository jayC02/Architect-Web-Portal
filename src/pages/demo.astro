---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import AccessRequestForm from '@/components/marketing/AccessRequestForm.astro';
import { marketingRoutes } from '@/lib/marketing/routes';
import { publicPageShort, setAstroCache } from '@/lib/server/cache-control';

export const prerender = true;
setAstroCache(Astro, publicPageShort);
---
<MarketingLayout
  title="Book a demo | Architect Pro"
  description="See Architect Pro prepare a planning, building warrant and completion certificate application from one of your own projects."
  world="automation"
>
  <section class="hero" style="padding-bottom: clamp(48px, 6vw, 88px);">
    <div class="wrap form-layout">
      <div>
        <p class="eyebrow">Book a demo</p>
        <h1 style="font-size: clamp(38px, 4.6vw, 64px);">See it with one of your own projects.</h1>
        <p class="lede">A 30-minute call with the people who build Architect Pro. Bring a live project and we will prepare its next application in front of you.</p>
        <ol class="side-list">
          <li><span class="dot">01</span><div><h3>Tell us about your practice</h3><p>A few details so we can prepare. We review every request by hand.</p></div></li>
          <li><span class="dot">02</span><div><h3>Walk through a real application</h3><p>Drawings sorted, the draft filled from the project, and the Agent completing the portal.</p></div></li>
          <li><span class="dot">03</span><div><h3>Get an evaluation workspace</h3><p>Approved practices get a 14-day guided evaluation with one licensed Agent, then choose a plan.</p></div></li>
        </ol>
        <p class="footnote">Already know what you need? <a class="text-link" href={marketingRoutes.pricing}>Start a subscription</a> instead.</p>
      </div>
      <AccessRequestForm interest="demo" submitLabel="Request a demo" />
    </div>
  </section>
</MarketingLayout>

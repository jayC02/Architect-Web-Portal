---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { publicPageShort, setAstroCache } from '@/lib/server/cache-control';

export const prerender = true;
setAstroCache(Astro, publicPageShort);
---
<BaseLayout title="Forgot password | Architect Web Portal" noindex>
  <main class="grid min-h-screen place-items-center bg-paper px-4 py-12">
    <form
      data-api-form
      data-action="/api/auth/forgot-password"
      data-method="POST"
      data-reset-on-success
      method="post"
      action="/api/auth/forgot-password"
      class="panel mx-auto w-full max-w-md rounded-lg p-6"
    >
      <div class="mb-6">
        <p class="mb-2 text-xs font-semibold uppercase text-stone-500">Account recovery</p>
        <h1 class="text-2xl font-semibold text-ink">Reset your password</h1>
        <p class="mt-2 text-sm leading-6 text-stone-500">Enter your account email and we will send a secure reset link if an account exists.</p>
      </div>
      <label class="block">
        <span class="label">Email</span>
        <input required type="email" name="email" class="field" autocomplete="email" />
      </label>
      <button class="btn btn-primary mt-6 w-full">Send reset link</button>
      <p data-form-status class="mt-4 text-center text-sm text-stone-500"></p>
      <p class="mt-4 text-center text-sm"><a class="font-semibold text-ink" href="/login">Back to sign in</a></p>
    </form>
  </main>
</BaseLayout>

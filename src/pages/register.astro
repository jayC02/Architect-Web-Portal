---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AuthForm from '@/components/auth/AuthForm';
import { publicPageShort, setAstroCache } from '@/lib/server/cache-control';

setAstroCache(Astro, publicPageShort);
---
<BaseLayout title="Register | Architect Web Portal">
  <main class="grid min-h-screen place-items-center bg-paper px-4 py-12">
    <AuthForm mode="register" client:load />
  </main>
</BaseLayout>

---
import AppShell from '@/components/layout/AppShell.astro';
import LiveDataPanel from '@/components/live/LiveDataPanel';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

---
<AppShell title="Integrations" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href="/settings" class="text-sm font-semibold text-stone-600 hover:text-ink">Back to settings</a>
    <h1 class="mt-2 text-3xl font-semibold">Integrations</h1>
    <p class="mt-1 text-sm text-stone-500">Calendar sync placeholders. Internal deadlines remain the source of truth.</p>
  </div>
  <LiveDataPanel client:idle variant="integrations" endpoint="/api/settings/integrations" />
</AppShell>

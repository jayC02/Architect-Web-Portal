---
import AppShell from '@/components/layout/AppShell.astro';
import { BellRing, CalendarCheck2 } from 'lucide-react';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');
const googleMessage = ({ connected: 'Google sign-in is connected to your account.', account_mismatch: 'Choose the Google account with the same email as your signed-in Architect Pro account.', already_connected: 'That Google account is already connected to another account.' } as Record<string, string>)[Astro.url.searchParams.get('google') ?? ''];
---
<AppShell title="Preferences" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-7 max-w-3xl">
    <a href="/settings" class="text-sm font-semibold text-stone-600 hover:text-ink">Back to settings</a>
    <h1 class="mt-3 text-3xl font-semibold text-ink">Preferences</h1>
    <p class="mt-2 text-sm leading-6 text-stone-600">Architect Pro keeps routine workflow behaviour automatic, with fewer settings to maintain.</p>
  </div>
  <section class="panel max-w-3xl rounded-lg p-5 sm:p-6" aria-labelledby="calendar-reminders-heading">
    <div class="flex items-start gap-4">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-stone-100 text-stone-700"><CalendarCheck2 size={20} aria-hidden="true" /></span>
      <div>
        <h2 id="calendar-reminders-heading" class="text-lg font-semibold text-ink">Calendar & reminders</h2>
        <p class="mt-1 text-sm leading-6 text-stone-600">Important dated commitments, council deadlines and application actions are handled automatically when the relevant integration is connected.</p>
      </div>
    </div>
    <div class="mt-5 flex items-start gap-3 rounded-md border border-stone-200 bg-stone-50 p-4 text-sm leading-6 text-stone-600">
      <BellRing size={18} className="mt-0.5 shrink-0 text-moss" aria-hidden="true" />
      <p>There are no additional reminder preferences to configure at the moment.</p>
    </div>
  </section>
  <section class="panel mt-5 max-w-3xl rounded-lg p-5 sm:p-6" aria-labelledby="google-sign-in-heading">
    <h2 id="google-sign-in-heading" class="text-lg font-semibold text-ink">Google sign-in</h2>
    <p class="mt-1 text-sm leading-6 text-stone-600">Connect the Google account with the same email as your Architect Pro account.</p>
    {googleMessage && <p role="status" class="mt-3 text-sm text-stone-700">{googleMessage}</p>}
    <form data-api-form data-action="/api/auth/google/connect" data-method="POST" class="mt-4">
      <button class="btn btn-secondary">Connect Google sign-in</button>
      <span data-form-status class="ml-3 text-sm text-stone-500" />
    </form>
  </section>
</AppShell>

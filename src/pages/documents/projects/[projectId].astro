---
import { DocumentStatus, DocumentType } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { documentGroupType, documentTypeLabel, preferredDocumentTypes } from '@/lib/document-categories';
import { formatBytes, formatDate, humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const projectId = Astro.params.projectId;
if (!projectId) return Astro.redirect('/documents');

const project = await prisma.project.findFirst({
  where: { id: projectId, organisationId: auth.organisation.id },
  include: {
    client: { select: { name: true } },
    site: { select: { addressLine1: true, townCity: true, postcode: true } },
    documents: {
      include: { uploadedBy: { select: { name: true } } },
      orderBy: { createdAt: 'desc' },
    },
    documentSortBatches: { orderBy: { createdAt: 'desc' }, take: 5 },
  },
});

if (!project) return Astro.redirect('/documents');

const bucketOrder = preferredDocumentTypes.map((type) => ({ type, label: documentTypeLabel(type) }));

const grouped = new Map<DocumentType, typeof project.documents>();
for (const bucket of bucketOrder) grouped.set(bucket.type, []);
for (const document of project.documents) {
  const groupType = documentGroupType(document.type);
  grouped.set(groupType, [...(grouped.get(groupType) ?? []), document]);
}

const projectSummary = [
  project.internalReference,
  project.client?.name,
  project.site ? [project.site.addressLine1, project.site.postcode].filter(Boolean).join(', ') : project.siteAddress,
].filter(Boolean).join(' - ');
---
<AppShell title={`${project.name} documents`} user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <a href="/documents" class="text-sm font-semibold text-stone-600 hover:text-ink">Back to documents</a>
      <h1 class="mt-2 text-3xl font-semibold">{project.name}</h1>
      <p class="mt-1 text-sm text-stone-500">{projectSummary || 'Project document workspace'}</p>
    </div>
    <a href={`/projects/${project.id}/files`} class="btn btn-secondary">Project files page</a>
  </div>

  <section class="panel mb-6 rounded-lg border-l-4 border-l-moss p-5">
    <div class="grid gap-5 lg:grid-cols-[1fr_320px]">
      <div>
        <h2 class="text-xl font-semibold">Upload and auto-sort files</h2>
        <p class="mt-1 text-sm text-stone-500">Drop drawings, reports, plans and correspondence for this project. You will review the compact sorting suggestions before saving.</p>
        <form data-api-form data-action={`/api/projects/${project.id}/document-sort-batches`} data-method="POST" enctype="multipart/form-data" class="mt-4">
          <input type="hidden" name="returnTo" value="document-folder" />
          <label class="block rounded-lg border border-dashed border-stone-300 bg-stone-50 p-5">
            <span class="label">Project documents</span>
            <input required multiple type="file" name="files" class="mt-3 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-ink file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-700" />
          </label>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button class="btn btn-primary">Upload and review sorting</button>
            <p data-form-status class="text-sm text-stone-500"></p>
          </div>
        </form>
      </div>
      <div class="rounded-lg border border-stone-200 bg-white p-4">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-stone-500">Recent sorting batches</h3>
        <div class="mt-3 space-y-2">
          {project.documentSortBatches.length ? project.documentSortBatches.map((batch) => (
            <a href={`/projects/${project.id}/files/sort/${batch.id}?returnTo=document-folder`} class="block rounded-md border border-stone-200 p-3 hover:border-moss">
              <span class="font-semibold">{batch.fileCount} files</span>
              <span class="ml-2 text-sm text-stone-500">{humanizeEnum(batch.status)}</span>
              <p class="mt-1 text-xs text-stone-500">{formatDate(batch.createdAt)}</p>
            </a>
          )) : <p class="text-sm text-stone-500">No auto-sort batches yet.</p>}
        </div>
      </div>
    </div>
  </section>

  <section class="space-y-3">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-xl font-semibold">Document buckets</h2>
      <span class="text-sm text-stone-500">{project.documents.length} document{project.documents.length === 1 ? '' : 's'}</span>
    </div>

    {bucketOrder.map((bucket) => {
      const documents = grouped.get(bucket.type) ?? [];
      return (
        <details class="panel rounded-lg" open={documents.length > 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3">
            <span class="font-semibold">{bucket.label}</span>
            <span class="rounded-md bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-600">{documents.length} file{documents.length === 1 ? '' : 's'}</span>
          </summary>
          <div class="border-t border-stone-100">
            {documents.map((document) => (
              <div class="border-b border-stone-100 px-4 py-3 last:border-b-0">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div class="min-w-0">
                    <a class="font-semibold hover:underline" href={document.storageUrl} target="_blank" rel="noreferrer">{document.originalName}</a>
                    <p class="mt-1 text-xs text-stone-500">
                      {document.revision ? `Rev ${document.revision}` : 'No revision'} - {humanizeEnum(document.status)} - {formatDate(document.createdAt)} - {formatBytes(document.sizeBytes)}
                    </p>
                    {(document.drawingNumber || document.drawingTitle) && (
                      <p class="mt-1 text-xs text-stone-500">{[document.drawingNumber, document.drawingTitle].filter(Boolean).join(' - ')}</p>
                    )}
                  </div>
                  <details class="w-full md:w-auto">
                    <summary class="btn btn-secondary cursor-pointer list-none">Edit classification</summary>
                    <form data-api-form data-action={`/api/documents/${document.id}`} data-method="PATCH" class="mt-3 grid gap-3 rounded-md border border-stone-200 p-3 md:grid-cols-4">
                      <label class="block"><span class="label">Document type</span><select name="type" class="field">{preferredDocumentTypes.map((type) => <option value={type} selected={type === documentGroupType(document.type)}>{documentTypeLabel(type)}</option>)}</select></label>
                      <label class="block"><span class="label">Revision</span><input name="revision" value={document.revision ?? ''} class="field" /></label>
                      <label class="block"><span class="label">Status</span><select name="status" class="field">{Object.values(DocumentStatus).map((status) => <option value={status} selected={status === document.status}>{humanizeEnum(status)}</option>)}</select></label>
                      <label class="block"><span class="label">Notes</span><input name="notes" value={document.notes ?? ''} class="field" /></label>
                      <div class="flex items-center gap-3 md:col-span-4">
                        <button class="btn btn-primary">Save classification</button>
                        <span data-form-status class="text-sm text-stone-500"></span>
                      </div>
                    </form>
                  </details>
                </div>
              </div>
            ))}
            {!documents.length && <div class="px-4 py-6 text-sm text-stone-500">No files in this bucket yet.</div>}
          </div>
        </details>
      );
    })}
  </section>
</AppShell>

---
import UploadQueue from '@/components/documents/UploadQueue';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const projects = await prisma.project.findMany({
  where: { organisationId: auth.organisation.id },
  select: { id: true, name: true, internalReference: true },
  orderBy: { updatedAt: 'desc' },
});

const selectedProjectId = Astro.url.searchParams.get('projectId');
const selectedProject = projects.find((project) => project.id === selectedProjectId) ?? null;
const isProjectScoped = Boolean(selectedProject);
const initialProjectId = selectedProject?.id ?? projects[0]?.id ?? '';

---
<AppShell title="Upload documents" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={isProjectScoped ? `/projects/${selectedProject!.id}#documents` : '/projects'} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to {isProjectScoped ? 'project' : 'projects'}</a>
    <h1 class="mt-2 text-3xl font-semibold">Upload documents</h1>
    <p class="mt-1 text-sm text-stone-500">
      {isProjectScoped ? `Upload files for ${selectedProject!.name}.` : 'Choose a project, upload files, then review the automatic sorting suggestions.'}
    </p>
  </div>

  <section class="panel max-w-4xl rounded-lg p-5">
    {projects.length ? <>
      {!isProjectScoped && <form method="GET" class="mb-5"><label><span class="label">Target project</span><select name="projectId" class="field">{projects.map(project => <option value={project.id} selected={project.id === initialProjectId}>{project.name}</option>)}</select></label><button class="btn btn-secondary mt-3">Choose project</button></form>}
      <UploadQueue client:load baseUrl={`/api/projects/${initialProjectId}/documents`} />
      <p class="mt-4 text-sm text-stone-600">Uploaded documents are analysed in the background. You can review their classifications from the project.</p>
      <a class="btn btn-secondary mt-3" href={`/projects/${initialProjectId}#documents`}>Open project documents</a>
    </> : <p>No projects yet. <a href="/projects/new" class="font-semibold text-moss">Create a project</a> before uploading.</p>}
  </section>


</AppShell>
---
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const projects = await prisma.project.findMany({
  where: { organisationId: auth.organisation.id },
  select: { id: true, name: true, internalReference: true },
  orderBy: { updatedAt: 'desc' },
});

const selectedProjectId = Astro.url.searchParams.get('projectId');
const selectedProject = projects.find((project) => project.id === selectedProjectId) ?? null;
const isProjectScoped = Boolean(selectedProject);
const initialProjectId = selectedProject?.id ?? projects[0]?.id ?? '';
const returnTo = isProjectScoped ? 'project-detail' : 'document-folder';
---
<AppShell title="Upload documents" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6">
    <a href={isProjectScoped ? `/projects/${selectedProject!.id}#documents` : '/documents'} class="text-sm font-semibold text-stone-600 hover:text-ink">Back to {isProjectScoped ? 'project' : 'documents'}</a>
    <h1 class="mt-2 text-3xl font-semibold">Upload documents</h1>
    <p class="mt-1 text-sm text-stone-500">
      {isProjectScoped ? `Upload files for ${selectedProject!.name}.` : 'Choose a project, upload files, then review the automatic sorting suggestions.'}
    </p>
  </div>

  <section class="panel max-w-4xl rounded-lg p-5">
    <form data-api-form data-documents-upload-form data-method="POST" enctype="multipart/form-data" data-action={initialProjectId ? `/api/projects/${initialProjectId}/document-sort-batches` : ''}>
      <input type="hidden" name="returnTo" value={returnTo} data-return-to-input />
      {isProjectScoped ? (
        <input type="hidden" name="projectId" value={initialProjectId} data-documents-project-select />
      ) : null}
      <div class="grid gap-5 md:grid-cols-[320px_1fr]">
        {isProjectScoped ? (
          <div class="rounded-lg border border-stone-200 bg-stone-50 p-4">
            <span class="label">Target project</span>
            <p class="mt-2 font-semibold">{selectedProject!.name}</p>
            {selectedProject!.internalReference && <p class="mt-1 text-sm text-stone-500">{selectedProject!.internalReference}</p>}
            <p class="mt-3 text-xs text-stone-500">This upload is locked to the current project.</p>
          </div>
        ) : (
          <label class="block">
            <span class="label">Target project</span>
            <select required name="projectId" class="field" data-documents-project-select disabled={!projects.length}>
              {projects.map((project) => <option value={project.id} selected={project.id === initialProjectId}>{project.name}{project.internalReference ? ` - ${project.internalReference}` : ''}</option>)}
            </select>
          </label>
        )}
        <label class="block rounded-lg border border-dashed border-stone-300 bg-stone-50 p-5 transition hover:border-moss hover:bg-white">
          <span class="label">Files</span>
          <p class="mt-1 text-sm text-stone-500">Upload PDFs, drawings, specifications, photos or supporting documents.</p>
          <input required multiple type="file" name="files" class="mt-4 block w-full text-sm text-stone-700 file:mr-4 file:rounded-md file:border-0 file:bg-ink file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-stone-700" disabled={!projects.length} />
        </label>
      </div>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button class="btn btn-primary" disabled={!projects.length}>Upload and review sorting</button>
        <p data-form-status class="text-sm text-stone-500">{!projects.length ? 'Create a project before uploading documents.' : ''}</p>
      </div>
    </form>
  </section>

  <script>
    const uploadForm = document.querySelector('[data-documents-upload-form]');
    const projectSelect = document.querySelector('[data-documents-project-select]');
    const syncUploadAction = () => {
      if (!(uploadForm instanceof HTMLFormElement)) return;
      if (projectSelect instanceof HTMLSelectElement) {
        uploadForm.dataset.action = projectSelect.value ? `/api/projects/${projectSelect.value}/document-sort-batches` : '';
        return;
      }
      if (projectSelect instanceof HTMLInputElement) {
        uploadForm.dataset.action = projectSelect.value ? `/api/projects/${projectSelect.value}/document-sort-batches` : '';
      }
    };
    projectSelect?.addEventListener('change', syncUploadAction);
    syncUploadAction();
  </script>
</AppShell>
---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import LineArt from '@/components/marketing/LineArt.astro';
import ClosingCta from '@/components/marketing/ClosingCta.astro';
import Doodle from '@/components/marketing/Doodle.astro';
import { publicPageShort, setAstroCache } from '@/lib/server/cache-control';

export const prerender = true;
setAstroCache(Astro, publicPageShort);

const principles = [
  { title: 'Architecture first', body: 'Every feature is judged by one question: does it give an architect time back for design?' },
  { title: 'You stay in charge', body: 'Architect Pro prepares and submits, but nothing goes to a council or verifier without your approval.' },
  { title: 'Built for Scotland', body: 'Planning, building warrants and completion certificates as they work here, not a generic UK template.' },
];
---
<MarketingLayout
  title="About | Architect Pro"
  description="Architect Pro is built in Scotland to take the portal work out of planning, building warrant and completion certificate applications."
  world="time"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">About</p>
        <h1>Less portal. More architecture.</h1>
        <p class="lede">Architect Pro started with a simple observation: Scottish practices spend hours each month re-typing project details into government portals. That time belongs to design.</p>
      </div>
      <LineArt variant="elevation" />
    </div>
  </section>

  <section class="section" aria-labelledby="story-title">
    <div class="wrap section-head">
      <div class="head-with-art">
        <Doodle variant="dividers" class="head-art" />
        <h2 id="story-title">Why we built it.</h2>
      </div>
      <div class="body-copy" style="display: grid; gap: 16px;">
        <p>Every application starts with information a practice already holds: the site, the client, the drawings and the description of works. Yet each one is keyed in again, field by field, document by document, into a portal that can time out halfway through.</p>
        <p>We built Architect Pro so that information lives in one project record, applications are prepared from it, and a desktop Agent completes the portal on your behalf. You review, approve and pay. It keeps track of what happens next.</p>
        <p>We are a small team working directly with practices across Scotland. If you book a demo, you will speak to the people who build the product.</p>
      </div>
    </div>
  </section>

  <section class="section tint" aria-labelledby="principles-title">
    <div class="wrap">
      <div class="section-head single">
        <div class="head-with-art">
          <Doodle variant="north" class="head-art" />
          <h2 id="principles-title">What we hold to.</h2>
        </div>
      </div>
      <div class="grid three">
        {principles.map((item, index) => (
          <article class="card reveal">
            <span class="icon num" style="font-size: 14px;">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta title="We would like to meet your practice." />
</MarketingLayout>

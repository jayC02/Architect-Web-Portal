---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import AccessRequestForm from '@/components/marketing/AccessRequestForm.astro';
import { marketingRoutes, contactDetails } from '@/lib/marketing/routes';
import { publicPageShort, setAstroCache } from '@/lib/server/cache-control';

export const prerender = true;
setAstroCache(Astro, publicPageShort);
---
<MarketingLayout
  title="Contact | Architect Pro"
  description="Questions about Architect Pro, pricing or your account. Get in touch with the team."
  world="tracking"
>
  <section class="hero" style="padding-bottom: clamp(48px, 6vw, 88px);">
    <div class="wrap form-layout">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 style="font-size: clamp(38px, 4.6vw, 64px);">Talk to the team.</h1>
        <p class="lede">Questions about Architect Pro, pricing or how it would fit your practice. We reply within one working day.</p>
        <ul class="side-list">
          <li><span class="dot" aria-hidden="true">@</span><div><h3>Sales and demos</h3><p><a class="text-link" href={`mailto:${contactDetails.salesEmail}`}>{contactDetails.salesEmail}</a></p></div></li>
          <li><span class="dot" aria-hidden="true">?</span><div><h3>Existing customers</h3><p>Sign in and use Help in your workspace, or email <a class="text-link" href={`mailto:${contactDetails.supportEmail}`}>{contactDetails.supportEmail}</a>.</p></div></li>
          <li><span class="dot" aria-hidden="true">◎</span><div><h3>Where we are</h3><p>{contactDetails.location}</p></div></li>
        </ul>
        <p class="footnote">Want to see the product? <a class="text-link" href={marketingRoutes.demo}>Book a demo</a>.</p>
      </div>
      <AccessRequestForm interest="question" submitLabel="Send message" />
    </div>
  </section>
</MarketingLayout>

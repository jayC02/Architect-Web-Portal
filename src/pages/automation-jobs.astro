---
import { AutomationJobStatus, AutomationJobType } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { prisma } from '@/lib/db/prisma';
import { formatDate, humanizeEnum } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const projectId = Astro.url.searchParams.get('projectId');
const jobs = await prisma.automationJob.findMany({
  where: { organisationId: auth.organisation.id, ...(projectId ? { projectId } : {}) },
  include: {
    project: { select: { id: true, name: true, internalReference: true } },
    createdBy: { select: { name: true, email: true } },
    claimedBy: { select: { name: true, email: true } },
  },
  orderBy: { createdAt: 'desc' },
  take: 100,
});

const statusTone = (status: AutomationJobStatus) => {
  if (status === AutomationJobStatus.READY) return 'bg-emerald-50 text-emerald-800 border-emerald-200';
  if (status === AutomationJobStatus.FAILED || status === AutomationJobStatus.CANCELLED) return 'bg-red-50 text-red-800 border-red-200';
  if (status === AutomationJobStatus.COMPLETED) return 'bg-stone-100 text-stone-700 border-stone-200';
  return 'bg-amber-50 text-amber-800 border-amber-200';
};

const typeText = (type: AutomationJobType) => type === AutomationJobType.HOUSEHOLDER_PLANNING ? 'Householder planning' : humanizeEnum(type);
---
<AppShell title="Automation jobs" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-stone-500">Desktop handoff</p>
      <h1 class="mt-2 text-3xl font-semibold">Automation jobs</h1>
      <p class="mt-1 max-w-2xl text-sm text-stone-500">{projectId ? 'Showing jobs for this project.' : 'Prepare clean, organisation-scoped project snapshots for the desktop automation app to consume later.'}</p>
    </div>
    <div class="flex gap-2">{projectId && <a class="btn btn-secondary" href="/automation-jobs">Show all jobs</a>}<a class="btn btn-primary" href="/projects">Prepare from project</a></div>
  </div>

  {jobs.length === 0 ? (
    <section class="panel rounded-lg p-8 text-center">
      <h2 class="text-xl font-semibold">No automation jobs yet</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm text-stone-500">Open a project and prepare a planning, householder or building warrant job. Jobs stay as drafts until you mark them ready.</p>
      <a class="btn btn-primary mt-5" href="/projects">Go to projects</a>
    </section>
  ) : (
    <div class="space-y-4">
      {jobs.map((job) => (
        <article class="panel rounded-lg p-4 transition hover:shadow-[0_18px_50px_rgba(32,35,31,0.08)]">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class={`rounded-full border px-2.5 py-1 text-xs font-semibold ${statusTone(job.status)}`}>{humanizeEnum(job.status)}</span>
                <span class="rounded-full border border-stone-200 bg-stone-50 px-2.5 py-1 text-xs font-semibold text-stone-600">{typeText(job.type)}</span>
                <span class="rounded-full border border-stone-200 bg-white px-2.5 py-1 text-xs font-semibold text-stone-600">{humanizeEnum(job.sourceType)}</span>
              </div>
              <h2 class="mt-3 truncate text-lg font-semibold">{job.title}</h2>
              <p class="mt-1 text-sm text-stone-500">
                <a class="font-semibold text-ink hover:underline" href={`/projects/${job.project.id}`}>{job.project.name}</a>
                {job.project.internalReference ? ` - ${job.project.internalReference}` : ''}
              </p>
              <p class="mt-1 text-xs text-stone-500">Created {formatDate(job.createdAt)} by {job.createdBy.name}</p>
              {job.error && <p class="mt-2 text-sm text-red-700">{job.error}</p>}
            </div>
            <div class="flex flex-wrap gap-2 lg:justify-end">
              {job.status !== AutomationJobStatus.READY && job.status !== AutomationJobStatus.COMPLETED && job.status !== AutomationJobStatus.CANCELLED && (
                <form data-api-form data-action={`/api/automation-jobs/${job.id}`} data-method="PATCH">
                  <input type="hidden" name="status" value="READY" />
                  <button class="btn btn-primary">Mark ready</button>
                </form>
              )}
              {job.status !== AutomationJobStatus.CANCELLED && job.status !== AutomationJobStatus.COMPLETED && (
                <form data-api-form data-action={`/api/automation-jobs/${job.id}`} data-method="PATCH" data-confirm="Cancel this automation job?">
                  <input type="hidden" name="status" value="CANCELLED" />
                  <button class="btn btn-secondary">Cancel</button>
                </form>
              )}
            </div>
          </div>
          <details class="mt-4 rounded-lg border border-stone-200 bg-stone-50/60 p-3">
            <summary class="cursor-pointer text-sm font-semibold text-stone-700">View snapshot contract</summary>
            <div class="mt-3 grid gap-3 xl:grid-cols-2">
              <div>
                <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Data snapshot</p>
                <pre class="max-h-96 overflow-auto rounded-md bg-white p-3 text-xs text-stone-700">{JSON.stringify(job.dataSnapshot, null, 2)}</pre>
              </div>
              <div>
                <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Document snapshot</p>
                <pre class="max-h-96 overflow-auto rounded-md bg-white p-3 text-xs text-stone-700">{JSON.stringify(job.documentSnapshot, null, 2)}</pre>
              </div>
            </div>
          </details>
        </article>
      ))}
    </div>
  )}
</AppShell>

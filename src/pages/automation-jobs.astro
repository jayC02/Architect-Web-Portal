---
import { AutomationJobStatus, AutomationJobType } from '@prisma/client';
import AppShell from '@/components/layout/AppShell.astro';
import { ExistingAutomationJobButton } from '@/components/automation/AutomationLaunchButton';
import { prisma } from '@/lib/db/prisma';
import { formatDate } from '@/lib/format';
import { requirePageAuth } from '@/lib/server/page-auth';
import {
  automationJobDocumentCount,
  desktopAutomationJobSelect,
  desktopAutomationPresentation,
} from '@/server/services/desktop-automation-status.service';

const auth = await requirePageAuth(Astro as never);
if (!auth) return Astro.redirect('/login');

const attentionStatuses: AutomationJobStatus[] = [
  AutomationJobStatus.DRAFT,
  AutomationJobStatus.PREFLIGHT_REQUIRED,
  AutomationJobStatus.NEEDS_INPUT,
  AutomationJobStatus.STALE,
  AutomationJobStatus.NEEDS_REVIEW,
  AutomationJobStatus.AWAITING_PORTAL_REVIEW,
  AutomationJobStatus.FAILED_RETRYABLE,
  AutomationJobStatus.FAILED,
];
const activeStatuses: AutomationJobStatus[] = [
  ...attentionStatuses,
  AutomationJobStatus.READY,
  AutomationJobStatus.CLAIMED,
  AutomationJobStatus.IN_PROGRESS,
];
const historyStatuses: AutomationJobStatus[] = [
  AutomationJobStatus.COMPLETED,
  AutomationJobStatus.FAILED_FINAL,
  AutomationJobStatus.CANCELLED,
];

type View = 'active' | 'attention' | 'history';
const requestedView = Astro.url.searchParams.get('view');
const view: View = requestedView === 'attention' || requestedView === 'history'
  ? requestedView
  : 'active';
const projectId = Astro.url.searchParams.get('projectId');
const statusFilter = view === 'attention'
  ? attentionStatuses
  : view === 'history'
    ? historyStatuses
    : activeStatuses;

const jobs = await prisma.automationJob.findMany({
  where: {
    organisationId: auth.organisation.id,
    status: { in: statusFilter },
    ...(projectId ? { projectId } : {}),
  },
  select: {
    ...desktopAutomationJobSelect,
    project: { select: { id: true, name: true, internalReference: true } },
  },
  orderBy: [{ updatedAt: 'desc' }, { createdAt: 'desc' }],
  take: 100,
});

if (view === 'active') {
  const priority = (status: AutomationJobStatus) => attentionStatuses.includes(status)
    ? 0
    : status === AutomationJobStatus.READY
      ? 1
      : 2;
  jobs.sort((left, right) => priority(left.status) - priority(right.status)
    || right.updatedAt.getTime() - left.updatedAt.getTime());
}

const applicationLabel = (type: AutomationJobType) => type === AutomationJobType.BUILDING_WARRANT
  ? 'Building Warrant'
  : 'Householder application';
const applicationHref = (job: typeof jobs[number]) => job.type === AutomationJobType.BUILDING_WARRANT
  ? `/projects/${job.projectId}/building-warrant`
  : `/projects/${job.projectId}/planning`;
const updatedDate = (job: typeof jobs[number]) =>
  job.completedAt ?? job.claimedAt ?? job.preparedAt ?? job.updatedAt;

const tabs: Array<{ value: View; label: string; description: string }> = [
  { value: 'active', label: 'Active', description: 'Ready, running and unresolved desktop work.' },
  { value: 'attention', label: 'Needs attention', description: 'Applications that need review or recovery.' },
  { value: 'history', label: 'History', description: 'Completed, final failures and cancelled runs.' },
];
---
<AppShell title="Desktop job history" user={auth.user} organisation={auth.organisation} role={auth.membership.role}>
  <header class="mb-6">
    <a class="text-sm font-semibold text-stone-600 hover:text-ink" href="/settings">Back to settings</a>
    <h1 class="mt-3 text-3xl font-semibold">Desktop job history</h1>
    <p class="mt-2 text-sm text-stone-600">View current and previous desktop application runs.</p>
  </header>

  <nav aria-label="Desktop job history filters" class="mb-5 flex flex-wrap gap-2">
    {tabs.map((tab) => (
      <a
        href={`/automation-jobs?view=${tab.value}${projectId ? `&projectId=${encodeURIComponent(projectId)}` : ''}`}
        aria-current={view === tab.value ? 'page' : undefined}
        class:list={[
          'rounded-md border px-4 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2',
          view === tab.value
            ? 'border-ink bg-ink text-white'
            : 'border-stone-200 bg-white text-stone-700 hover:border-stone-300 hover:text-ink',
        ]}
      >{tab.label}</a>
    ))}
  </nav>

  <section class="panel overflow-hidden rounded-lg">
    <div class="border-b border-stone-200 px-4 py-4 sm:px-5">
      <h2 class="text-lg font-semibold">{tabs.find((tab) => tab.value === view)?.label}</h2>
      <p class="mt-1 text-sm text-stone-500">{tabs.find((tab) => tab.value === view)?.description}</p>
    </div>

    {jobs.length ? (
      <div class="divide-y divide-stone-200">
        {jobs.map((job) => {
          const presentation = desktopAutomationPresentation(job.status);
          const documentCount = automationJobDocumentCount(job);
          const isAttention = presentation.kind === 'attention' || presentation.kind === 'failed';
          const isProgress = presentation.kind === 'progress';
          const isCompleted = presentation.kind === 'completed';
          const isCancelled = presentation.kind === 'cancelled';
          return (
            <article class="px-4 py-5 sm:px-5">
              <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(220px,0.6fr)_auto] lg:items-center">
                <div class="min-w-0">
                  <a class="block truncate text-lg font-semibold hover:underline" href={`/projects/${job.projectId}`}>{job.project.name}</a>
                  <p class="mt-1 text-sm text-stone-600">
                    {applicationLabel(job.type)}
                    {job.project.internalReference ? ` / Ref ${job.project.internalReference}` : ''}
                  </p>
                  <p class="mt-2 text-xs text-stone-500">
                    Updated {formatDate(updatedDate(job))}
                    {documentCount > 0 ? ` / ${documentCount} document${documentCount === 1 ? '' : 's'}` : ''}
                  </p>
                </div>

                <div>
                  <div class="flex items-center gap-2">
                    <span class:list={[
                      'h-2 w-2 shrink-0 rounded-full',
                      presentation.kind === 'failed' ? 'bg-red-700'
                        : presentation.kind === 'attention' ? 'bg-amber-600'
                          : presentation.kind === 'ready' || presentation.kind === 'completed' ? 'bg-moss'
                            : 'bg-stone-500',
                    ]} aria-hidden="true"></span>
                    <p class="font-semibold">{presentation.label}</p>
                  </div>
                  <p class="mt-1 text-sm leading-6 text-stone-500">{presentation.description}</p>
                </div>

                <div class="flex flex-col items-start gap-2 lg:items-end">
                  {job.status === AutomationJobStatus.READY && (
                    <ExistingAutomationJobButton client:load jobId={job.id} label="Open in desktop" />
                  )}
                  {isAttention && (
                    <a class="btn btn-primary" href={`/automation-job/${job.id}`}>
                      {presentation.kind === 'failed' ? 'Review issue' : 'Review application'}
                    </a>
                  )}
                  {isProgress && <a class="btn btn-secondary" href={`/automation-job/${job.id}`}>View status</a>}
                  {isCompleted && <a class="btn btn-secondary" href={applicationHref(job)}>View application</a>}
                  {!isCancelled && !isCompleted && (
                    <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
                      <a class="font-semibold text-stone-600 hover:text-ink" href={applicationHref(job)}>View application</a>
                      <a class="font-semibold text-stone-600 hover:text-ink" href={`/projects/${job.projectId}`}>View project</a>
                    </div>
                  )}
                  {isCancelled && <a class="text-sm font-semibold text-stone-600 hover:text-ink" href={`/projects/${job.projectId}`}>View project</a>}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="px-5 py-12 text-center">
        <h2 class="text-lg font-semibold">No {view === 'active' ? 'active desktop work' : view === 'attention' ? 'applications need attention' : 'desktop history yet'}</h2>
        <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-stone-500">
          Desktop preparation begins from a Project, Householder application or Building Warrant application.
        </p>
        <a class="btn btn-secondary mt-5" href="/projects">View projects</a>
      </div>
    )}
  </section>
</AppShell>

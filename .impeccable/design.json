  "narrative": {
    "northStar": "The civic architecture centre",
    "overview": "This system applies to the redesigned `/dashboard` and elements inside `.practice-shell`. It describes the built dashboard, not an application-wide theme migration. Other routes retain their existing warm palette and components.\n\nCool steel-blue navigation, white work surfaces and compact system typography give the practice a clear working environment. Brand expression comes from the shared project-stage palette and precise alignment, while navigation, search, filters and date controls remain familiar.",
    "keyCharacteristics": [
      "A project register with stage and next action visible together.",
      "Cool tonal layering with indigo selection and restrained state colours.",
      "Responsive density that preserves access to projects on small screens.",
      "Existing Architect Pro logo assets and consistent Lucide line icons."
    ],
    "rules": [
      {
        "name": "The Shared Phase Rule",
        "body": "A project stage uses the same colour family in the pipeline and the project register. Always pair colour with a text label.",
        "section": "colors"

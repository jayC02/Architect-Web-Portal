generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganisationRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuthProviderType {
  GOOGLE
}

enum ProjectStage {
  LEAD
  SURVEY
  DESIGN
  PLANNING
  BUILDING_WARRANT
  CONSTRUCTION
  COMPLETION
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum DocumentType {
  LOCATION_PLAN
  SITE_PLAN
  BLOCK_PLAN
  EXISTING_DRAWING
  PROPOSED_DRAWING
  ELEVATION
  SECTION
  DETAILS
  CALCULATIONS
  SPECIFICATIONS
  DRAINAGE
  STRUCTURAL
  ENERGY
  CERTIFICATE
  PHOTO
  CORRESPONDENCE
  SUPPORTING_DOCUMENT
  OTHER
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
  REJECTED
}

enum DocumentSortBatchStatus {
  UPLOADED
  ANALYSING
  NEEDS_REVIEW
  ACCEPTED
  FAILED
}

enum DocumentSortSource {
  AI
  RULES
  PDF_TEXT
  MANUAL
}

enum PlanningStatus {
  NOT_STARTED
  DRAFTING
  SUBMITTED
  VALIDATED
  IN_REVIEW
  FURTHER_INFORMATION_REQUESTED
  APPROVED
  REFUSED
  WITHDRAWN
  CLOSED
}

enum WarrantType {
  INITIAL
  AMENDMENT
  STAGED
  LATE
  COMPLETION_CERTIFICATE
}

enum WarrantStatus {
  NOT_STARTED
  DRAFTING
  SUBMITTED
  IN_REVIEW
  FURTHER_INFORMATION_REQUESTED
  GRANTED
  REJECTED
  EXPIRED
  COMPLETED
  CLOSED
}

enum CompletionCertificateStatus {
  NOT_REQUIRED
  NOT_STARTED
  DRAFTING
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum DeadlineType {
  PLANNING_DECISION
  WARRANT_RESPONSE
  WARRANT_EXPIRY
  COMPLETION_CERTIFICATE
  CLIENT_ACTION
  INTERNAL_TASK
  INSPECTION
  CUSTOM
}

enum DeadlineStatus {
  UPCOMING
  DUE_SOON
  OVERDUE
  COMPLETED
  CANCELLED
}

enum DeadlinePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

enum CalendarConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
  PAUSED
}

enum XeroConnectionStatus {
  IDLE
  SYNCING
  CONNECTED
  ERROR
  RECONNECT_REQUIRED
  DISCONNECTED
}

enum XeroReportType {
  PROFIT_AND_LOSS
  AGED_RECEIVABLES
}

enum GmailMatchStatus {
  UNMATCHED
  MATCHED
  AMBIGUOUS
  UNRELATED
}

enum GmailProcessingStatus {
  DISCOVERED
  PROCESSED
  NEEDS_REVIEW
  FAILED
}

enum GmailSuggestionStatus {
  PENDING
  APPLIED
  REJECTED
  FAILED
}

enum GmailUpdateType {
  PLANNING_APPLICATION
  BUILDING_WARRANT
  DEADLINE
  PROJECT_ACTIVITY
}

enum GmailPlanningClassification {
  APPLICATION_RECEIVED
  APPLICATION_VALIDATED
  INFORMATION_REQUESTED
  DECISION_APPROVED
  DECISION_REFUSED
  DECISION_OTHER
  LIKELY_PROJECT_EMAIL
  UNKNOWN
}

enum SubmissionPackageType {
  PLANNING
  BUILDING_WARRANT
}

enum SubmissionPackageStatus {
  DRAFT
  READY
  EXPORTED
  SUBMITTED
  ARCHIVED
}

enum AutomationJobType {
  HOUSEHOLDER_PLANNING
  PLANNING_APPLICATION
  BUILDING_WARRANT
}

enum AutomationJobStatus {
  DRAFT
  PREFLIGHT_REQUIRED
  NEEDS_INPUT
  READY
  STALE
  CLAIMED
  IN_PROGRESS
  NEEDS_REVIEW
  AWAITING_PORTAL_REVIEW
  COMPLETED
  FAILED_RETRYABLE
  FAILED_FINAL
  FAILED
  CANCELLED
}

enum AutomationJobSourceType {
  PROJECT
  PLANNING_RECORD
  WARRANT_RECORD
  DOCUMENT_BATCH
  MANUAL
}

enum ApplicationDraftStatus {
  UPLOADING
  ANALYSING
  NEEDS_REVIEW
  READY_TO_CREATE
  COMMITTING
  COMMITTED
  FAILED
  CANCELLED
  EXPIRED
}

enum ApplicationDraftDocumentUploadStatus {
  UPLOADING
  UPLOADED
  READY
  FAILED
}

enum ApplicationDraftType {
  AUTO
  HOUSEHOLDER_PLANNING
  PLANNING_APPLICATION
  BUILDING_WARRANT
}

enum ApplicationDraftDocumentStatus {
  PENDING
  ANALYSING
  SUCCESS
  FALLBACK
  FAILED
}

enum LifecycleAggregateType {
  PROJECT
  PLANNING_APPLICATION
  BUILDING_WARRANT_APPLICATION
}

enum LifecycleEventType {
  PROJECT_CREATED
  DOCUMENT_REVIEW_COMPLETED
  PLANNING_READY
  PLANNING_READINESS_REVOKED
  PLANNING_SUBMITTED
  PLANNING_VALIDATED
  PLANNING_INFORMATION_REQUESTED
  PLANNING_APPROVED
  BUILDING_WARRANT_READY
  BUILDING_WARRANT_READINESS_REVOKED
}

enum LifecycleEventSource {
  MANUAL_PROJECT
  APPLICATION_DRAFT
  APPLICATION_PREFLIGHT
  APPLICATION_STATUS
  GMAIL
}

enum LifecycleActorType {
  USER
  SYSTEM
}

enum WorkflowEffectStatus {
  PENDING
  PROCESSING
  RETRYABLE
  COMPLETED
  FAILED_FINAL
}

enum ActionItemKind {
  DOCUMENT_REVIEW
  PLANNING_PREPARATION
  PLANNING_FINAL_REVIEW
  BUILDING_WARRANT_ACTION
  BUILDING_WARRANT_FINAL_REVIEW
  PLANNING_CORRESPONDENCE
  GMAIL_MONITORING
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActionItemStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ProjectActivityEventType {
  PROJECT_CREATED
  DOCUMENT_REVIEW_COMPLETED
  PLANNING_READY
  PLANNING_SUBMITTED
  PLANNING_VALIDATED
  PLANNING_INFORMATION_REQUESTED
  PLANNING_APPROVED
  DECISION_NOTICE_IMPORTED
  BUILDING_WARRANT_ACTIVATED
  BUILDING_WARRANT_READY
  WORKFLOW_DEADLINE_OVERRIDDEN
}

enum ProjectActivityVisibility {
  STANDARD
}

enum WorkflowTargetKey {
  PROJECT_DOCUMENT_REVIEW
  PLANNING_PREPARATION
  PLANNING_FINAL_REVIEW
  BUILDING_WARRANT_ACTION
  BUILDING_WARRANT_FINAL_REVIEW
}

enum DeadlineManagedBy {
  MANUAL
  WORKFLOW
  GMAIL
  PORTAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions                 Session[]
  authProviders            AuthProvider[]
  passwordResetTokens      PasswordResetToken[]
  organisationLinks        OrganisationMember[]
  uploadedDocuments        ProjectDocument[]        @relation("DocumentUploadedBy")
  documentSortBatches      DocumentSortBatch[]      @relation("DocumentSortBatchCreatedBy")
  createdPackages          SubmissionPackage[]      @relation("PackageCreatedBy")
  createdAutomationJobs    AutomationJob[]          @relation("AutomationJobCreatedBy")
  claimedAutomationJobs    AutomationJob[]          @relation("AutomationJobClaimedBy")
  desktopAccessTokens      DesktopAccessToken[]
  createdApplicationDrafts ApplicationDraft[]       @relation("ApplicationDraftCreatedBy")
  reviewedGmailSuggestions GmailUpdateSuggestion[]  @relation("GmailSuggestionReviewedBy")
  xeroOAuthStates          XeroOAuthState[]
  xeroClientLinks          XeroClientLink[]         @relation("XeroClientLinkCreatedBy")
  xeroProjectInvoiceLinks  XeroProjectInvoiceLink[] @relation("XeroProjectInvoiceLinkCreatedBy")
  lifecycleEvents          LifecycleEvent[]         @relation("LifecycleEventActor")
  projectActivities        ProjectActivity[]        @relation("ProjectActivityActor")
  deadlineOverrides        Deadline[]               @relation("DeadlineManualOverrideBy")

  @@index([email])
  @@index([createdAt])
}

model AuthProvider {
  id                String           @id @default(cuid())
  userId            String
  provider          AuthProviderType
  providerAccountId String
  email             String?
  displayName       String?
  avatarUrl         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PendingOAuthSignup {
  id                String           @id @default(cuid())
  tokenHash         String           @unique
  provider          AuthProviderType
  providerAccountId String
  email             String
  displayName       String
  avatarUrl         String?
  expiresAt         DateTime
  createdAt         DateTime         @default(now())

  @@unique([provider, providerAccountId])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              OrganisationMember[]
  clients              Client[]
  sites                Site[]
  projects             Project[]
  documents            ProjectDocument[]
  planningApplications PlanningApplication[]
  warrantApplications  BuildingWarrantApplication[]
  deadlines            Deadline[]
  calendarConnections  CalendarConnection[]
  syncedCalendarEvents SyncedCalendarEvent[]
  submissionPackages   SubmissionPackage[]
  documentSortBatches  DocumentSortBatch[]
  automationJobs       AutomationJob[]
  desktopAccessTokens  DesktopAccessToken[]
  trackedEmails        TrackedEmail[]
  gmailSuggestions     GmailUpdateSuggestion[]
  gmailAttachments     GmailAttachment[]
  defaults             OrganisationDefaults?
  certifierPresets     OrganisationCertifierPreset[]
  automationJobEvents  AutomationJobEvent[]
  applicationDrafts    ApplicationDraft[]
  xeroConnections      XeroConnection[]
  xeroOAuthStates      XeroOAuthState[]
  xeroContacts         XeroContactSnapshot[]
  xeroClientLinks      XeroClientLink[]
  xeroInvoices         XeroInvoiceSnapshot[]
  xeroPayments         XeroPaymentSnapshot[]
  xeroProjectLinks     XeroProjectInvoiceLink[]
  xeroReports          XeroReportSnapshot[]
  xeroAgedReceivables  XeroAgedReceivableSnapshot[]
  lifecycleEvents      LifecycleEvent[]
  workflowEffects      WorkflowEffect[]
  actionItems          ActionItem[]
  projectActivities    ProjectActivity[]
  workflowTargets      WorkflowTarget[]

  @@index([slug])
  @@index([updatedAt])
}

model OrganisationMember {
  id             String           @id @default(cuid())
  organisationId String
  userId         String
  role           OrganisationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([organisationId, role])
}

model Client {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  email          String?
  phone          String?
  address        String?
  notes          String?
  title          String?
  firstName      String?
  lastName       String?
  companyName    String?
  buildingNumber String?
  addressLine1   String?
  addressLine2   String?
  townCity       String?
  postcode       String?
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projects     Project[]
  xeroLink     XeroClientLink?

  @@index([organisationId, name])
  @@index([organisationId, updatedAt])
}

model OrganisationDefaults {
  id                       String   @id @default(cuid())
  organisationId           String   @unique
  practiceName             String?
  agentFirstName           String?
  agentLastName            String?
  agentEmail               String?
  agentPhone               String?
  agentBuildingNumber      String?
  agentAddressLine1        String?
  agentAddressLine2        String?
  agentTownCity            String?
  agentPostcode            String?
  agentCountry             String   @default("United Kingdom")
  defaultCertifierPresetId String?
  applicationDefaults      Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organisation           Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  defaultCertifierPreset OrganisationCertifierPreset? @relation("DefaultOrganisationCertifier", fields: [defaultCertifierPresetId], references: [id], onDelete: SetNull)

  @@index([defaultCertifierPresetId])
}

model OrganisationCertifierPreset {
  id                 String   @id @default(cuid())
  organisationId     String
  displayName        String
  schemeType         String?
  registrationAPart1 String?
  registrationAPart2 String?
  registrationBPart1 String?
  registrationBPart2 String?
  certifierName      String?
  approvedBody       String?
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  defaults     OrganisationDefaults[]       @relation("DefaultOrganisationCertifier")
  warrants     BuildingWarrantApplication[]

  @@unique([organisationId, displayName])
  @@index([organisationId, isDefault])
}

model Site {
  id             String   @id @default(cuid())
  organisationId String
  buildingNumber String?
  addressLine1   String
  addressLine2   String?
  townCity       String
  postcode       String
  localAuthority String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organisationId, postcode])
  @@index([organisationId, updatedAt])
}

model Project {
  id                String        @id @default(cuid())
  organisationId    String
  clientId          String?
  siteId            String?
  name              String
  internalReference String?
  projectType       String?
  stage             ProjectStage  @default(LEAD)
  localAuthority    String?
  siteAddress       String?
  status            ProjectStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organisation         Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client               Client?                      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  site                 Site?                        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  documents            ProjectDocument[]
  planningApplications PlanningApplication[]
  warrantApplications  BuildingWarrantApplication[]
  deadlines            Deadline[]
  submissionPackages   SubmissionPackage[]
  documentSortBatches  DocumentSortBatch[]
  automationJobs       AutomationJob[]
  trackedEmails        TrackedEmail[]
  gmailSuggestions     GmailUpdateSuggestion[]
  xeroInvoiceLinks     XeroProjectInvoiceLink[]
  lifecycleEvents      LifecycleEvent[]
  actionItems          ActionItem[]
  activities           ProjectActivity[]

  @@index([organisationId, status, updatedAt])
  @@index([organisationId, updatedAt])
  @@index([organisationId, stage])
  @@index([organisationId, clientId])
  @@index([organisationId, siteId])
}

model LifecycleEvent {
  id             String                 @id @default(cuid())
  organisationId String
  projectId      String
  aggregateType  LifecycleAggregateType
  aggregateId    String
  eventType      LifecycleEventType
  schemaVersion  Int                    @default(1)
  payload        Json
  source         LifecycleEventSource
  actorType      LifecycleActorType
  actorUserId    String?
  occurredAt     DateTime
  dispatchedAt   DateTime?
  idempotencyKey String
  createdAt      DateTime               @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUser    User?             @relation("LifecycleEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  effects      WorkflowEffect[]
  actionItems  ActionItem[]
  activities   ProjectActivity[]

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId, dispatchedAt, createdAt])
  @@index([organisationId, projectId, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([actorUserId])
}

model WorkflowEffect {
  id               String               @id @default(cuid())
  organisationId   String
  lifecycleEventId String
  handlerKey       String
  status           WorkflowEffectStatus @default(PENDING)
  attempts         Int                  @default(0)
  availableAt      DateTime             @default(now())
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  lastError        String?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lifecycleEvent LifecycleEvent @relation(fields: [lifecycleEventId], references: [id], onDelete: Cascade)

  @@unique([lifecycleEventId, handlerKey])
  @@index([organisationId, status, availableAt])
  @@index([status, availableAt, leaseExpiresAt])
  @@index([leaseOwner, leaseExpiresAt])
}

model ActionItem {
  id                     String             @id @default(cuid())
  organisationId         String
  projectId              String?
  sourceLifecycleEventId String?
  kind                   ActionItemKind
  title                  String
  summary                String?
  actionUrl              String
  priority               ActionItemPriority @default(MEDIUM)
  status                 ActionItemStatus   @default(OPEN)
  availableAt            DateTime           @default(now())
  dueAt                  DateTime?
  resolvedAt             DateTime?
  dedupeKey              String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organisation         Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project              Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceLifecycleEvent LifecycleEvent? @relation(fields: [sourceLifecycleEventId], references: [id], onDelete: Cascade)

  @@unique([organisationId, dedupeKey])
  @@index([organisationId, status, priority, availableAt])
  @@index([organisationId, projectId, status])
  @@index([sourceLifecycleEventId])
}

model ProjectActivity {
  id                     String                    @id @default(cuid())
  organisationId         String
  projectId              String
  sourceLifecycleEventId String?
  eventType              ProjectActivityEventType
  summary                String
  actorType              LifecycleActorType
  actorUserId            String?
  sourceType             String
  sourceId               String
  visibility             ProjectActivityVisibility @default(STANDARD)
  occurredAt             DateTime
  idempotencyKey         String
  createdAt              DateTime                  @default(now())

  organisation         Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project              Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceLifecycleEvent LifecycleEvent? @relation(fields: [sourceLifecycleEventId], references: [id], onDelete: Cascade)
  actorUser            User?           @relation("ProjectActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId, projectId, occurredAt])
  @@index([sourceLifecycleEventId])
  @@index([actorUserId])
}

model WorkflowTarget {
  id             String            @id @default(cuid())
  organisationId String
  key            WorkflowTargetKey
  enabled        Boolean           @default(true)
  offsetDays     Int               @default(3)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, key])
  @@index([organisationId, enabled])
}

model ProjectDocument {
  id                    String              @id @default(cuid())
  organisationId        String
  projectId             String
  uploadedById          String
  fileName              String
  originalName          String
  storageUrl            String
  storageKey            String?
  mimeType              String
  sizeBytes             Int
  type                  DocumentType        @default(OTHER)
  revision              String?
  status                DocumentStatus      @default(DRAFT)
  drawingNumber         String?
  drawingTitle          String?
  sortSource            DocumentSortSource?
  sortConfidence        Float?
  sortReason            String?
  fileHash              String?
  analysisVersion       String?
  analysisProvider      String?
  analysisModel         String?
  analysisPromptVersion String?
  analysisSchemaVersion String?
  analysisStatus        String?
  analysisResult        Json?
  analysedAt            DateTime?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organisation          Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project               Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy            User                        @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  packages              SubmissionPackageDocument[]
  sortBatchItems        DocumentSortBatchItem[]
  sourceGmailAttachment GmailAttachment?

  @@index([organisationId, projectId, createdAt])
  @@index([organisationId, createdAt])
  @@index([organisationId, projectId, type])
  @@index([organisationId, projectId, fileHash])
  @@index([organisationId, originalName])
  @@index([organisationId, sizeBytes])
  @@index([organisationId, type])
  @@index([uploadedById])
}

model DocumentSortBatch {
  id             String                  @id @default(cuid())
  organisationId String
  projectId      String
  status         DocumentSortBatchStatus @default(UPLOADED)
  fileCount      Int                     @default(0)
  createdById    String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation("DocumentSortBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items        DocumentSortBatchItem[]

  @@index([organisationId, projectId, createdAt])
  @@index([organisationId, status])
  @@index([createdById])
}

model DocumentSortBatchItem {
  id                         String             @id @default(cuid())
  batchId                    String
  documentId                 String?
  originalFilename           String
  suggestedDocumentType      DocumentType
  finalDocumentType          DocumentType?
  confidence                 Float
  reason                     String
  matchedRules               Json
  revision                   String?
  drawingNumber              String?
  drawingTitle               String?
  source                     DocumentSortSource
  isLikelyCurrent            Boolean            @default(true)
  suitableForPlanning        Boolean            @default(false)
  suitableForBuildingWarrant Boolean            @default(false)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  batch    DocumentSortBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  document ProjectDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([documentId])
}

model ApplicationDraft {
  id                       String                 @id @default(cuid())
  organisationId           String
  createdById              String
  status                   ApplicationDraftStatus @default(UPLOADING)
  notes                    String?
  suggestedApplicationType ApplicationDraftType?
  selectedApplicationType  ApplicationDraftType?
  preparedData             Json?
  confirmedData            Json?
  unresolvedQuestions      Json?
  analysisSummary          Json?
  expiresAt                DateTime
  committedAt              DateTime?
  resultingProjectId       String?
  resultingPlanningId      String?
  resultingWarrantId       String?
  resultingAutomationJobId String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  organisation Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User                       @relation("ApplicationDraftCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  documents    ApplicationDraftDocument[]

  @@index([organisationId, status, updatedAt])
  @@index([organisationId, createdById, createdAt])
  @@index([expiresAt, status])
  @@index([resultingProjectId])
}

model ApplicationDraftDocument {
  id                    String                               @id @default(cuid())
  draftId               String
  originalFilename      String
  fileName              String
  storageKey            String
  mimeType              String
  sizeBytes             Int
  sha256                String?
  clientSha256          String?
  uploadIntentKey       String
  uploadStatus          ApplicationDraftDocumentUploadStatus @default(UPLOADING)
  finalisedAt           DateTime?
  analysisStatus        ApplicationDraftDocumentStatus       @default(PENDING)
  analysisVersion       String?
  analysisProvider      String?
  analysisModel         String?
  analysisPromptVersion String?

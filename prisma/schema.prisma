generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganisationRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuthProviderType {
  GOOGLE
}

enum ProjectStage {
  LEAD
  SURVEY
  DESIGN
  PLANNING
  BUILDING_WARRANT
  CONSTRUCTION
  COMPLETION
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum DocumentType {
  LOCATION_PLAN
  SITE_PLAN
  BLOCK_PLAN
  EXISTING_DRAWING
  PROPOSED_DRAWING
  ELEVATION
  SECTION
  DETAILS
  CALCULATIONS
  SPECIFICATIONS
  DRAINAGE
  STRUCTURAL
  ENERGY
  CERTIFICATE
  PHOTO
  CORRESPONDENCE
  SUPPORTING_DOCUMENT
  OTHER
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
  REJECTED
}

enum DocumentSortBatchStatus {
  UPLOADED
  ANALYSING
  NEEDS_REVIEW
  ACCEPTED
  FAILED
}

enum DocumentSortSource {
  AI
  RULES
  PDF_TEXT
  MANUAL
}

enum PlanningStatus {
  NOT_STARTED
  DRAFTING
  SUBMITTED
  VALIDATED
  IN_REVIEW
  FURTHER_INFORMATION_REQUESTED
  APPROVED
  REFUSED
  WITHDRAWN
  CLOSED
}

enum WarrantType {
  INITIAL
  AMENDMENT
  STAGED
  LATE
  COMPLETION_CERTIFICATE
}

enum WarrantStatus {
  NOT_STARTED
  DRAFTING
  SUBMITTED
  IN_REVIEW
  FURTHER_INFORMATION_REQUESTED
  GRANTED
  REJECTED
  EXPIRED
  COMPLETED
  CLOSED
}

enum CompletionCertificateStatus {
  NOT_REQUIRED
  NOT_STARTED
  DRAFTING
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum DeadlineType {
  PLANNING_DECISION
  WARRANT_RESPONSE
  WARRANT_EXPIRY
  COMPLETION_CERTIFICATE
  CLIENT_ACTION
  INTERNAL_TASK
  INSPECTION
  CUSTOM
}

enum DeadlineStatus {
  UPCOMING
  DUE_SOON
  OVERDUE
  COMPLETED
  CANCELLED
}

enum DeadlinePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

enum CalendarConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
  PAUSED
}

enum GmailMatchStatus {
  UNMATCHED
  MATCHED
  AMBIGUOUS
  UNRELATED
}

enum GmailProcessingStatus {
  DISCOVERED
  PROCESSED
  NEEDS_REVIEW
  FAILED
}

enum GmailSuggestionStatus {
  PENDING
  APPLIED
  REJECTED
  FAILED
}

enum GmailUpdateType {
  PLANNING_APPLICATION
  BUILDING_WARRANT
  DEADLINE
  PROJECT_ACTIVITY
}

enum SubmissionPackageType {
  PLANNING
  BUILDING_WARRANT
}

enum SubmissionPackageStatus {
  DRAFT
  READY
  EXPORTED
  SUBMITTED
  ARCHIVED
}

enum AutomationJobType {
  HOUSEHOLDER_PLANNING
  PLANNING_APPLICATION
  BUILDING_WARRANT
}

enum AutomationJobStatus {
  DRAFT
  READY
  CLAIMED
  IN_PROGRESS
  NEEDS_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

enum AutomationJobSourceType {
  PROJECT
  PLANNING_RECORD
  WARRANT_RECORD
  DOCUMENT_BATCH
  MANUAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  authProviders        AuthProvider[]
  passwordResetTokens  PasswordResetToken[]
  organisationLinks   OrganisationMember[]
  uploadedDocuments   ProjectDocument[]    @relation("DocumentUploadedBy")
  documentSortBatches DocumentSortBatch[]  @relation("DocumentSortBatchCreatedBy")
  createdPackages       SubmissionPackage[] @relation("PackageCreatedBy")
  createdAutomationJobs AutomationJob[]     @relation("AutomationJobCreatedBy")
  claimedAutomationJobs AutomationJob[]     @relation("AutomationJobClaimedBy")
  desktopAccessTokens   DesktopAccessToken[]
  reviewedGmailSuggestions GmailUpdateSuggestion[] @relation("GmailSuggestionReviewedBy")

  @@index([email])
  @@index([createdAt])
}

model AuthProvider {
  id                String           @id @default(cuid())
  userId            String
  provider          AuthProviderType
  providerAccountId String
  email             String?
  displayName       String?
  avatarUrl         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PendingOAuthSignup {
  id                String           @id @default(cuid())
  tokenHash         String           @unique
  provider          AuthProviderType
  providerAccountId String
  email             String
  displayName       String
  avatarUrl         String?
  expiresAt         DateTime
  createdAt         DateTime         @default(now())

  @@unique([provider, providerAccountId])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              OrganisationMember[]
  clients              Client[]
  sites                Site[]
  projects             Project[]
  documents            ProjectDocument[]
  planningApplications PlanningApplication[]
  warrantApplications  BuildingWarrantApplication[]
  deadlines            Deadline[]
  calendarConnections  CalendarConnection[]
  syncedCalendarEvents SyncedCalendarEvent[]
  submissionPackages   SubmissionPackage[]
  documentSortBatches  DocumentSortBatch[]
  automationJobs       AutomationJob[]
  desktopAccessTokens  DesktopAccessToken[]
  trackedEmails        TrackedEmail[]
  gmailSuggestions     GmailUpdateSuggestion[]
  gmailAttachments     GmailAttachment[]

  @@index([slug])
  @@index([updatedAt])
}

model OrganisationMember {
  id             String           @id @default(cuid())
  organisationId String
  userId         String
  role           OrganisationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([organisationId, role])
}

model Client {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  email          String?
  phone          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organisationId, name])
  @@index([organisationId, updatedAt])
}

model Site {
  id             String   @id @default(cuid())
  organisationId String
  addressLine1   String
  addressLine2   String?
  townCity       String
  postcode       String
  localAuthority String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organisationId, postcode])
  @@index([organisationId, updatedAt])
}

model Project {
  id                String        @id @default(cuid())
  organisationId    String
  clientId          String?
  siteId            String?
  name              String
  internalReference String?
  projectType       String?
  stage             ProjectStage  @default(LEAD)
  localAuthority    String?
  siteAddress       String?
  status            ProjectStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organisation         Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client               Client?                      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  site                 Site?                        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  documents            ProjectDocument[]
  planningApplications PlanningApplication[]
  warrantApplications  BuildingWarrantApplication[]
  deadlines            Deadline[]
  submissionPackages   SubmissionPackage[]
  documentSortBatches  DocumentSortBatch[]
  automationJobs       AutomationJob[]
  trackedEmails        TrackedEmail[]
  gmailSuggestions     GmailUpdateSuggestion[]

  @@index([organisationId, status, updatedAt])
  @@index([organisationId, updatedAt])
  @@index([organisationId, stage])
  @@index([organisationId, clientId])
  @@index([organisationId, siteId])
}

model ProjectDocument {
  id             String              @id @default(cuid())
  organisationId String
  projectId      String
  uploadedById   String
  fileName       String
  originalName   String
  storageUrl     String
  storageKey     String?
  mimeType       String
  sizeBytes      Int
  type           DocumentType        @default(OTHER)
  revision       String?
  status         DocumentStatus      @default(DRAFT)
  drawingNumber  String?
  drawingTitle   String?
  sortSource     DocumentSortSource?
  sortConfidence Float?
  sortReason     String?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation   Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy     User                        @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  packages       SubmissionPackageDocument[]
  sortBatchItems DocumentSortBatchItem[]
  sourceGmailAttachment GmailAttachment?

  @@index([organisationId, projectId, createdAt])
  @@index([organisationId, createdAt])
  @@index([organisationId, projectId, type])
  @@index([organisationId, originalName])
  @@index([organisationId, sizeBytes])
  @@index([organisationId, type])
  @@index([uploadedById])
}

model DocumentSortBatch {
  id             String                  @id @default(cuid())
  organisationId String
  projectId      String
  status         DocumentSortBatchStatus @default(UPLOADED)
  fileCount      Int                     @default(0)
  createdById    String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation("DocumentSortBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items        DocumentSortBatchItem[]

  @@index([organisationId, projectId, createdAt])
  @@index([organisationId, status])
  @@index([createdById])
}

model DocumentSortBatchItem {
  id                         String             @id @default(cuid())
  batchId                    String
  documentId                 String?
  originalFilename           String
  suggestedDocumentType      DocumentType
  finalDocumentType          DocumentType?
  confidence                 Float
  reason                     String
  matchedRules               Json
  revision                   String?
  drawingNumber              String?
  drawingTitle               String?
  source                     DocumentSortSource
  isLikelyCurrent            Boolean            @default(true)
  suitableForPlanning        Boolean            @default(false)
  suitableForBuildingWarrant Boolean            @default(false)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  batch    DocumentSortBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  document ProjectDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([documentId])
}

model AutomationJob {
  id               String                  @id @default(cuid())
  organisationId   String
  projectId        String
  type             AutomationJobType
  status           AutomationJobStatus     @default(DRAFT)
  sourceType       AutomationJobSourceType @default(PROJECT)
  title            String
  dataSnapshot     Json
  documentSnapshot Json
  resultSummary    String?
  error            String?
  payloadVersion   Int                     @default(1)
  createdById      String
  claimedByUserId  String?
  claimedDeviceId  String?
  handoffCodeHash  String?                @unique
  handoffExpiresAt DateTime?
  handoffRedeemedAt DateTime?
  claimedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organisation  Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User         @relation("AutomationJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  claimedBy     User?        @relation("AutomationJobClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  desktopAccessTokens DesktopAccessToken[] @relation("DesktopTokenAutomationJob")

  @@index([organisationId, projectId, status, type, createdAt])
  @@index([organisationId, status, createdAt])
  @@index([createdById])
  @@index([claimedByUserId])
  @@index([handoffExpiresAt])
}

model DesktopAccessToken {
  id             String    @id @default(cuid())
  organisationId String
  userId         String
  automationJobId String?
  name           String
  tokenHash      String    @unique
  tokenPrefix    String
  expiresAt      DateTime
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationJob AutomationJob? @relation("DesktopTokenAutomationJob", fields: [automationJobId], references: [id], onDelete: Cascade)

  @@index([organisationId, userId, revokedAt])
  @@index([expiresAt])
  @@index([automationJobId, revokedAt])
}
model PlanningApplication {
  id                   String         @id @default(cuid())
  organisationId       String
  projectId            String
  applicationReference String?
  submissionDate       DateTime?
  validDate            DateTime?
  decisionTargetDate   DateTime?
  decisionDate         DateTime?
  status               PlanningStatus @default(NOT_STARTED)
  portalUrl            String?
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deadlines    Deadline[]
  trackedEmails TrackedEmail[]
  gmailSuggestions GmailUpdateSuggestion[]

  @@index([organisationId, status, decisionTargetDate])
  @@index([organisationId, updatedAt])
  @@index([organisationId, projectId])
}

model BuildingWarrantApplication {
  id                          String                      @id @default(cuid())
  organisationId              String
  projectId                   String
  warrantReference            String?
  warrantType                 WarrantType                 @default(INITIAL)
  submissionDate              DateTime?
  firstResponseTargetDate     DateTime?
  grantedDate                 DateTime?
  expiryDate                  DateTime?
  completionCertificateStatus CompletionCertificateStatus @default(NOT_REQUIRED)
  status                      WarrantStatus               @default(NOT_STARTED)
  portalUrl                   String?
  notes                       String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deadlines    Deadline[]
  trackedEmails TrackedEmail[]
  gmailSuggestions GmailUpdateSuggestion[]

  @@index([organisationId, status, firstResponseTargetDate])
  @@index([organisationId, updatedAt])
  @@index([organisationId, expiryDate])
  @@index([organisationId, projectId])
}

model Deadline {
  id                           String           @id @default(cuid())
  organisationId               String
  projectId                    String?
  planningApplicationId        String?
  buildingWarrantApplicationId String?
  title                        String
  description                  String?
  dueDate                      DateTime
  type                         DeadlineType
  status                       DeadlineStatus   @default(UPCOMING)
  priority                     DeadlinePriority @default(MEDIUM)
  reminderDate                 DateTime?
  completedDate                DateTime?
  sourceKey                    String?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  organisation               Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project?                    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  planningApplication        PlanningApplication?        @relation(fields: [planningApplicationId], references: [id], onDelete: SetNull)
  buildingWarrantApplication BuildingWarrantApplication? @relation(fields: [buildingWarrantApplicationId], references: [id], onDelete: SetNull)
  calendarEvents             SyncedCalendarEvent[]

  @@index([organisationId, status, dueDate])
  @@index([organisationId, projectId])
  @@index([planningApplicationId])
  @@index([buildingWarrantApplicationId])
  @@unique([organisationId, sourceKey])
}

model CalendarConnection {
  id                    String                   @id @default(cuid())
  organisationId        String
  provider              CalendarProvider
  status                CalendarConnectionStatus @default(NOT_CONNECTED)
  accountEmail          String?
  externalId            String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  accessTokenExpiresAt  DateTime?
  grantedScopes         String?
  lastSyncedAt          DateTime?
  syncError             String?
  gmailEnabled          Boolean                  @default(false)
  gmailRequireReview    Boolean                  @default(true)
  gmailAutoApplyHighConfidence Boolean           @default(false)
  gmailHistoryId        String?
  gmailLastSuccessfulSyncAt DateTime?
  gmailLastAttemptedSyncAt DateTime?
  gmailSyncStartedAt    DateTime?
  gmailSyncError        String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  events       SyncedCalendarEvent[]

  @@unique([organisationId, provider])
  @@index([organisationId, status])
}

model TrackedEmail {
  id                           String                @id @default(cuid())
  organisationId               String
  gmailMessageId               String
  gmailThreadId                String
  sender                       String
  recipients                   Json
  subject                      String
  sentAt                       DateTime
  textExcerpt                  String?
  matchStatus                  GmailMatchStatus      @default(UNMATCHED)
  processingStatus             GmailProcessingStatus @default(DISCOVERED)
  projectId                    String?
  planningApplicationId        String?
  buildingWarrantApplicationId String?
  matchConfidence              Float?
  matchReason                  String?
  processingError              String?
  processedAt                  DateTime?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt

  organisation               Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project?                    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  planningApplication        PlanningApplication?        @relation(fields: [planningApplicationId], references: [id], onDelete: SetNull)
  buildingWarrantApplication BuildingWarrantApplication? @relation(fields: [buildingWarrantApplicationId], references: [id], onDelete: SetNull)
  suggestions                GmailUpdateSuggestion[]
  attachments                GmailAttachment[]

  @@unique([organisationId, gmailMessageId])
  @@index([organisationId, gmailThreadId])
  @@index([organisationId, matchStatus, sentAt])
  @@index([organisationId, processingStatus, sentAt])
  @@index([organisationId, projectId, sentAt])
  @@index([planningApplicationId])
  @@index([buildingWarrantApplicationId])
}

model GmailUpdateSuggestion {
  id                           String                @id @default(cuid())
  organisationId               String
  trackedEmailId               String
  projectId                    String?
  planningApplicationId        String?
  buildingWarrantApplicationId String?
  updateType                   GmailUpdateType
  fieldName                    String
  dedupeKey                    String
  existingValue                Json?
  suggestedValue               Json
  confidence                   Float
  reason                       String
  status                       GmailSuggestionStatus @default(PENDING)
  appliedAutomatically         Boolean               @default(false)
  reviewedById                 String?
  reviewedAt                   DateTime?
  appliedAt                    DateTime?
  error                        String?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  organisation               Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trackedEmail               TrackedEmail                @relation(fields: [trackedEmailId], references: [id], onDelete: Cascade)
  project                    Project?                    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  planningApplication        PlanningApplication?        @relation(fields: [planningApplicationId], references: [id], onDelete: SetNull)
  buildingWarrantApplication BuildingWarrantApplication? @relation(fields: [buildingWarrantApplicationId], references: [id], onDelete: SetNull)
  reviewedBy                 User?                       @relation("GmailSuggestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([trackedEmailId, dedupeKey])
  @@index([organisationId, status, createdAt])
  @@index([organisationId, projectId, createdAt])
  @@index([planningApplicationId])
  @@index([buildingWarrantApplicationId])
  @@index([reviewedById])
}

model GmailAttachment {
  id                 String   @id @default(cuid())
  organisationId     String
  trackedEmailId     String
  gmailAttachmentId  String
  fileName           String
  mimeType           String
  sizeBytes          Int
  sha256             String?
  importedDocumentId String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation     Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trackedEmail     TrackedEmail    @relation(fields: [trackedEmailId], references: [id], onDelete: Cascade)
  importedDocument ProjectDocument? @relation(fields: [importedDocumentId], references: [id], onDelete: SetNull)

  @@unique([trackedEmailId, gmailAttachmentId])
  @@index([organisationId, createdAt])
  @@index([organisationId, sha256])
}

model SyncedCalendarEvent {
  id                   String           @id @default(cuid())
  organisationId       String
  calendarConnectionId String?
  deadlineId           String?
  provider             CalendarProvider
  providerEventId      String?
  title                String
  startsAt             DateTime
  endsAt               DateTime?
  syncStatus           String           @default("PENDING")
  lastSyncedAt         DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  calendarConnection CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: SetNull)
  deadline           Deadline?           @relation(fields: [deadlineId], references: [id], onDelete: SetNull)

  @@index([organisationId, provider, syncStatus])
  @@index([deadlineId])
}

model SubmissionPackage {
  id             String                  @id @default(cuid())
  organisationId String
  projectId      String
  createdById    String
  name           String
  type           SubmissionPackageType
  status         SubmissionPackageStatus @default(DRAFT)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organisation Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User                        @relation("PackageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  documents    SubmissionPackageDocument[]

  @@index([organisationId, projectId])
  @@index([organisationId, status])
}

model SubmissionPackageDocument {
  id                  String   @id @default(cuid())
  submissionPackageId String
  documentId          String
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  submissionPackage SubmissionPackage @relation(fields: [submissionPackageId], references: [id], onDelete: Cascade)
  document          ProjectDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([submissionPackageId, documentId])
  @@index([documentId])
}


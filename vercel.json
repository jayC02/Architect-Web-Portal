{
  "framework": "astro",
  "buildCommand": "npm run build",
  "regions": ["lhr1"],
  "crons": [
    {
      "path": "/api/cron/gmail-sync",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

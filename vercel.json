{
  "framework": "astro",
  "buildCommand": "npm run build",
  "regions": [
    "lhr1"
  ],
  "crons": [
    {
      "path": "/api/cron/gmail-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/xero-sync",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/workflow-effects",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/application-draft-cleanup",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/usage-report",
      "schedule": "45 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/downloads/:path*",
      "destination": "/agent/download",
      "permanent": false
    }
  ]
}
